From 73edf5dfe4fffcaa1c65fd053836bf1ea169c32d Mon Sep 17 00:00:00 2001
From: dsh-wake <wake@local>
Date: Wed, 18 Nov 2026 01:41:30 +0800
Subject: [PATCH] fix(voice): the wake gate no longer opens on silence, and
 noise is not a wake word
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

The gate learned its 噪声地板 from the first frame. A recorder that has not
started producing audio reads -100 dB, so the floor landed in the basement and
every frame after it was 'hot': the recognizer heard a continuous room, never
endpointed, and decoded it into one syllable repeated (呵呵呵呵呵). A real wake
word inside that never matched.

- the floor starts at a quiet room (-50 dB) and only real audio moves it;
  digital silence at or under -90 dB is ignored, because it is not a room.
- a text that is one character repeated five times or more is the model stuck
  on noise, and it never endpoints by itself: the stream is reset there.
- each pcm line in the debug log now carries the level and floor it was judged
  against, so the next log says which side of the gate a frame fell on.
---
 .../ccch1mneyyy/dsh_app/wake/WakeCapture.kt   | 18 ++++++++---
 .../dsh_app/wake/WakeWordPlugin.kt            | 10 +++---
 .../dsh_app/wake/WakeWordService.kt           |  2 +-
 app/lib/voice/wake_word.dart                  | 32 +++++++++++++++++--
 4 files changed, 49 insertions(+), 13 deletions(-)

diff --git a/app/android/app/src/main/kotlin/io/github/ccch1mneyyy/dsh_app/wake/WakeCapture.kt b/app/android/app/src/main/kotlin/io/github/ccch1mneyyy/dsh_app/wake/WakeCapture.kt
index 103c081..2e5ad22 100644
--- a/app/android/app/src/main/kotlin/io/github/ccch1mneyyy/dsh_app/wake/WakeCapture.kt
+++ b/app/android/app/src/main/kotlin/io/github/ccch1mneyyy/dsh_app/wake/WakeCapture.kt
@@ -19,7 +19,8 @@ import io.github.ccch1mneyyy.dsh_app.nativemedia.SpeechGate
  * microphone is free for a call right after.
  */
 class WakeCapture(
-    private val onFrame: (ShortArray) -> Unit,
+    /** One frame of speech, and the level and floor it was judged against. */
+    private val onFrame: (ShortArray, Double, Double) -> Unit,
     /** The burst of speech ended: the Dart side resets its recognizer stream. */
     private val onSpeechEnd: () -> Unit,
     private val onError: (String) -> Unit,
@@ -64,7 +65,7 @@ class WakeCapture(
     private fun capture(r: AudioRecord, mine: Int) {
         val frame = ShortArray(FRAME)
         var filled = 0
-        var floor = Double.NaN
+        var floor = INITIAL_FLOOR_DB
         var loud = 0
         var speaking = false
         var lastLoud = 0L
@@ -82,8 +83,11 @@ class WakeCapture(
                 val now = SystemClock.elapsedRealtime()
                 val level = SpeechGate.levelOf(frame, frame.size)
                 // 噪声地板 follows a quiet room down at once and up slowly, so a fan or a road
-                // does not keep the gate open and a person still opens it.
-                floor = if (floor.isNaN()) level.toDouble() else minOf(level.toDouble(), floor + FLOOR_RISE_DB)
+                // does not keep the gate open and a person still opens it. A frame that is
+                // digital silence (the recorder has not produced audio yet) reads -100 dB and
+                // would drag the floor into the basement; it carries no room, so it is not
+                // allowed to move the floor at all.
+                floor = if (level <= SILENCE_DB) floor else minOf(level.toDouble(), floor + FLOOR_RISE_DB)
                 val hot = level > floor + MARGIN_DB
                 loud = if (hot) loud + 1 else 0
                 if (hot) lastLoud = now
@@ -97,7 +101,7 @@ class WakeCapture(
                     continue
                 }
                 val copy = frame.copyOf()
-                report(mine) { onFrame(copy) }
+                report(mine) { onFrame(copy, level, floor) }
             }
         } catch (_: RuntimeException) {
             report(mine) { onError("capture") }
@@ -137,5 +141,9 @@ class WakeCapture(
         const val LOUD_FRAMES = 3
         /** Quiet that closes the burst; the trailing word is still inside it. */
         const val HANGOVER_MS = 700L
+        /** A quiet room, before the first frames have said how quiet this one actually is. */
+        const val INITIAL_FLOOR_DB = -50.0
+        /** At or under this a frame is digital silence, not a room, and never moves the floor. */
+        const val SILENCE_DB = -90.0
     }
 }
diff --git a/app/android/app/src/main/kotlin/io/github/ccch1mneyyy/dsh_app/wake/WakeWordPlugin.kt b/app/android/app/src/main/kotlin/io/github/ccch1mneyyy/dsh_app/wake/WakeWordPlugin.kt
index 5b33b5d..830376c 100644
--- a/app/android/app/src/main/kotlin/io/github/ccch1mneyyy/dsh_app/wake/WakeWordPlugin.kt
+++ b/app/android/app/src/main/kotlin/io/github/ccch1mneyyy/dsh_app/wake/WakeWordPlugin.kt
@@ -19,14 +19,14 @@ import io.github.ccch1mneyyy.dsh_app.MainActivity
  */
 internal object WakeBus {
     /** Set while Dart listens; frames are dropped when nobody is. */
-    @Volatile var frameSink: ((ByteArray) -> Unit)? = null
+    @Volatile var frameSink: ((ByteArray, Double, Double) -> Unit)? = null
 
     @Volatile var eventSink: ((Map<String, Any?>) -> Unit)? = null
 
     /** The activity applies this on its next resume (熄屏喊醒: the screen comes on). */
     @Volatile var turnScreenOn = false
 
-    fun frame(frame: ShortArray) {
+    fun frame(frame: ShortArray, level: Double, floor: Double) {
         val sink = frameSink ?: return
         val bytes = ByteArray(frame.size * 2)
         for (i in frame.indices) {
@@ -34,7 +34,7 @@ internal object WakeBus {
             bytes[i * 2] = sample.toByte()
             bytes[i * 2 + 1] = (sample shr 8).toByte()
         }
-        sink(bytes)
+        sink(bytes, level, floor)
     }
 
     fun emit(event: Map<String, Any?>) {
@@ -111,7 +111,9 @@ class WakeWordPlugin : FlutterPlugin, MethodChannel.MethodCallHandler, EventChan
     override fun onListen(arguments: Any?, sink: EventChannel.EventSink?) {
         events = sink
         WakeBus.eventSink = { event -> main.post { events?.success(event) } }
-        WakeBus.frameSink = { bytes -> main.post { events?.success(mapOf("kind" to "wake.pcm", "bytes" to bytes)) } }
+        WakeBus.frameSink = { bytes, level, floor ->
+            main.post { events?.success(mapOf("kind" to "wake.pcm", "bytes" to bytes, "level" to level, "floor" to floor)) }
+        }
         // What the service is already doing, so a page opened while listening is not wrong.
         WakeBus.emit(mapOf("kind" to if (WakeWordService.running) "wake.listening" else "wake.stopped"))
     }
diff --git a/app/android/app/src/main/kotlin/io/github/ccch1mneyyy/dsh_app/wake/WakeWordService.kt b/app/android/app/src/main/kotlin/io/github/ccch1mneyyy/dsh_app/wake/WakeWordService.kt
index 9c0f5a8..fa77de9 100644
--- a/app/android/app/src/main/kotlin/io/github/ccch1mneyyy/dsh_app/wake/WakeWordService.kt
+++ b/app/android/app/src/main/kotlin/io/github/ccch1mneyyy/dsh_app/wake/WakeWordService.kt
@@ -95,7 +95,7 @@ class WakeWordService : Service() {
         holding = true
         acquireWakeLock()
         val c = capture ?: WakeCapture(
-            onFrame = { frame -> WakeBus.frame(frame) },
+            onFrame = { frame, level, floor -> WakeBus.frame(frame, level, floor) },
             onSpeechEnd = { WakeBus.emit(mapOf("kind" to "wake.speechEnd")) },
             onError = { reason ->
                 WakeBus.emit(mapOf("kind" to "wake.error", "reason" to reason))
diff --git a/app/lib/voice/wake_word.dart b/app/lib/voice/wake_word.dart
index bbcb5fa..cf6e008 100644
--- a/app/lib/voice/wake_word.dart
+++ b/app/lib/voice/wake_word.dart
@@ -249,7 +249,14 @@ class WakeWordController extends Notifier<WakeStatus> {
         final bytes = event['bytes'];
         if (bytes is Uint8List) {
           _pcmCount++;
-          if (_pcmCount % 50 == 1) _dbg('pcm #$_pcmCount bytes=${bytes.length}');
+          if (_pcmCount % 50 == 1) {
+            final level = event['level'];
+            final floor = event['floor'];
+            _dbg(
+              'pcm #$_pcmCount bytes=${bytes.length}'
+              '${level is num && floor is num ? ' level=${level.toStringAsFixed(1)} floor=${floor.toStringAsFixed(1)}' : ''}',
+            );
+          }
           _feed(bytes);
         } else {
           _dbg('pcm bytes type=${bytes.runtimeType}');
@@ -311,7 +318,9 @@ class WakeWordController extends Notifier<WakeStatus> {
     if (_heardWakeWord(_text)) {
       _dbg('MATCH: $_text');
       unawaited(_fire());
-    } else if (recognizer.isEndpoint(stream)) {
+    } else if (recognizer.isEndpoint(stream) || _isBabble(_compact(_text))) {
+      // 一个音节重复到底 is the model stuck on noise: it never endpoints on its own, so the
+      // stream has to be dropped here or every later word is decoded into the same loop.
       _resetStream();
     }
   }
@@ -320,7 +329,24 @@ class WakeWordController extends Notifier<WakeStatus> {
   bool _heardWakeWord(String text) {
     final keyword = _compact(_keyword);
     if (keyword.isEmpty) return false;
-    return _compact(text).contains(keyword);
+    final heard = _compact(text);
+    // A stream fed a room decodes it into one syllable repeated ("呵呵呵呵呵"). That is not
+    // speech, and matching inside it is how a wake word fires on nothing.
+    if (_isBabble(heard)) return false;
+    return heard.contains(keyword);
+  }
+
+  /// One character repeated five times or more: a recognizer's answer to noise, not a word.
+  static bool _isBabble(String text) {
+    var run = 1;
+    for (var i = 1; i < text.length; i++) {
+      if (text[i] != text[i - 1]) {
+        run = 1;
+      } else if (++run >= 5) {
+        return true;
+      }
+    }
+    return false;
   }
 
   static final _noise = RegExp(r'[^0-9A-Za-z\u4e00-\u9fff]+');
-- 
