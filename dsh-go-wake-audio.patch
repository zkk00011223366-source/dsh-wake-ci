+    }
+
+    fun markOnVirtual(owner: String?) {
+        if (!owner.isNullOrBlank()) onMain.remove(owner)
+    }
+
+    fun isOnMain(owner: String?): Boolean = owner != null && onMain.contains(owner)
+}
