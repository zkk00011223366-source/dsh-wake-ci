+            val control = try {
+                BackgroundControl.get(app)
+            } catch (_: Throwable) {
+                null
+            }
+            // The window is usually opened in the same breath as the task: give the engine a
+            // moment to publish the target before falling back to preview frames.
+            // 虚拟屏只有一块：按 id 找不到就退回"当前活着的那块"。
+            // 之前只按 id 找，迁移后（id=0）或预览注册没发生时永远拿不到目标 →
+            // 画面退回 6fps 抓帧，看视频就像 PPT。
+            var target = if (id > 0) control?.previewTarget(id) else null
+            target = target ?: control?.anyPreviewTarget()
+            var wait = 0
+            while (target == null && control != null && gen == surfaceGen && wait < 12) {
+                Thread.sleep(150)
+                wait++
+                target = control.previewTarget(id) ?: control.anyPreviewTarget()
+            }
+            WakeTrace.log("window: surface target=${target?.taskId} id=$id")
+            if (control == null || target == null) {
+                if (surface != null) {
+                    liveSurface = false
+                    main.post { applyLive() }
+                    // 窗口常常在"虚拟屏还没建、应用还没起来"时就打开：这里定时重试，
+                    // 否则 attach 只尝试 1.8 秒，错过之后就永远只有抓帧/黑屏（16:20 日志）。
+                    scheduleSurfaceRetry(app, gen)
+                }
+                return@execute
+            }
+            var reply = try {
+                control.attachViewSurface(target, surface)
+            } catch (_: Throwable) {
+                mapOf("ok" to false, "reason" to "surfaceUnavailable")
+            }
+            // scopeBusy：owner scope 被预览轮询占着，attach 会被拒（真机窗口空/黑的直接原因）。
+            // 这不是失败，是"稍后再来"——重试三次，每次都留痕。
+            var retries = 0
+            while (reply["ok"] != true && reply["reason"] == "scopeBusy" && retries < 3 &&
+                gen == surfaceGen
+            ) {
+                Thread.sleep(200)
+                retries++
+                reply = try {
+                    control.attachViewSurface(target, surface)
+                } catch (_: Throwable) {
+                    reply
+                }
+                WakeTrace.log(
+                    "window: attach retry #$retries after scopeBusy ok=${reply["ok"]} " +
+                        "attached=${reply["attached"]} reason=${reply["reason"]}")
+            }
+            val attached = reply["ok"] == true && reply["attached"] == true
+            WakeTrace.log("window: attach ok=$attached reply=$reply")
+            // 判据日志：重开时"重新接上没有"必须能一眼看到（ok=true 才算真的有画面）。
+            WakeTrace.log("window: reattach ok=$attached gen=$gen display=${reply["displayId"]}")
+            if (gen != surfaceGen) {
+                // The window changed its mind while this was on the wire: undo the attach.
+                if (attached) runCatching { control.attachViewSurface(target, null) }
+                return@execute
+            }
+            displayWidth = (reply["width"] as? Int) ?: displayWidth
+            displayHeight = (reply["height"] as? Int) ?: displayHeight
+            displayId = (reply["displayId"] as? Int) ?: displayId
+            if (displayWidth > 0) displayW = displayWidth
+            if (displayHeight > 0) displayH = displayHeight
+            // 尺寸拿到的一刻立刻重算适配（09:3x：之前只有 applyShape 时算，那时还不知道尺寸）。
+            if (displayW > 0 && displayH > 0) {
+                main.post {
+                    // 关键：窗口尺寸也要按虚拟屏比例重算（之前一直是手机比例）。
+                    reshapeWithDisplayAspect()
+                    applyFitTransform()
+                }
+            }
+            liveSurface = attached
+            if (attached) {
+                previewTaskId = target.taskId
+                surfaceRetries = 0
+                // 直连接上不等于画好了：给应用 1.2 秒把第一帧画进 surface，
+                // 这期间窗口保留占位文字，别变成一块全透明。
+                paintedAt = SystemClock.elapsedRealtime() + 1200
+                // 画面比例（用户 13:4x 截图）：surface 之前是"窗口多大就多大"（385x860），
+                // 虚拟屏却按 720x1600 往里画，系统只能 1:1 从左上角裁一块 —— 小窗被裁、
+                // 全屏左边一条、右边全黑。把 surface 固定成虚拟屏的真实尺寸，让系统缩放
+                // 到窗口里，窗口本身的宽高比已经按这块屏算过，缩下来正好铺满。
+                fixSurfaceSize()
+                // 表面接上 ≠ 应用画好了：立刻显示会看到黑屏（20:19 日志）。
+                // 判据：先 attach ok + live=true，再等应用把第一帧画进这块面（paintedAt = +1.2s），
+                // 最后才 reveal。以前固定 400ms，比这里自己留的 1.2 秒还短，用户看到的正是那段黑。
+                val box = root
+                val wait = (paintedAt - SystemClock.elapsedRealtime()).coerceIn(120L, 1_600L)
+                main.postDelayed({
+                    // 眼睛/切换连着按时窗口会换：只给"还是这个窗口"的那次 reveal。
+                    if (box != null && root === box && liveSurface) {
+                        // C2：抓到帧先判黑（12×24 取样、99.5% 阈值），黑帧不揭窗——
+                        // 以前只"等 1.2 秒猜"，用户先看到一块黑的。没有新帧时按"不是黑"算。
+                        if (frameIsBlack()) {
