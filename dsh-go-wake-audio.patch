+    /** 手机屏幕的比例（竖屏 高/宽）；横屏手机自然给出 宽/高。 */
+    private fun screenAspect(): Float = try {
+        val dm = context?.resources?.displayMetrics
+        if (dm == null || dm.widthPixels <= 0) 196f / 110f
+        else maxOf(dm.heightPixels, dm.widthPixels).toFloat() / minOf(dm.heightPixels, dm.widthPixels)
+    } catch (_: Throwable) {
+        196f / 110f
+    }
