new file mode 100644
index 0000000..4f13796
--- /dev/null
+++ b/app/lib/speech/wake_reply.dart
@@ -0,0 +1,175 @@
+// 唤醒回应「我在」：预合成缓存 + 本地播放（用户 16:53）。
+//
+// 需求：喊完**立刻**有声音，而且这句话用户可以在设置里自定义。
+// 云端 TTS 每次现合成要 1–2 秒，"立刻"做不到；所以：
+//   1. 文本保存时 / App 启动时，用同一条海星通道预合成一次，PCM 存进本地缓存
+//   2. 唤醒时直接读缓存写进音频通道 —— 延迟只有文件读取
+//   3. 缓存没有（第一次、离线、刚改完）才现场合成，失败静默（不影响通话）
+//
+// 换文本 → 文件名跟着哈希变 → 不会播到旧句子。
+
+import 'dart:async';
+import 'dart:io';
+import 'dart:typed_data';
+
+import 'package:flutter_riverpod/flutter_riverpod.dart';
+import 'package:path_provider/path_provider.dart';
+
+import '../companion/companion_voice_source.dart';
+import 'speech_settings.dart';
+import '../voice/wake_settings.dart';
+import '../voice/wake_word.dart' show diagWake;
+import 'deepseek_speech.dart';
+import '../companion/companion_voice.dart';
+import 'speech_audio.dart';
+import 'call/voice_call.dart';
+import 'speech_out.dart';
+
+/// FNV-1a：文本 → 稳定的短哈希（同一条文本每次启动都一样，才能复用缓存）。
+int _fnv(String text) {
+  var h = 0x811c9dc5;
+  for (final unit in text.codeUnits) {
+    h ^= unit;
+    h = (h * 0x01000193) & 0xffffffff;
+  }
+  return h;
+}
+
+/// 通话是否在进行中（由通话页注入；没有通话能力时永远是 false）。
+bool Function()? wakeCallActive;
+
+class WakeReplyVoice {
+  WakeReplyVoice(this._audio, this._speech, this._speaker, this._settings)
+      : _voice = _settings?.deepseekVoice ?? 'stella';
+
+  final SpeechAudio _audio;
+  final DeepSeekSpeechResolver _speech;
+  final CompanionSpeaker _speaker;
+  final CompanionVoiceSettings? _settings;
+  final String _voice;
+
+  /// 是否跟随"海星（DeepSeek）"来源：只有它才预合成、走缓存；
+  /// 系统音色直接交给系统 TTS，不用登录、不用网络（00:52 讨论）。
+  bool get _deepseek => _settings?.source == CompanionVoiceSource.deepseek;
+
+  Future<File> _clip(String text) async {
+    final base = await getApplicationSupportDirectory();
+    final dir = Directory('${base.path}/wake_reply');
+    if (!await dir.exists()) await dir.create(recursive: true);
+    // 缓存键必须带音色：否则换了音色还在播旧的（00:14 反馈"两个声音"）。
+    return File('${dir.path}/${_fnv('$text|$_voice')}.pcm');
+  }
+
+  /// 缓存里有就直接播（近乎零延迟）；没有就现合成并顺手存下来。
+  Future<bool> speak(String text) async {
+    final started = DateTime.now();
+    Future<void> done(bool ok) async {
+      // ignore: avoid_print
+      diagWake('wake-reply: spoken ok=$ok in ${DateTime.now().difference(started).inMilliseconds}ms');
+    }
+    final trimmed = text.trim();
+    if (trimmed.isEmpty) return false;
+    final id = 'wake-reply-${DateTime.now().microsecondsSinceEpoch}';
+    // 对照日志：唤醒实际用的来源与音色，和通话那行比对（09:0x 仍在排查两个声音）。
+    diagWake('wake: voice source=${_settings?.source?.name} name=$_voice deepseek=$_deepseek');
+    if (!_deepseek) {
+      // 系统音色：直接用统一出口说，不缓存。
+      try {
+        final out = speechOutFor(
+          _settings ?? const CompanionVoiceSettings(follow: true),
+          deepseek: _speech,
+          audio: _audio,
+          speaker: _speaker,
+          // 和通话 TTS 同一条通道（媒体）：通话通道带 AGC/EQ，同一个音色听起来像两个人
+          // （第⑤项，12:3x）。通话侧已经是 call:false，这里跟着改。
+          call: false,
+        );
+        out.add(trimmed);
+        out.finish();
+        return true;
+      } on Object {
+        return false;
+      }
+    }
+    try {
+      final file = await _clip(trimmed);
+      if (await file.exists()) {
+        final bytes = await file.readAsBytes();
+        // call:false：不排在通话音频通道后面（那里要等语音预热，6 秒就是这么来的）。
+        // 通话音色对比（10:4x）：通话中唤醒也用通话通道，避免"媒体通道 vs 通话通道"
+        // 造成的音色差异（AGC/路由不同听起来像两个人）。
+        // 通话通道在"没有真正通话"时会被路由到听筒/静音 → 唤醒回应没声音（12:0x）。
+        // 一律用媒体通道，保证出声。
+        const inCall = false;
+        diagWake('wake: play rate=24000 call=$inCall bytes=${bytes.length}');
+        if (bytes.isNotEmpty && await _audio.open(id, call: inCall)) {
+          await _audio.write(id, bytes);
+          await _audio.end(id);
+          unawaited(done(true));
+          return true;
+        }
+      }
+      final ok = await _synthesizeAndPlay(trimmed, id, file);
+      unawaited(done(ok));
+      return ok;
+    } on Object {
+      return false;
+    }
+  }
+
+  /// 预合成：设置保存后、App 启动时调用；失败静默（下次唤醒再试）。
+  Future<void> prefetch(String text) async {
+    final trimmed = text.trim();
+    if (trimmed.isEmpty) return;
+    try {
+      final file = await _clip(trimmed);
+      if (await file.exists()) return;
+      final speech = await _speech();
+      if (speech == null) return;
+      final out = BytesBuilder();
+      await for (final chunk in speech.synthesize(trimmed, voice: _voice)) {
+        out.add(chunk);
+      }
+      final bytes = out.takeBytes();
+      if (bytes.isNotEmpty) await file.writeAsBytes(bytes, flush: true);
+    } on Object {
+      // 离线 / 额度 / 网络问题：不打扰用户，唤醒时再试。
+    }
+  }
+
+  Future<bool> _synthesizeAndPlay(String text, String id, File file) async {
+    final speech = await _speech();
+    if (speech == null) return false;
+    if (!await _audio.open(id, call: false)) return false;
+    final out = BytesBuilder();
+    await for (final chunk in speech.synthesize(text, voice: _voice)) {
+      out.add(chunk);
+      await _audio.write(id, chunk);
+    }
+    await _audio.end(id);
+    final bytes = out.takeBytes();
+    if (bytes.isNotEmpty) await file.writeAsBytes(bytes, flush: true);
+    return bytes.isNotEmpty;
+  }
+}
+
+final wakeReplyVoiceProvider = Provider<WakeReplyVoice>((ref) {
+  final voice = WakeReplyVoice(
+    ref.watch(speechAudioProvider),
+    ref.watch(deepSeekSpeechProvider),
+    ref.watch(speechSpeakerProvider),
+    ref.watch(speechVoiceSettingsProvider),
+  );
+  // 设置了音色/语速就**立刻用新参数合成好**（09:42）：保存那一刻预合成，
+  // 唤醒时照旧直接播缓存，不用等。
+  void warm() {
+    final reply = ref.read(wakeSettingsProvider).reply;
+    if (reply.trim().isNotEmpty) unawaited(voice.prefetch(reply.trim()));
+  }
+
+  ref.listen(speechVoiceSettingsProvider, (_, __) => warm());
+  ref.listen(wakeSettingsProvider.select((s) => s.reply), (_, __) => warm());
+  // 首次拿到设置也补一次（避免启动时用默认音色合成）。
+  if (ref.read(speechVoiceSettingsProvider) != null) warm();
+  return voice;
+});
