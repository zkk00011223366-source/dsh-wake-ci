+    /** 虚拟屏上有没有前台应用：没有就把「返」「转」置灰。 */
+    /** Dart 同步过来的任务号（迁移后会变）；窗口的动作都带它，避免拿空 id 去注入。 */
+    /** 迁移完成后把窗口改绑到新任务号（否则预览/画面指错任务）。 */
+    fun retaskPreview(id: Long) {
+        previewTaskId = id
+        taskId = id
+        WakeTrace.log("window: retask preview=$id")
+    }
