From d75835e3e02ef7db3e7ea90773ebc9d2dda86d00 Mon Sep 17 00:00:00 2001
From: dsh-wake <wake@local>
Date: Thu, 19 Nov 2026 09:47:17 +0800
Subject: [PATCH 3/3] feat(voice): the shortcut speaks too
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Opening a call from the AI key now sends the wake phrase as the first thing said, the same
way a wake word does — the assistant answers immediately instead of the page opening in
silence.
---
 app/lib/ui/chat/chat_screen.dart | 7 ++++++-
 1 file changed, 6 insertions(+), 1 deletion(-)

diff --git a/app/lib/ui/chat/chat_screen.dart b/app/lib/ui/chat/chat_screen.dart
index de74bb3..18aefb4 100644
--- a/app/lib/ui/chat/chat_screen.dart
+++ b/app/lib/ui/chat/chat_screen.dart
@@ -28,6 +28,7 @@ import '../../state/streaming_pcm_state.dart';
 import '../../voice/live_words.dart';
 import '../../voice/live_words_model.dart';
 import '../../voice/streaming_pcm.dart';
+import '../../voice/wake_settings.dart';
 import '../../voice/wake_word.dart';
 import '../../state/agents_state.dart' show subagentParentProvider;
 import '../../state/attachments.dart';
@@ -378,7 +379,11 @@ class _ChatScreenState extends ConsumerState<ChatScreen> with WidgetsBindingObse
     // as the page exists — before any typing, and through the same start a wake uses.
     WidgetsBinding.instance.addPostFrameCallback((_) {
       if (!mounted) return;
-      if (ref.read(callOnOpenProvider.notifier).take()) unawaited(_startCall(() => mounted));
+      // The AI key says "open a call" the way a wake word does, so it also sends what a wake
+      // would: the assistant is spoken to at once instead of the page opening in silence.
+      if (ref.read(callOnOpenProvider.notifier).take()) {
+        unawaited(_startCall(() => mounted, wakePhrase: ref.read(wakeSettingsProvider).keyword));
+      }
     });
     // A wake word that matched while this screen was not up: answer it once the first frame
     // is up, so the call opens on a screen that exists (and after _voice is built).
-- 
