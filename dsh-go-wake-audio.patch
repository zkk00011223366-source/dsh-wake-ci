+        // 留着旧 id 会让 attach 打到不存在的屏上，回 scopeBusy/空窗，用户看到的就是主屏在跑。
+        displayId = 0
+        // 旧窗口遗留的抓帧也不算"有画面"：否则新窗一开就被 stale 帧揭成黑色。
+        lastFrameAt = 0L
+        iconFont = loadIconFont(app)
+        val px = app.resources.displayMetrics.density
+        val area = area(app, manager)
+        val (w, h) = windowSize(Shape.SMALL, px, area)
+        val at = EdgeSnap.position(dock, w, h, area, (10 * px).roundToInt())
+
+        // 结构（20:30 重构）：窗口就等于画面，只有一层，0 内缩。
