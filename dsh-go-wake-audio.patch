From 2fba2026bfebdbe11a2b0c6a3bd25aab9a6e389b Mon Sep 17 00:00:00 2001
From: dsh-wake <wake@local>
Date: Thu, 19 Nov 2026 09:46:03 +0800
Subject: [PATCH 1/3] fix(voice): the AI key's shortcut opens the call, not
 just a chat
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

The entry used to bump wakeCallRequestProvider from outside the conversation, and the
screen that happened to be up — or none — answered it: a shortcut opened a chat page and
no call. The entry now marks callOnOpenProvider, and the conversation it opens takes the
mark on its first frame and starts the call through the same path a wake uses.
---
 app/lib/ui/chat/chat_screen.dart        |  6 ++++++
 app/lib/ui/shell/system_entry_host.dart |  9 +++++----
 app/lib/voice/wake_word.dart            | 21 +++++++++++++++++++++
 3 files changed, 32 insertions(+), 4 deletions(-)

diff --git a/app/lib/ui/chat/chat_screen.dart b/app/lib/ui/chat/chat_screen.dart
index 45d9906..de74bb3 100644
--- a/app/lib/ui/chat/chat_screen.dart
+++ b/app/lib/ui/chat/chat_screen.dart
@@ -374,6 +374,12 @@ class _ChatScreenState extends ConsumerState<ChatScreen> with WidgetsBindingObse
         unawaited(_startCall(() => mounted, wakePhrase: ref.read(wakeCallRequestProvider.notifier).phrase));
       }
     });
+    // 语音通话 from the AI key: this conversation was opened for it, so the call starts as soon
+    // as the page exists — before any typing, and through the same start a wake uses.
+    WidgetsBinding.instance.addPostFrameCallback((_) {
+      if (!mounted) return;
+      if (ref.read(callOnOpenProvider.notifier).take()) unawaited(_startCall(() => mounted));
+    });
     // A wake word that matched while this screen was not up: answer it once the first frame
     // is up, so the call opens on a screen that exists (and after _voice is built).
     final pendingWake = ref.read(wakeCallRequestProvider);
diff --git a/app/lib/ui/shell/system_entry_host.dart b/app/lib/ui/shell/system_entry_host.dart
index a6531d2..96d75d1 100644
--- a/app/lib/ui/shell/system_entry_host.dart
+++ b/app/lib/ui/shell/system_entry_host.dart
@@ -37,7 +37,7 @@ import '../../state/compose_inbox.dart';
 import '../../state/draft_store.dart';
 import '../../state/hosts_state.dart';
 import '../../state/sessions_state.dart';
-import '../../voice/wake_word.dart' show wakeCallRequestProvider;
+import '../../voice/wake_word.dart' show callOnOpenProvider;
 import '../common/discard_guard.dart';
 import '../tavern/tavern_deepseek_import.dart';
 import '../tavern/tavern_intake.dart';
@@ -142,10 +142,11 @@ class _SystemEntryHostState extends ConsumerState<SystemEntryHost> {
   Future<void> _onEntry(LauncherEntry entry) async {
     switch (entry) {
       case NewChatEntry(call: true):
-        // 语音通话 from the AI key: the call opens once the chat screen exists, the same way a
-        // wake word does it — one path for "a call starts here", whatever asked for it.
+        // 语音通话 from the AI key: mark, then open the conversation. The conversation itself
+        // takes the mark on its first frame and starts the call — asking from here could be
+        // answered by whatever screen happened to be up, or by none (a chat, no call).
+        if (mounted) ref.read(callOnOpenProvider.notifier).mark();
         if (mounted) await _compose(const ComposeRequest());
-        if (mounted) ref.read(wakeCallRequestProvider.notifier).request('');
       case NewChatEntry(:final voice, :final text):
         // The microphone opens only for an app on screen; the shortcut's
         // intent can arrive a beat before Flutter hears it is resumed.
diff --git a/app/lib/voice/wake_word.dart b/app/lib/voice/wake_word.dart
index b8b56e8..d5fc3ab 100644
--- a/app/lib/voice/wake_word.dart
+++ b/app/lib/voice/wake_word.dart
@@ -776,6 +776,27 @@ class WakeCallHandled extends Notifier<int> {
   void mark(int value) => state = value;
 }
 
+
+/// 语音通话 asked for from outside a conversation — the AI key's shortcut. The entry marks
+/// it, and the conversation that opens consumes it: asking through [wakeCallRequestProvider]
+/// from outside meant the request could be answered by whatever screen happened to be up,
+/// or by none, which is how a shortcut opened a chat and no call.
+final callOnOpenProvider = NotifierProvider<CallOnOpen, bool>(CallOnOpen.new);
+
+class CallOnOpen extends Notifier<bool> {
+  @override
+  bool build() => false;
+
+  void mark() => state = true;
+
+  /// True once: the screen that takes it starts the call and clears it.
+  bool take() {
+    if (!state) return false;
+    state = false;
+    return true;
+  }
+}
+
 class WakeCallRequest extends Notifier<int> {
   /// 唤醒词 as the person set it: the call hands it to the assistant as the first thing
   /// said, so the assistant answers a wake instead of opening a silent page.
-- 
2.43.0


