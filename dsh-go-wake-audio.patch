+package io.github.ccch1mneyyy.dsh_app.phone.vscreen
+
+import android.app.Activity
+import android.graphics.Color
+import android.os.Bundle
+import android.view.Gravity
+import android.widget.TextView
+
+/**
+ * 虚拟屏的"桌面"占位页（照 Mika/Operit 的做法）。
+ *
+ * 虚拟屏是一块独立 display：里面没有 launcher、也没有任何 activity 时，合成器只能输出纯黑，
+ * 于是"主屏还没开应用就切到虚拟屏"必然是黑窗。这里给那块屏一个常驻的空白页，
+ * 让虚拟屏永远有内容可显示——空屏时看到的是它，而不是黑。
+ *
+ * 由特权侧在建屏成功后用 ActivityOptions.setLaunchDisplayId 起在目标 display 上。
+ */
+class PlaceholderActivity : Activity() {
+    override fun onCreate(savedInstanceState: Bundle?) {
+        super.onCreate(savedInstanceState)
+        setContentView(TextView(this).apply {
+            text = "虚拟屏"
+            gravity = Gravity.CENTER
+            setTextColor(0x66FFFFFF)
+            textSize = 15f
+            setBackgroundColor(Color.rgb(8, 10, 18))
+        })
+    }
+}
