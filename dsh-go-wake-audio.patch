index 0000000..4013a74
--- /dev/null
+++ b/app/lib/voice/wake_word.dart
@@ -0,0 +1,856 @@
+// 语音唤醒（常驻监听）: the switch, the recognizer and what a wake word does.
+//
+// Where each piece runs:
+//   · wake/WakeWordService.kt  — 前台服务（microphone）、PARTIAL_WAKE_LOCK、常驻通知、麦克风让位
+//   · wake/WakeCapture.kt      — AudioRecord 16 kHz mono, 只把「有人说话」的 20 ms 帧送上来
+//   · this file                — 复用实时字幕的 sherpa 流式模型，匹配唤醒词，判定命中后的动作
+//
+// The model is the one 设置 › 语音 › 实时字幕 already downloads (voice/streaming_asr.dart), so
+// listening needs no second model on the phone. Live words stay off while listening and the other
+// way round: both would decode the same microphone twice for nothing.
+
+import 'dart:async';
+import 'dart:convert';
+import 'dart:io';
+import 'dart:typed_data';
+
+import 'package:dsh_client/dsh_client.dart';
+import 'package:flutter/services.dart';
+import 'package:path_provider/path_provider.dart';
+import 'package:flutter_riverpod/flutter_riverpod.dart';
+import 'package:sherpa_onnx/sherpa_onnx.dart' as sherpa;
+
+import '../state/connection_state.dart';
+import '../state/streaming_asr_model_state.dart';
+import 'streaming_asr_model.dart';
+import 'wake_keywords.dart';
+import 'wake_settings.dart';
+
+/// Off unless asked: a marker file in Downloads turns the trace on for as long as it is
+/// there, so a failure can be read back without leaving a log that grows on the phone.
+void _dbg(String message) {
+  try {
+    final dir = Directory('/sdcard/Download/DSH-Go');
+    if (!File('${dir.path}/.wake-log').existsSync()) return;
+    File('${dir.path}/wake-debug.log').writeAsStringSync(
+      '${DateTime.now().toIso8601String().substring(11, 23)} $message\n',
+      mode: FileMode.append,
+      flush: true,
+    );
+  } on Object {
+    // No marker, no storage: the trace is best effort.
+  }
+}
+
+/// What the listener is doing.
+enum WakeListening {
+  /// 常驻监听 off.
+  off,
+
+  /// Asking the service to start.
+  starting,
+
+  /// The service owns the microphone and Dart is decoding its frames.
+  listening,
+
+  /// 让位 or 冷却: not listening, and coming back on its own.
+  paused,
+
+  /// 模型 or 权限 missing: switching it on cannot work yet.
+  unavailable,
+
+  /// The service could not go foreground / open the microphone.
+  failed,
+}
+
+class WakeStatus {
+  const WakeStatus({this.listening = WakeListening.off, this.reason, this.hits = 0, this.heard = ''});
+
+  final WakeListening listening;
+
+  /// Why it is not listening (`model`, `permission`, `busy`, `foreground`, `capture`, …).
+  final String? reason;
+
+  /// Wake words heard since launch (诊断用).
+  final int hits;
+
+  /// What the recognizer last made of the audio (诊断用): shown under the switch so a
+  /// person can read back what it hears without a log file.
+  final String heard;
+
+  bool get on => listening == WakeListening.listening || listening == WakeListening.starting;
+
+  WakeStatus copyWith({
+    WakeListening? listening,
+    String? reason,
+    bool clearReason = false,
+    int? hits,
+    String? heard,
+  }) => WakeStatus(
+    listening: listening ?? this.listening,
+    reason: clearReason ? null : (reason ?? this.reason),
+    hits: hits ?? this.hits,
+    heard: heard ?? this.heard,
+  );
+}
+
+/// The native side of 语音唤醒 (`dsh/wake`, wake/WakeWordPlugin.kt).
+class WakePlatform {
+  const WakePlatform();
+
+  static const _methods = MethodChannel('dsh/wake');
+  static const _events = EventChannel('dsh/wake/events');
+  static const _voice = MethodChannel('dsh/voice');
+
+  Future<Map<Object?, Object?>> status() async =>
+      await _methods.invokeMapMethod<Object?, Object?>('status') ?? const <Object?, Object?>{};
+
+  Future<void> start() => _methods.invokeMethod<void>('start');
+
+  Future<void> stop() => _methods.invokeMethod<void>('stop');
+
+  /// 熄屏唤醒: the activity comes forward with the screen on (MainActivity.onResume).
+  Future<void> present() => _methods.invokeMethod<void>('present');
+
+  /// RECORD_AUDIO goes through the voice channel, which already owns that request.
+  Future<bool> requestMicrophone() async {
+    final state = await _voice.invokeMethod<Object?>('requestPermission');
+    if (state == 'granted') return true;
+    return (await status())['microphone'] == true;
+  }
+
+  Stream<Map<Object?, Object?>> get events =>
+      _events.receiveBroadcastStream().where((event) => event is Map).cast<Map<Object?, Object?>>();
+}
+
+final wakePlatformProvider = Provider<WakePlatform>((ref) => const WakePlatform());
+
+/// 唤醒/AI 键进通话后发给助手的第一句（需求单 16:30 的三段式）。
+/// 这是给助手的内部指令，不是把唤醒词当问题发；它的回复走通话的流式朗读，
+/// 所以 1–2 秒内就该听到「我在」，然后等用户开口。
+const wakeGreetingInstruction =
+    '（唤醒）只回两个字：我在。不要多说，不要调用工具，不要展开。';
+
+class WakeWordController extends Notifier<WakeStatus> {
+  /// 唤醒后 8 秒内不再触发 (answered, or the same phrase twice).
+  // Long enough that one 小安小安 cannot fire twice (the spotter resets on the hit), short
+  // enough that saying it again a moment later wakes it again.
+  static const _cooldown = Duration(milliseconds: 1200);
+
+  /// A burst longer than this starts a fresh recognizer stream (nothing said for 15 s anyway).
+  static const _burstLimit = Duration(seconds: 15);
+
+  /// A wake word that opened no call (no conversation on screen) comes back after this.
+  static const _callGrace = Duration(seconds: 6);
+
+  StreamSubscription<Map<Object?, Object?>>? _events;
+  sherpa.OnlineRecognizer? _recognizer;
+  sherpa.OnlineStream? _stream;
+  DateTime? _streamStarted;
+  DateTime? _cooldownUntil;
+  Timer? _resumeTimer;
+  String _keyword = '';
+  String _text = '';
+  bool _suspended = false;
+  bool _syncing = false;
+
+  @override
+  WakeStatus build() {
+    final settings = ref.watch(wakeSettingsProvider);
+    // No model of its own any more: what it hears is recognized by the engine's SenseVoice,
+    // the recognizer 语音输入 already uses, so 实时字幕's downloaded model is not a
+    // precondition for listening.
+    const hasModel = true;
+    _keyword = settings.keyword;
+    if (_events == null) {
+      _events = ref.read(wakePlatformProvider).events.listen(_onEvent, onError: (Object _) {});
+      ref.onDispose(() {
+        _events?.cancel();
+        _events = null;
+        _resumeTimer?.cancel();
+        _release();
+      });
+    }
+    unawaited(_sync(settings, hasModel: hasModel));
+    return const WakeStatus();
+  }
+
+  /// 常驻监听 switched on or off from 设置.
+  Future<void> setEnabled(bool on) async {
+    await ref.read(wakeSettingsProvider.notifier).edit((saved) => saved.copyWith(enabled: on));
+    if (!on) await _stopService();
+  }
+
+  /// 通话页打开: the call owns the microphone until [resume].
+  Future<void> suspend() async {
+    _suspended = true;
+    _resumeTimer?.cancel();
+    await _stopService();
+    if (ref.mounted) state = state.copyWith(listening: WakeListening.paused, clearReason: true);
+  }
+
+  /// 通话结束: listening comes back (unless it was switched off meanwhile).
+  Future<void> resume() async {
+    _suspended = false;
+    _resumeTimer?.cancel();
+    final settings = await ref.read(wakeSettingsProvider.notifier).ready();
+    if (!settings.enabled) return;
+    await _sync(settings, hasModel: true);
+  }
+
+  /// A sync asked for while another one runs must not be dropped: dropping it is how a call
+  /// ends and 常驻监听 stays paused forever. Queue one more pass instead.
+  bool _syncAgain = false;
+
+  Future<void> _sync(WakeSettings settings, {required bool hasModel}) async {
+    if (_syncing) {
+      _syncAgain = true;
+      return;
+    }
+    _syncing = true;
+    try {
+      if (!settings.enabled) {
+        await _stopService();
+        if (ref.mounted) state = state.copyWith(listening: WakeListening.off, clearReason: true);
+        return;
+      }
+      if (_suspended) {
+        if (ref.mounted) state = state.copyWith(listening: WakeListening.paused, clearReason: true);
+        return;
+      }
+      if (!hasModel) {
+        // 复用实时字幕的模型: without it there is nothing to decode with.
+        await _stopService();
+        if (ref.mounted) {
+          state = state.copyWith(listening: WakeListening.unavailable, reason: 'model');
+        }
+        return;
+      }
+      if (!_permitted) {
+        final granted = await _askMicrophone();
+        _permitted = granted;
+        if (!granted) {
+          if (ref.mounted) {
+            state = state.copyWith(listening: WakeListening.unavailable, reason: 'permission');
+          }
+          return;
+        }
+      }
+      if (ref.mounted) state = state.copyWith(listening: WakeListening.starting, clearReason: true);
+      await _try(() => ref.read(wakePlatformProvider).start());
+    } finally {
+      _syncing = false;
+      if (_syncAgain && ref.mounted) {
+        _syncAgain = false;
+        final latest = ref.read(wakeSettingsProvider);
+        unawaited(_sync(latest, hasModel: hasModel));
+      }
+    }
+  }
+
+  var _permitted = false;
+
+  /// The channel is absent on iOS/鸿蒙 and in widget tests: a missing one is "not listening",
+  /// never an exception in the app's own code path.
+  Future<bool> _try(Future<void> Function() action) async {
+    try {
+      await action();
+      return true;
+    } on PlatformException {
+      return false;
+    } on MissingPluginException {
+      return false;
+    }
+  }
+
+  Future<bool> _askMicrophone() async {
