+    /** 这块虚拟屏的物理缓冲 + 当前旋转；屏还没接上时按 0 处理（[aspect] 会退回手机比例）。 */
+    private fun geometry(): DisplayFrameGeometry {
+        val rotation = runCatching {
+            context?.getSystemService(android.hardware.display.DisplayManager::class.java)
+                ?.getDisplay(displayId)?.rotation
+        }.getOrNull() ?: 0
+        return DisplayFrameGeometry(displayWidth, displayHeight, rotation)
+    }
