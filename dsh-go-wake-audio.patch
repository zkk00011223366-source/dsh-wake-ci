new file mode 100644
index 0000000..8a88271
--- /dev/null
+++ b/app/lib/voice/wake_keywords.dart
@@ -0,0 +1,50 @@
+// The keyword spotter's keyword line, built from 唤醒词.
+//
+// sherpa-onnx's KWS model models pinyin (initial + final), and its keywords file
+// holds one line per phrase:
+//
+//   x iǎo ān x iǎo ān @小安小安
+//
+// so 「小安小安」 has to become a pinyin token line before the spotter can be
+// asked for it. This file does only that, and says nothing when it cannot.
+
+import 'package:pinyin/pinyin.dart';
+
+/// Longest first: 中 zh comes before z, 学 xué is x + ué.
+const _initials = <String>[
+  'zh', 'ch', 'sh', 'b', 'p', 'm', 'f', 'd', 't', 'n', 'l', 'g', 'k', 'h',
+  'j', 'q', 'x', 'r', 'z', 'c', 's', 'y', 'w',
+];
+
+/// The line the spotter reads for [phrase], or null when it cannot be written.
+///
+/// A phrase with anything but Chinese characters and spaces (digits, letters,
+/// punctuation) has no pinyin here; the caller then falls back to recognizing
+/// the utterance instead.
+String? wakeKeywordLine(String phrase) {
+  final text = phrase.replaceAll(RegExp(r'\s+'), '');
+  if (text.isEmpty) return null;
+  if (!RegExp(r'^[\u4e00-\u9fff]+$').hasMatch(text)) return null;
+
+  final words = <String>[];
+  for (final char in text.split('')) {
+    final pinyin = PinyinHelper.getPinyinE(char, separator: ' ', format: PinyinFormat.WITH_TONE_MARK).trim();
+    if (pinyin.isEmpty) return null;
+    final (initial, finalPart) = _split(pinyin);
+    if (initial.isNotEmpty) words.add(initial);
+    if (finalPart.isEmpty) return null;
+    words.add(finalPart);
+  }
+  if (words.isEmpty) return null;
+  return '${words.join(' ')} @$text';
+}
+
+/// 学 xué → (x, ué); 爱 ài → ('', ài).
+(String, String) _split(String syllable) {
+  for (final initial in _initials) {
+    if (syllable.startsWith(initial) && syllable.length > initial.length) {
+      return (initial, syllable.substring(initial.length));
+    }
+  }
+  return ('', syllable);
+}
