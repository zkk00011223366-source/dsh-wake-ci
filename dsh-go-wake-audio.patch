+    /**
+     * 切到后台：只把窗口从屏幕上拿掉，**不释放直显 surface、不注销预览**
+     * （与用户决策一致：任务继续、AI 继续读屏、点球回来立刻有画面）。
+     */
+    fun hideWindowOnly(announce: Boolean = true) {
+        val view = root ?: return
+        gripWin?.let { v -> wm?.let { m -> runCatching { m.removeView(v) } } }
+        gripWin = null
+        gripParams = null
+        val manager = wm
+        root = null
+        try { manager?.removeView(view) } catch (_: Exception) {}
+        // 窗口已不在屏上：状态必须跟着变，否则后续"切形态"会对着空窗口算尺寸。
+        shape = Shape.SLIVER
+        WakeTrace.log("window: hidden (surface kept, display=$displayId)")
+        // 2（条恢复）：窗口没了但仍在虚拟屏上干活 → 这就是"后台屏"（收起的虚拟屏），
+        // 通道跟着落到 silent；否则 VscreenUi 会判 virtual & !hasTask → none，
+        // 用户点完眼睛什么都看不到（11:35 现场：条和窗一起消失）。
+        if (PhoneRegistry.vscreenTarget == "virtual") PhoneRegistry.vscreenTarget = "silent"
+        // 先原生把球叫出来：Dart 那条 onAction 只是通知，App 在后台时可能没人接，
+        // 而"点眼睛 → 立刻出两键球"是硬需求。任何收窗路径（眼睛、5 秒无画面、attach 失败、
+        // 应用被迁走）都必须走这里，条才会按当前通道回来。
+        val app = context
+        if (app != null) {
+            TransferBall.setWanted(true, app, forced = true)
+            WakeTrace.log("ball: forced on (window hidden, announce=$announce)")
+        }
+        if (announce) onAction?.invoke("eyeHidden")
+    }
+
+    fun hide() {
+        runCatching { presentationHost?.dismiss() }
+        presentationHost = null
+        // 关窗恢复原来的音量（窗口里默认静音，别把手机整体声音一直掐着）。
+        context?.let { restoreVolume(it) }
+        // 把手是独立窗口：主窗收起时必须一起移除，否则屏幕上会留下一条绿条。
+        gripWin?.let { v -> wm?.let { m -> runCatching { m.removeView(v) } } }
+        gripWin = null
+        gripParams = null
+        revealed = false
+        context?.let { TransferBall.setWanted(false) }
+        val view = root ?: return
+        val app = context ?: view.context.applicationContext
+        root = null
+        content = null
+        picture = null
+        fallback = null
+        waiting = null
+        params = null
+        context = null
+        shape = Shape.SLIVER
+        unregisterScreen(app)
+        detachSurface(app)
+        lastBitmap?.recycle()
+        lastBitmap = null
+        val manager = wm
+        wm = null
+        try {
+            manager?.removeView(view)
+        } catch (_: Exception) {
+        }
+    }
