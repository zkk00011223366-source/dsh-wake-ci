+    /**
+     * 一颗圆键（第十八节）：图标字体单色、28dp 视觉 / 44dp 触摸、圆形半透明底、1.5dp 描边、
+     * alpha 0.85（按下 1.0）。
+     */
+    private fun roundKey(app: Context, glyph: Int, px: Float, onTap: () -> Unit): FrameLayout {
+        val touch = (44 * px).roundToInt()
+        val visible = (28 * px).roundToInt()
+        val holder = FrameLayout(app).apply {
+            layoutParams = LinearLayout.LayoutParams(touch, touch)
+            alpha = KEY_ALPHA
+            isClickable = true
+            setOnClickListener { onTap() }
+            setOnTouchListener { v, event ->
+                when (event.actionMasked) {
+                    MotionEvent.ACTION_DOWN -> {
+                        v.alpha = 1f
+                        false
+                    }
+                    MotionEvent.ACTION_UP, MotionEvent.ACTION_CANCEL -> {
+                        v.alpha = KEY_ALPHA
+                        false
+                    }
+                    else -> false
+                }
+            }
+        }
+        val circle = TextView(app).apply {
+            tag = "glyph"
+            text = String(Character.toChars(glyph))
+            gravity = Gravity.CENTER
+            setTextColor(Color.WHITE)
+            setTextSize(TypedValue.COMPLEX_UNIT_SP, 16f)
+            iconFont?.let { typeface = it }
+            background = GradientDrawable().apply {
+                shape = GradientDrawable.OVAL
+                setColor(CHROME)
+                setStroke((1.5f * px).roundToInt(), 0x66FFFFFF)
+            }
+        }
+        holder.addView(circle, FrameLayout.LayoutParams(visible, visible, Gravity.CENTER))
+        return holder
+    }
+
+    /**
+     * 全屏图标（用户 15:33）：像「回」字——外面一个方格，里面再一个小方格。
+     * 字体里没有这个字形，直接画。
+     */
+    private class FullscreenGlyph(context: Context, private val px: Float) : View(context) {
+        private val paint = Paint(Paint.ANTI_ALIAS_FLAG).apply {
+            style = Paint.Style.STROKE
+            strokeWidth = 2f * px
+            color = Color.WHITE
+            strokeJoin = Paint.Join.ROUND
+            strokeCap = Paint.Cap.ROUND
+        }
+
+        override fun onDraw(canvas: Canvas) {
+            // 四角括号（⛶ 那款）：四段 L 形短线，取代原来的"回"字（00:34 要求）。
+            val cx = width / 2f
+            val cy = height / 2f
+            val r = 9f * px          // 半边长
+            val arm = 4.2f * px      // 每段长度
+            val left = cx - r; val right = cx + r
+            val top = cy - r; val bottom = cy + r
+            canvas.drawLine(left, top, left + arm, top, paint); canvas.drawLine(left, top, left, top + arm, paint)
+            canvas.drawLine(right, top, right - arm, top, paint); canvas.drawLine(right, top, right, top + arm, paint)
+            canvas.drawLine(left, bottom, left + arm, bottom, paint); canvas.drawLine(left, bottom, left, bottom - arm, paint)
+            canvas.drawLine(right, bottom, right - arm, bottom, paint); canvas.drawLine(right, bottom, right, bottom - arm, paint)
+        }
+    }
+
+    /** 和 [roundKey] 同款：44dp 触点、28dp 圆底，内容换成自绘图标。 */
+    private fun roundKeyCustom(
+        app: Context,
+        px: Float,
+        content: () -> View,
+        onTap: () -> Unit,
+    ): FrameLayout {
+        val touch = (44 * px).roundToInt()
+        val visible = (28 * px).roundToInt()
+        val holder = FrameLayout(app).apply {
+            layoutParams = LinearLayout.LayoutParams(touch, touch)
+            alpha = KEY_ALPHA
+            isClickable = true
+            setOnClickListener { onTap() }
+            setOnTouchListener { v, event ->
+                when (event.actionMasked) {
+                    MotionEvent.ACTION_DOWN -> { v.alpha = 1f; false }
+                    MotionEvent.ACTION_UP, MotionEvent.ACTION_CANCEL -> { v.alpha = KEY_ALPHA; false }
+                    else -> false
+                }
+            }
+        }
+        val circle = FrameLayout(app).apply {
+            background = GradientDrawable().apply {
+                shape = GradientDrawable.OVAL
+                setColor(CHROME)
+                setStroke((1.5f * px).roundToInt(), 0x66FFFFFF)
+            }
+        }
+        circle.addView(content(), FrameLayout.LayoutParams(-1, -1))
+        holder.addView(circle, FrameLayout.LayoutParams(visible, visible, Gravity.CENTER))
+        return holder
+    }
