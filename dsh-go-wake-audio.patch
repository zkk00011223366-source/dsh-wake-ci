+import '../phone/virtual_screen_page.dart';
+import 'dart:async';
+
+import 'package:flutter/material.dart';
+import 'package:flutter/services.dart';
+import 'package:flutter_riverpod/flutter_riverpod.dart';
+
+import '../../state/chat_state.dart';
+import '../../state/phone_state.dart';
+import '../../state/sessions_state.dart';
+import '../common/brief_notice.dart';
+
+/// 任务视图 + 操作进度（第十节 8、9、第二十二节 A）: one 「帮我做某事」 is a task.
+///
+/// 一块虚拟屏，任务排队进去：**进行中**（AI 正在做，带当前步骤与耗时）、**排队中**（还没轮到
+/// 的请求，可以取消，也可以插到队首）、**最近完成**（刚做完的，留一会儿）。悬浮窗、聊天、
+/// 任务卡看的是同一个来源：手机操控自己的状态。
+///
+/// A 阶段只排队不并行 —— 第二十二节要先看队列，再谈每任务一块屏。
+class PhoneTaskCard extends ConsumerStatefulWidget {
+  const PhoneTaskCard({super.key});
+
+  @override
+  ConsumerState<PhoneTaskCard> createState() => _PhoneTaskCardState();
+}
+
+class _PhoneTaskCardState extends ConsumerState<PhoneTaskCard> {
+  Timer? _ticker;
+  Timer? _poll;
+  bool _busy = false;
+  bool _hidden = false;
+
+  @override
+  void initState() {
+    super.initState();
+    _ticker = Timer.periodic(const Duration(seconds: 1), (_) {
+      if (mounted) setState(() {});
+    });
+    _poll = Timer.periodic(const Duration(seconds: 4), (_) {
+      if (!mounted) return;
+      if (ref.read(phoneProvider).status.task.active) {
+        unawaited(ref.read(phoneProvider.notifier).refreshLog());
+      }
+    });
+  }
+
+  @override
+  void dispose() {
+    _ticker?.cancel();
+    _poll?.cancel();
+    super.dispose();
+  }
+
+  Future<void> _run(Future<bool> Function() action) async {
+    if (_busy) return;
+    setState(() => _busy = true);
+    try {
+      await action();
+    } finally {
+      if (mounted) setState(() => _busy = false);
+    }
+  }
+
+  /// 排队中的请求：还没轮到它的那些人的话（AI 正在忙时发来的）。
+  List<PendingPrompt> _queued(String? sessionId) {
+    if (sessionId == null) return const [];
+    final pending = ref.watch(chatProvider(sessionId)).pending;
+    return [
+      for (final prompt in pending)
+        if (prompt.queued && !prompt.isAutomatic && !prompt.isEngineNote && prompt.text.trim().isNotEmpty) prompt,
+    ];
+  }
+
+  /// 取消排队：把这条从收件箱里拿出来。原文放回剪贴板，免得人再打一遍。
+  Future<void> _cancelQueued(String sessionId, PendingPrompt prompt) async {
+    final chat = ref.read(chatProvider(sessionId).notifier);
+    await _run(() async {
+      final ok = await chat.withdrawQueued(prompt);
+      if (!ok) return false;
+      await Clipboard.setData(ClipboardData(text: prompt.text));
+      if (mounted) showBriefNotice(context, '已取消排队，内容已复制');
+      return true;
+    });
+  }
+
+  /// 插队：把它挪进正在跑的这一轮，AI 马上处理。
+  Future<void> _promote(String sessionId, PendingPrompt prompt) async {
+    final chat = ref.read(chatProvider(sessionId).notifier);
+    await _run(() async {
+      final ok = await chat.steerQueued(prompt);
+      if (ok && mounted) showBriefNotice(context, '已插到前面');
+      return ok;
+    });
+  }
+
+  void _showProcess(List<PhoneLogEntry> log) {
+    showModalBottomSheet<void>(
+      context: context,
+      showDragHandle: true,
+      builder: (context) => SafeArea(
+        child: ListView(
+          padding: const EdgeInsets.fromLTRB(16, 0, 16, 16),
+          children: [
+            Text('完整过程', style: Theme.of(context).textTheme.titleMedium),
+            const SizedBox(height: 8),
+            if (log.isEmpty) const Text('还没有记录到步骤。'),
+            for (final entry in log.reversed)
+              Padding(
+                padding: const EdgeInsets.symmetric(vertical: 6),
+                child: Row(
+                  crossAxisAlignment: CrossAxisAlignment.start,
+                  children: [
+                    Text(_clock(entry.time), style: Theme.of(context).textTheme.bodySmall),
+                    const SizedBox(width: 10),
+                    Expanded(child: Text(_line(entry))),
+                  ],
+                ),
+              ),
+          ],
+        ),
+      ),
+    );
+  }
+
+  @override
+  Widget build(BuildContext context) {
+    if (_hidden) return const SizedBox.shrink();
+    final state = ref.watch(phoneProvider);
+    final task = state.status.task;
+    final sessionId = ref.watch(currentSessionProvider);
+    final queued = _queued(sessionId);
+    final done = ref.watch(phoneTaskHistoryProvider);
+    final recent = [
+      for (final record in done)
+        if (DateTime.now().difference(record.endedAt) < const Duration(minutes: 3)) record,
+    ];
+    if (!task.active && queued.isEmpty && recent.isEmpty) return const SizedBox.shrink();
+
+    final theme = Theme.of(context);
+    final steps = state.log.take(3).toList();
+    final current = task.active && steps.isNotEmpty ? _line(steps.first) : '正在准备…';
+    return Card(
+      key: const ValueKey('phone-task-card'),
+      margin: const EdgeInsets.fromLTRB(12, 6, 12, 6),
+      child: Padding(
+        padding: const EdgeInsets.fromLTRB(12, 10, 12, 8),
+        child: Column(
+          crossAxisAlignment: CrossAxisAlignment.start,
+          mainAxisSize: MainAxisSize.min,
+          children: [
+            if (task.active) ...[
+              Row(
+                children: [
+                  Icon(Icons.touch_app_outlined, size: 16, color: theme.colorScheme.primary),
+                  const SizedBox(width: 6),
+                  Expanded(
+                    child: Text(
+                      task.app == null || task.app!.isEmpty ? '手机操控任务' : '正在操作 ${task.app}',
+                      style: theme.textTheme.titleSmall,
+                      maxLines: 1,
+                      overflow: TextOverflow.ellipsis,
+                    ),
+                  ),
+                  Text(
+                    _elapsed(DateTime.now().difference(ref.watch(phoneTaskClockProvider))),
+                    style: theme.textTheme.bodySmall,
+                  ),
+                  const SizedBox(width: 4),
+                  IconButton(
+                    key: const ValueKey('phone-task-card-close'),
+                    icon: const Icon(Icons.close, size: 16),
+                    padding: EdgeInsets.zero,
+                    constraints: const BoxConstraints(minWidth: 28, minHeight: 28),
+                    tooltip: '收起卡片',
+                    onPressed: () => setState(() => _hidden = true),
+                  ),
+                  if (task.paused) ...[
+                    const SizedBox(width: 6),
+                    Text(
+                      '已暂停',
+                      style: theme.textTheme.bodySmall?.copyWith(color: theme.colorScheme.tertiary),
+                    ),
+                  ],
+                  if (task.interrupted == true) ...[
+                    const SizedBox(width: 6),
+                    Text(
+                      '被中断',
+                      style: theme.textTheme.bodySmall?.copyWith(color: theme.colorScheme.error),
+                    ),
+                  ],
+                ],
+              ),
+              const SizedBox(height: 6),
+              Text('当前：$current', maxLines: 2, overflow: TextOverflow.ellipsis, style: theme.textTheme.bodyMedium),
+              if (steps.length > 1)
+                for (final entry in steps.skip(1))
+                  Padding(
+                    padding: const EdgeInsets.only(top: 2),
+                    child: Text(
+                      '· ${_line(entry)}',
+                      maxLines: 1,
+                      overflow: TextOverflow.ellipsis,
+                      style: theme.textTheme.bodySmall?.copyWith(color: theme.colorScheme.onSurfaceVariant),
+                    ),
+                  ),
+            ],
+            if (queued.isNotEmpty) ...[
+              if (task.active) const SizedBox(height: 8),
+              Row(
+                children: [
+                  Icon(Icons.queue_play_next_outlined, size: 16, color: theme.colorScheme.onSurfaceVariant),
+                  const SizedBox(width: 6),
+                  Text('排队中 · ${queued.length}', style: theme.textTheme.titleSmall),
+                ],
+              ),
+              for (var index = 0; index < queued.length; index++)
+                Padding(
+                  padding: const EdgeInsets.only(top: 4),
+                  child: Row(
+                    children: [
+                      Text('${index + 1}.', style: theme.textTheme.bodySmall),
+                      const SizedBox(width: 6),
+                      Expanded(
+                        child: Text(
+                          queued[index].text.replaceAll('\n', ' '),
+                          maxLines: 1,
+                          overflow: TextOverflow.ellipsis,
+                          style: theme.textTheme.bodySmall,
+                        ),
+                      ),
+                      TextButton(
+                        key: ValueKey('phone-task-promote-${queued[index].requestId}'),
+                        onPressed: sessionId == null || _busy ? null : () => _promote(sessionId, queued[index]),
+                        child: const Text('插队'),
+                      ),
+                      TextButton(
+                        key: ValueKey('phone-task-cancel-${queued[index].requestId}'),
+                        onPressed: sessionId == null || _busy ? null : () => _cancelQueued(sessionId, queued[index]),
+                        child: const Text('取消'),
+                      ),
+                    ],
+                  ),
+                ),
+            ],
+            if (recent.isNotEmpty)
+              for (final record in recent)
+                Padding(
+                  padding: const EdgeInsets.only(top: 6),
+                  child: Row(
+                    children: [
+                      Icon(
+                        (record.reason ?? '').contains('中断')
+                            ? Icons.error_outline
+                            : Icons.check_circle_outline,
+                        size: 14,
+                        color: (record.reason ?? '').contains('中断')
+                            ? theme.colorScheme.error
+                            : theme.colorScheme.primary,
+                      ),
+                      const SizedBox(width: 6),
+                      Expanded(
+                        child: Text(
+                          '${record.app ?? '手机任务'} · ${record.reason ?? '已完成'}',
+                          maxLines: 1,
+                          overflow: TextOverflow.ellipsis,
+                          style: theme.textTheme.bodySmall?.copyWith(color: theme.colorScheme.onSurfaceVariant),
+                        ),
+                      ),
+                      Text(_elapsed(record.endedAt.difference(record.startedAt)), style: theme.textTheme.bodySmall),
+                    ],
+                  ),
+                ),
+            const SizedBox(height: 4),
+            Row(
+              children: [
+                TextButton(
+                  key: const ValueKey('phone-task-trace'),
+                  onPressed: () => _showProcess(state.log),
+                  child: const Text('查看过程'),
+                ),
+                const Spacer(),
+                if (task.active) ...[
+                  TextButton(
+                    key: const ValueKey('phone-task-pause'),
+                    onPressed: _busy
+                        ? null
+                        : () => _run(() async {
+                              final id = task.id;
+                              if (id == null) return false;
+                              return ref.read(phoneProvider.notifier).pauseTask(id, !task.paused);
+                            }),
+                    child: Text(task.paused ? '继续' : '暂停'),
+                  ),
+                  TextButton(
+                    key: const ValueKey('phone-task-takeover'),
+                    // 真接管：打开可操作的虚拟屏整页，人亲自点哪打哪；
+                    // 之前这里调 stopTask()，跟「结束」一样，等于假按钮。
+                    onPressed: _busy
+                        ? null
+                        : () {
+                            final id = task.id;
+                            if (id == null) return;
+                            Navigator.of(context).push(VirtualScreenPage.route(id));
+                          },
+                    child: const Text('接管'),
+                  ),
+                  TextButton(
+                    key: const ValueKey('phone-task-end'),
+                    onPressed: _busy ? null : () => _run(() => ref.read(phoneProvider.notifier).stopTask()),
+                    child: const Text('结束'),
+                  ),
+                ],
+              ],
+            ),
+          ],
+        ),
+      ),
+    );
+  }
+
+  /// One journal entry as the conversation would say it.
+  String _line(PhoneLogEntry entry) {
+    final summary = entry.summary.trim();
+    if (summary.isNotEmpty) return summary;
+    final tool = entry.tool.trim();
+    if (tool.isEmpty) return '操作了一步';
+    return tool;
+  }
+
+  static String _clock(DateTime? time) => time == null
+      ? ''
+      : '${time.hour.toString().padLeft(2, '0')}:${time.minute.toString().padLeft(2, '0')}';
+
+  static String _elapsed(Duration d) {
+    if (d.inSeconds < 60) return '${d.inSeconds} 秒';
+    return '${d.inMinutes} 分 ${d.inSeconds % 60} 秒';
+  }
+}
+
+/// 一件做完的活，留在卡上一会儿（第二十二节 A：显示完成）。[reason] 是它为什么停：接管、熄屏
+/// 中断这些，失败也要说清楚（第十节 8）。
+class PhoneTaskRecord {
+  const PhoneTaskRecord({
+    required this.id,
+    required this.app,
+    required this.startedAt,
+    required this.endedAt,
+    this.reason,
+  });
+
+  final int id;
+  final String? app;
+  final DateTime startedAt;
+  final DateTime endedAt;
+  final String? reason;
+}
+
+/// 任务为什么停：状态里的 stopSource 翻成一句人话。
+String? phoneTaskStopReason(PhoneTaskStatus task) {
+  if (task.active) return null;
+  if (task.interrupted == true) return '被中断';
+  return switch (task.stopSource) {
+    'SCREEN_OFF' => '熄屏中断',
+    'ENVIRONMENT' => '环境中断',
+    'USER' => '已结束',
+    _ => null,
+  };
+}
+
+/// 任务的开始/结束只在这里记：手机操控的状态是唯一来源，卡片和悬浮窗不各记一份。
+class PhoneTaskHistory extends Notifier<List<PhoneTaskRecord>> {
+  int? _id;
+  String? _app;
+  DateTime? _startedAt;
+
+  @override
+  List<PhoneTaskRecord> build() {
+    ref.listen(phoneProvider, (previous, next) {
+      _sync(next.status.task);
+    });
+    _sync(ref.read(phoneProvider).status.task);
+    return const [];
+  }
+
+  void _sync(PhoneTaskStatus task) {
+    if (task.active) {
+      // A new number is a new task; the same number running on is the same one.
+      if (_id != task.id) {
+        _id = task.id;
+        _startedAt = DateTime.now();
+        _app = null;
+      }
+      if (task.app != null && task.app!.isNotEmpty) _app = task.app;
+      return;
+    }
+    final id = _id;
+    final startedAt = _startedAt;
+    if (id == null || startedAt == null) return;
+    final app = _app;
+    _id = null;
+    _startedAt = null;
+    _app = null;
+    // A task that never named an app still ran: the record keeps it, without inventing a name.
+    state = [
+      PhoneTaskRecord(
+        id: id,
+        app: app,
+        startedAt: startedAt,
+        endedAt: DateTime.now(),
+        reason: phoneTaskStopReason(task),
+      ),
+      ...state,
+    ].take(4).toList(growable: false);
+  }
+}
+
+final phoneTaskHistoryProvider = NotifierProvider<PhoneTaskHistory, List<PhoneTaskRecord>>(PhoneTaskHistory.new);
+
+/// 进行中任务的开始时刻：卡片每秒重建时用它算耗时，不用把时间塞进 build。
+class PhoneTaskClock extends Notifier<DateTime> {
+  @override
+  DateTime build() {
+    ref.listen(phoneProvider.select((s) => s.status.task.id), (previous, next) {
+      if (next != null) state = DateTime.now();
+    });
+    return DateTime.now();
+  }
+}
+
+final phoneTaskClockProvider = NotifierProvider<PhoneTaskClock, DateTime>(PhoneTaskClock.new);
