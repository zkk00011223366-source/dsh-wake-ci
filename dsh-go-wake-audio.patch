diff --git a/app/lib/phone/virtual_screen_window.dart b/app/lib/phone/virtual_screen_window.dart
new file mode 100644
index 0000000..adcf154
--- /dev/null
+++ b/app/lib/phone/virtual_screen_window.dart
@@ -0,0 +1,144 @@
+import 'dart:async';
+
+import 'package:flutter/services.dart';
+
+import 'phone_channel.dart';
+
+/// 虚拟屏 悬浮窗：把后台那块屏的画面推进原生小窗。
+///
+/// 帧本身由 [PhoneChannel.previewFrames] 提供（原生只在预览开着时推），这里做三件事：
+/// 按设置的帧率节流、只保留最新一帧、把字节交给原生窗口解码显示。窗口是原生的，
+/// 所以画面不经过 Flutter 的渲染树，App 退到后台也不会停。
+class VirtualScreenWindow {
+  VirtualScreenWindow(this._phone);
+
+  static const MethodChannel _native = MethodChannel('dsh/virtual-screen');
+
+  final PhoneChannel _phone;
+  StreamSubscription<PhonePreviewFrame?>? _frames;
+  Timer? _ticker;
+  PhonePreviewFrame? _latest;
+  int _taskId = 0;
+  int _fps = 15;
+  bool _open = false;
+
+  /// 窗口是否已经在屏幕上。
+  bool get isOpen => _open;
+
+  /// 开窗并开始推帧。[fps] 变了调用 [setFps]。
+  Future<bool> open(int taskId, {int fps = 15}) async {
+    // 任务号变了（迁移后）：先关掉旧窗口，避免画面/预览还绑旧任务（09:53 复查）。
+    if (_openedTaskId != null && _openedTaskId != taskId) {
+      await close();
+    }
+    _openedTaskId = taskId;
+    // 已经开着、且这次给的是"当前那块虚拟屏"（0）或同一个任务：保持原窗口不动。
+    if (_open && taskId <= 0) return true;
+    // 已经开着、只是任务号变了（迁移）：只换任务号，不重建窗口（否则画面闪一下）。
+    if (_open && taskId > 0 && taskId != _taskId) {
+      try {
+        await _native.invokeMethod<void>('retask', {'taskId': taskId});
+        _taskId = taskId;
+        return true;
+      } on Object {
+        // 换号失败就走重建。
+      }
+    }
+    await close();
+    _fps = fps.clamp(1, 15);
+    final shown = await _native.invokeMethod<bool>('show', {'taskId': taskId}) ?? false;
+    if (!shown) return false;
+    _open = true;
+    _taskId = taskId;
+    _listen();
+    _startTicker();
+    return true;
+  }
+
+  /// 用系统命令把任务搬到虚拟屏/主屏（`am task move-task`），比引擎 handOver 稳。
+  Future<bool> moveTask(int taskId, {required bool toMain}) async {
+    try {
+      return await _native.invokeMethod<bool>('moveTask', {'taskId': taskId, 'toMain': toMain}) ?? false;
+    } on Object {
+      return false;
+    }
+  }
+
+  Future<void> close() async {
+    _open = false;
+    _taskId = 0;
+    _latest = null;
+    _ticker?.cancel();
+    _ticker = null;
+    await _frames?.cancel();
+    _frames = null;
+    try {
+      await _native.invokeMethod<void>('hide');
+    } on Object {
+      // 窗口可能已经不在了（点了它，回到 App）。
+    }
+  }
+
+  /// 主屏上的吸附式悬浮球（把主屏当前应用转进虚拟屏）。窗口与球互不依赖：球在 App 退到
+  /// 后台、且这块屏上有东西可转的时候出现。
+  /// 最近一次打开时的任务号：迁移后 id 变了要重开，不能沿用旧窗口。
+  int? _openedTaskId;
+
+  Future<bool> setBall(bool on) async {
+    try {
+      return await _native.invokeMethod<bool>('ball', {'on': on}) ?? false;
+    } on Object {
+      return false;
+    }
+  }
+
+  /// 帧率改了：立刻按新节奏推，不用重开窗口。
+  void setFps(int fps) {
+    final next = fps.clamp(1, 15);
+    if (next == _fps) return;
+    _fps = next;
+    if (_open) _startTicker();
+  }
+
+  /// 订阅画面前先让原生开始预览（后台那块屏只在预览开着时才抓帧）。
+  Future<void> _listen() async {
+    await _frames?.cancel();
+    // taskId=0：窗口绑的是"当前那块虚拟屏"（迁移之后还没有任务记录），
+    // 画面走原生直显，不需要逐帧通道。
+    if (_taskId <= 0) {
+      _frames = null;
+      return;
+    }
+    _frames = _phone.previewFrames(_taskId).listen(
+      (frame) {
+        if (!_open) return;
+        if (frame == null || frame.state != 'frame') {
+          _latest = null;
+          return;
+        }
+        _latest = frame;
+      },
+      onError: (Object _) => _latest = null,
+      cancelOnError: false,
+    );
+  }
+
+  void _startTicker() {
+    _ticker?.cancel();
+    // 一帧一次：帧率就是定时器的频率，原生那边只负责解码和显示。
+    final period = Duration(microseconds: (1000000 / _fps).round());
+    _ticker = Timer.periodic(period, (_) => unawaited(_push()));
+  }
+
+  Future<void> _push() async {
+    final frame = _latest;
+    final bytes = frame?.imageBytes;
+    if (bytes == null || bytes.isEmpty) return;
+    _latest = null; // 同一条画面不重复推
+    try {
+      await _native.invokeMethod<bool>('frame', {'bytes': bytes});
+    } on Object {
+      // 一次推帧失败不影响下一帧。
+    }
+  }
+}
