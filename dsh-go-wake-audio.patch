@@ -0,0 +1,29 @@
+package io.github.ccch1mneyyy.dsh_app.wake
+
+import android.content.BroadcastReceiver
+import android.content.Context
+import android.content.Intent
+import android.os.Build
+import android.util.Log
+
+/**
+ * 重启后恢复监听: the setting is remembered natively ([WakePrefs]), so listening can come back
+ * after a reboot without the app being opened first.
+ *
+ * Android 14 (API 34) and later refuse a microphone foreground service started from
+ * BOOT_COMPLETED — the platform does not hand the microphone to a background start, whatever the
+ * app asks. There the flag is left standing and listening comes back the moment the app's Dart
+ * side runs again (which is also what the widget, the launcher and a notification tap do).
+ */
+class WakeBootReceiver : BroadcastReceiver() {
+    override fun onReceive(context: Context, intent: Intent) {
+        val action = intent.action
+        if (action != Intent.ACTION_BOOT_COMPLETED && action != Intent.ACTION_MY_PACKAGE_REPLACED) return
+        if (!WakePrefs.enabled(context)) return
+        if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.UPSIDE_DOWN_CAKE) {
+            Log.i("DshWake", "boot: microphone services cannot start from BOOT_COMPLETED on API 34+; listening resumes with the app")
+            return
+        }
+        WakeWordService.ensure(context, true)
+    }
+}
diff --git a/app/android/app/src/main/kotlin/io/github/ccch1mneyyy/dsh_app/wake/WakeCapture.kt b/app/android/app/src/main/kotlin/io/github/ccch1mneyyy/dsh_app/wake/WakeCapture.kt
new file mode 100644
index 0000000..6f623e8
--- /dev/null
+++ b/app/android/app/src/main/kotlin/io/github/ccch1mneyyy/dsh_app/wake/WakeCapture.kt
@@ -0,0 +1,172 @@
+package io.github.ccch1mneyyy.dsh_app.wake
+
+import android.annotation.SuppressLint
+import android.media.AudioFormat
+import android.media.AudioRecord
+import android.media.MediaRecorder
+import android.media.audiofx.AcousticEchoCanceler
+import android.media.audiofx.NoiseSuppressor
+import android.os.SystemClock
+import io.github.ccch1mneyyy.dsh_app.nativemedia.SpeechGate
+
+/**
+ * 常驻监听的麦克风: 16 kHz mono PCM16 from the noise-suppressed recognition source, cut into
+ * 20 ms frames; only frames inside a burst of speech are handed on, so the recognizer in Dart
+ * wakes for speech and sleeps through a quiet room (the always-on cost is one read loop).
+ *
+ * No echo canceller here: while the app plays anything the call page owns the microphone and
+ * this loop has already given it up ([WakeWordService] is a [MicArbiter] holder).
+ *
+ * [stop] ends the capture before it returns (it waits briefly for the thread), so the
+ * microphone is free for a call right after.
+ */
+class WakeCapture(
+    /** One frame of speech, and the level and floor it was judged against. */
+    private val onFrame: (ShortArray, Double, Double) -> Unit,
+    /** The burst of speech ended: the Dart side resets its recognizer stream. */
+    private val onSpeechEnd: () -> Unit,
+    private val onError: (String) -> Unit,
+) {
+    private var record: AudioRecord? = null
+    private var aec: AcousticEchoCanceler? = null
+    private var ns: NoiseSuppressor? = null
+    private var thread: Thread? = null
+    @Volatile private var running = false
+    private var session = 0
+
+    val active get() = record != null
+
+    @SuppressLint("MissingPermission") // WakeWordService checks RECORD_AUDIO before starting.
+    fun start(): Boolean {
+        stop()
+        val min = AudioRecord.getMinBufferSize(RATE, AudioFormat.CHANNEL_IN_MONO, AudioFormat.ENCODING_PCM_16BIT)
+        if (min <= 0) return false
+        val r = runCatching {
+            AudioRecord(
+                // MIC, unprocessed, which is what Operit's wake listener opens. A keyword
+                // spotter was trained on clean speech: the platform's echo canceller and noise
+                // suppressor (which 语音通话 wants) reshape the signal until the model's test
+                // audio still matches but a phone's own recording does not.
+                MediaRecorder.AudioSource.MIC,
+                RATE,
+                AudioFormat.CHANNEL_IN_MONO,
+                AudioFormat.ENCODING_PCM_16BIT,
+                // 小安语音助手 asks for two seconds here; a small buffer is where a read
+                // underruns and a word disappears between two frames.
+                maxOf(min * 2, RATE * 2),
+            )
+        }.getOrNull() ?: return false
+        if (r.state != AudioRecord.STATE_INITIALIZED) {
+            r.release()
+            return false
+        }
+        val started = runCatching { r.startRecording() }.isSuccess && r.recordingState == AudioRecord.RECORDSTATE_RECORDING
+        if (!started) {
+            releaseEffects()
+            r.release()
+            return false
+        }
+        record = r
+        running = true
+        val mine = ++session
+        thread = Thread({ capture(r, mine) }, "dsh-wake").also { it.start() }
+        return true
+    }
+
+    private fun capture(r: AudioRecord, mine: Int) {
+        val frame = ShortArray(FRAME)
+        var filled = 0
+        var floor = INITIAL_FLOOR_DB
+        var loud = 0
+        var speaking = false
+        var lastLoud = 0L
+        try {
+            while (running) {
+                val n = r.read(frame, filled, frame.size - filled)
+                if (!running) break
+                if (n < 0) {
+                    report(mine) { onError("capture") }
+                    break
+                }
+                filled += n
+                if (filled < frame.size) continue
+                filled = 0
+                val now = SystemClock.elapsedRealtime()
+                val level = SpeechGate.levelOf(frame, frame.size)
+                // 噪声地板 follows a quiet room down at once and up slowly, so a fan or a road
+                // does not keep the gate open and a person still opens it. A frame that is
+                // digital silence (the recorder has not produced audio yet) reads -100 dB and
+                // would drag the floor into the basement; it carries no room, so it is not
+                // allowed to move the floor at all.
+                floor = if (level <= SILENCE_DB) floor else minOf(level.toDouble(), floor + FLOOR_RISE_DB)
+                val hot = level > floor + MARGIN_DB
+                loud = if (hot) loud + 1 else 0
+                if (hot) lastLoud = now
+                if (!speaking && loud >= LOUD_FRAMES) {
+                    speaking = true
+                }
+                // Every frame goes on to the recognizer, not only the ones over the gate: a
+                // stream with the quiet parts cut out is not the audio the model was trained on,
+                // and it answers chopped input with one syllable repeated (咦咦咦 / 呵呵呵).
+                val copy = frame.copyOf()
+                report(mine) { onFrame(copy, level, floor) }
+                // A pause still ends the utterance, so what was said so far is not glued to the
+                // next thing said.
+                if (speaking && now - lastLoud > HANGOVER_MS) {
+                    speaking = false
+                    report(mine) { onSpeechEnd() }
+                }
+            }
+        } catch (_: RuntimeException) {
+            report(mine) { onError("capture") }
+        } finally {
+            frame.fill(0)
+        }
+    }
+
+    private fun report(mine: Int, block: () -> Unit) {
+        if (mine == session && running) block()
+    }
+
+    private fun releaseEffects() {
+        runCatching { aec?.release() }
+        aec = null
+        runCatching { ns?.release() }
+        ns = null
+    }
+
+    /** Ends the capture: the thread leaves its read and the recorder is released. */
+    fun stop(): Boolean {
+        session++
+        running = false
+        val r = record ?: return true
+        record = null
+        runCatching { r.stop() }
+        val t = thread
+        thread = null
+        runCatching { t?.join(JOIN_MS) }
+        val ended = t?.isAlive != true
+        releaseEffects()
+        runCatching { r.release() }
+        return ended
+    }
+
+    private companion object {
+        const val RATE = 16000
+        /** 1024 samples: 小安语音助手 reads in these, 64 ms at a time. */
+        const val FRAME = 1024
+        const val JOIN_MS = 300L
+        /** dB over the learned floor a frame needs before it counts as speech. */
+        const val MARGIN_DB = 9.0
+        /** How fast the floor may rise per frame (2 dB a second at 50 frames a second). */
+        const val FLOOR_RISE_DB = 0.04
+        /** 60 ms of speech before the burst opens (a knock or a click does not). */
+        const val LOUD_FRAMES = 3
+        /** Quiet that closes the burst (小安语音助手's 1500 ms); a word is not cut by a breath. */
+        const val HANGOVER_MS = 1500L
+        /** A quiet room, before the first frames have said how quiet this one actually is. */
+        const val INITIAL_FLOOR_DB = -50.0
+        /** At or under this a frame is digital silence, not a room, and never moves the floor. */
+        const val SILENCE_DB = -90.0
+    }
+}
