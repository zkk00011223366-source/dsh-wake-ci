+  }
+
+  /// 改目标并保证落盘完成（返回 Future）：UI 在切换窗口前先等它，
+  /// 不然引擎可能读到旧值——「关了默认虚拟屏却还走虚拟屏」就是这种竞态。
+  Future<void> setTarget(VirtualScreenTarget target) async {
+    if (target == state.target) return;
+    state = state.copyWith(target: target);
+    await _save(_targetKey, target.name);
+  }
+
+  /// 悬浮屏开关：记住，重开 App 时由 [virtualWindowProvider] 恢复。
+  void setWindow(bool on) {
+    if (on == state.window) return;
+    state = state.copyWith(window: on);
+    unawaited(_save(_windowKey, on));
+  }
+
+  /// 允许手动操作：悬浮窗（原生）直接读这条偏好，不用再过一遍通道。
+  void setManual(bool on) {
+    if (on == state.manual) return;
+    state = state.copyWith(manual: on);
+    unawaited(_save(_manualKey, on));
+  }
+
+  Future<void> _save(String key, Object value) async {
+    try {
+      final prefs = await SharedPreferences.getInstance();
+      if (value is int) await prefs.setInt(key, value);
+      if (value is String) await prefs.setString(key, value);
+      if (value is bool) await prefs.setBool(key, value);
