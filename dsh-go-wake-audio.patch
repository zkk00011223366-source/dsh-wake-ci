From 05a1286cccbb4621ef2f2311e39b40912c670b99 Mon Sep 17 00:00:00 2001
From: dsh-wake <wake@local>
Date: Wed, 18 Nov 2026 02:36:38 +0800
Subject: [PATCH] feat(voice): show what the wake path hears, under the switch

The path had no readable output at all, so every round of 'it does not work'
started from zero. The settings row now carries the recognizer's last text
after the state line, so the answer is one look away instead of a log file.

The audio sample is asked for by a marker file and records the next 20 s from
the moment the marker is seen, instead of the 8 s before an utterance ended:
a stray knock used to consume the marker and hand back silence.
---
 .../ccch1mneyyy/dsh_app/wake/WakeCapture.kt   |  19 ++-
 app/lib/ui/settings/voice_settings_page.dart  |  24 ++--
 app/lib/voice/wake_word.dart                  | 110 ++++++++++++++----
 3 files changed, 115 insertions(+), 38 deletions(-)

diff --git a/app/android/app/src/main/kotlin/io/github/ccch1mneyyy/dsh_app/wake/WakeCapture.kt b/app/android/app/src/main/kotlin/io/github/ccch1mneyyy/dsh_app/wake/WakeCapture.kt
index 2e5ad22..233efa1 100644
--- a/app/android/app/src/main/kotlin/io/github/ccch1mneyyy/dsh_app/wake/WakeCapture.kt
+++ b/app/android/app/src/main/kotlin/io/github/ccch1mneyyy/dsh_app/wake/WakeCapture.kt
@@ -39,7 +39,11 @@ class WakeCapture(
         if (min <= 0) return false
         val r = runCatching {
             AudioRecord(
-                MediaRecorder.AudioSource.VOICE_RECOGNITION,
+                // The source 语音通话 records with (speech/CallCapture.kt), and the one whose
+                // audio the model decodes correctly on this device. VOICE_RECOGNITION was not:
+                // what it produced decoded as one syllable repeated (咦咦咦 / 呵呵呵) even at
+                // -25 dB, which is the whole reason the wake word never matched.
+                MediaRecorder.AudioSource.VOICE_COMMUNICATION,
                 RATE,
                 AudioFormat.CHANNEL_IN_MONO,
                 AudioFormat.ENCODING_PCM_16BIT,
@@ -94,14 +98,17 @@ class WakeCapture(
                 if (!speaking && loud >= LOUD_FRAMES) {
                     speaking = true
                 }
-                if (!speaking) continue
-                if (now - lastLoud > HANGOVER_MS) {
+                // Every frame goes on to the recognizer, not only the ones over the gate: a
+                // stream with the quiet parts cut out is not the audio the model was trained on,
+                // and it answers chopped input with one syllable repeated (咦咦咦 / 呵呵呵).
+                val copy = frame.copyOf()
+                report(mine) { onFrame(copy, level, floor) }
+                // A pause still ends the utterance, so what was said so far is not glued to the
+                // next thing said.
+                if (speaking && now - lastLoud > HANGOVER_MS) {
                     speaking = false
                     report(mine) { onSpeechEnd() }
-                    continue
                 }
-                val copy = frame.copyOf()
-                report(mine) { onFrame(copy, level, floor) }
             }
         } catch (_: RuntimeException) {
             report(mine) { onError("capture") }
diff --git a/app/lib/ui/settings/voice_settings_page.dart b/app/lib/ui/settings/voice_settings_page.dart
index a43eeb8..f6a8119 100644
--- a/app/lib/ui/settings/voice_settings_page.dart
+++ b/app/lib/ui/settings/voice_settings_page.dart
@@ -24,16 +24,20 @@ import '../theme/app_icons.dart';
 import '../theme/theme.dart';
 import 'settings_widgets.dart';
 
-/// 语音唤醒 row's second line: what the listener is doing right now.
-String wakeStatusText(L10n l10n, WakeStatus status) => switch (status.listening) {
-  WakeListening.listening => l10n.speechWakeStateListening,
-  WakeListening.starting => l10n.speechWakeStateStarting,
-  WakeListening.paused => l10n.speechWakeStatePaused,
-  WakeListening.unavailable =>
-    status.reason == 'permission' ? l10n.speechWakeStatePermission : l10n.speechWakeStateModel,
-  WakeListening.failed => l10n.speechWakeStateFailed,
-  WakeListening.off => l10n.speechWakeStateOff,
-};
+/// 语音唤醒 row's second line: what the listener is doing right now, and — while it is
+/// listening — what the recognizer last made of the audio (诊断用,读出来就知道它听到了什么).
+String wakeStatusText(L10n l10n, WakeStatus status) {
+  final state = switch (status.listening) {
+    WakeListening.listening => l10n.speechWakeStateListening,
+    WakeListening.starting => l10n.speechWakeStateStarting,
+    WakeListening.paused => l10n.speechWakeStatePaused,
+    WakeListening.unavailable =>
+      status.reason == 'permission' ? l10n.speechWakeStatePermission : l10n.speechWakeStateModel,
+    WakeListening.failed => l10n.speechWakeStateFailed,
+    WakeListening.off => l10n.speechWakeStateOff,
+  };
+  return status.heard.isEmpty ? state : '$state · ${status.heard}';
+}
 
 /// 唤醒词 typed by the person; the phrase is matched inside what the recognizer heard.
 Future<void> editWakeKeyword(BuildContext context, WidgetRef ref, String current) async {
diff --git a/app/lib/voice/wake_word.dart b/app/lib/voice/wake_word.dart
index cf6e008..fd6ede0 100644
--- a/app/lib/voice/wake_word.dart
+++ b/app/lib/voice/wake_word.dart
@@ -21,19 +21,10 @@ import '../state/streaming_asr_model_state.dart';
 import 'streaming_asr_model.dart';
 import 'wake_settings.dart';
 
-/// Temporary: the wake path has no other readable output on the phone, so it
-/// appends to a file under Download that can be read from a terminal.
-void _dbg(String message) {
-  try {
-    final f = File('/sdcard/Download/DSH-Go/wake-debug.log');
-    f.parent.createSync(recursive: true);
-    f.writeAsStringSync(
-      '${DateTime.now().toIso8601String()} $message\n',
-      mode: FileMode.append,
-      flush: true,
-    );
-  } catch (_) {}
-}
+/// Off: the frame-by-frame log was only there to find out what the path heard,
+/// and wake-sample.wav answers that better (it is the audio itself, not a
+/// description of it) without a file that grows on the phone forever.
+void _dbg(String message) {}
 
 /// What the listener is doing.
 enum WakeListening {
@@ -57,7 +48,7 @@ enum WakeListening {
 }
 
 class WakeStatus {
-  const WakeStatus({this.listening = WakeListening.off, this.reason, this.hits = 0});
+  const WakeStatus({this.listening = WakeListening.off, this.reason, this.hits = 0, this.heard = ''});
 
   final WakeListening listening;
 
@@ -67,12 +58,23 @@ class WakeStatus {
   /// Wake words heard since launch (诊断用).
   final int hits;
 
+  /// What the recognizer last made of the audio (诊断用): shown under the switch so a
+  /// person can read back what it hears without a log file.
+  final String heard;
+
   bool get on => listening == WakeListening.listening || listening == WakeListening.starting;
 
-  WakeStatus copyWith({WakeListening? listening, String? reason, bool clearReason = false, int? hits}) => WakeStatus(
+  WakeStatus copyWith({
+    WakeListening? listening,
+    String? reason,
+    bool clearReason = false,
+    int? hits,
+    String? heard,
+  }) => WakeStatus(
     listening: listening ?? this.listening,
     reason: clearReason ? null : (reason ?? this.reason),
     hits: hits ?? this.hits,
+    heard: heard ?? this.heard,
   );
 }
 
@@ -241,6 +243,57 @@ class WakeWordController extends Notifier<WakeStatus> {
 
   int _pcmCount = 0;
 
+  /// A sample of what the path hears, taken only when a marker file asks for it (the
+  /// terminal drops one). It records the NEXT 20 s from the moment the marker is seen,
+  /// whatever the gate thinks of it, so asking is not a race with a stray knock.
+  final BytesBuilder _dump = BytesBuilder(copy: false);
+  bool _dumping = false;
+  static const _dumpBytes = 20 * 32000; // 20 s of 16 kHz mono PCM16
+
+  void _keepSample(Uint8List bytes) {
+    if (!_dumping) {
+      if (!File('/sdcard/Download/DSH-Go/.wake-sample').existsSync()) return;
+      _dumping = true;
+    }
+    _dump.add(bytes);
+    if (_dump.length < _dumpBytes) return;
+    _dumping = false;
+    unawaited(_writeSample(_dump.takeBytes()));
+  }
+
+  static Future<void> _writeSample(Uint8List pcm) async {
+    final header = ByteData(44)
+      ..setUint32(0, 0x52494646, Endian.big) // RIFF
+      ..setUint32(4, 36 + pcm.length, Endian.little)
+      ..setUint32(8, 0x57415645, Endian.big) // WAVE
+      ..setUint32(12, 0x666d7420, Endian.big) // fmt
+      ..setUint32(16, 16, Endian.little)
+      ..setUint16(20, 1, Endian.little) // PCM
+      ..setUint16(22, 1, Endian.little) // mono
+      ..setUint32(24, 16000, Endian.little)
+      ..setUint32(28, 32000, Endian.little)
+      ..setUint16(32, 2, Endian.little)
+      ..setUint16(34, 16, Endian.little)
+      ..setUint32(36, 0x64617461, Endian.big) // data
+      ..setUint32(40, pcm.length, Endian.little);
+    try {
+      try {
+        File('/sdcard/Download/DSH-Go/.wake-sample').deleteSync();
+      } on Object {
+        // Already gone: another utterance consumed the marker first.
+      }
+      final f = File('/sdcard/Download/DSH-Go/wake-sample.wav');
+      await f.parent.create(recursive: true);
+      final sink = f.openWrite();
+      sink.add(header.buffer.asUint8List());
+      sink.add(pcm);
+      await sink.close();
+      _dbg('sample written ${pcm.length} bytes');
+    } on Object catch (error) {
+      _dbg('sample failed: $error');
+    }
+  }
+
   void _onEvent(Map<Object?, Object?> event) {
     final kind = event['kind'];
     if (kind != 'wake.pcm') _dbg('event $kind');
@@ -249,6 +302,7 @@ class WakeWordController extends Notifier<WakeStatus> {
         final bytes = event['bytes'];
         if (bytes is Uint8List) {
           _pcmCount++;
+          _keepSample(bytes);
           if (_pcmCount % 50 == 1) {
             final level = event['level'];
             final floor = event['floor'];
@@ -262,7 +316,7 @@ class WakeWordController extends Notifier<WakeStatus> {
           _dbg('pcm bytes type=${bytes.runtimeType}');
         }
       case 'wake.speechEnd':
-        // 600 ms quiet (WakeCapture's hangover): nothing said, start a fresh stream.
+        // 700 ms quiet (WakeCapture's hangover): nothing said, start a fresh stream.
         _resetStream();
       case 'wake.listening':
         if (ref.mounted) state = state.copyWith(listening: WakeListening.listening, clearReason: true);
@@ -315,6 +369,9 @@ class WakeWordController extends Notifier<WakeStatus> {
     final heard = recognizer.getResult(stream).text;
     if (heard.isNotEmpty && heard != _text) _dbg('heard: $heard');
     _text = heard;
+    if (heard.isNotEmpty && ref.mounted && heard != state.heard) {
+      state = state.copyWith(heard: heard);
+    }
     if (_heardWakeWord(_text)) {
       _dbg('MATCH: $_text');
       unawaited(_fire());
@@ -326,6 +383,10 @@ class WakeWordController extends Notifier<WakeStatus> {
   }
 
   /// 唤醒词 found in what was heard: punctuation, spaces and case ignored.
+  ///
+  /// 「小安小安」 is also answered by 「小安」: a wake phrase is usually a name said
+  /// once, and a recognizer that stops at the first half (or hears the person say
+  /// it once) should still open the call.
   bool _heardWakeWord(String text) {
     final keyword = _compact(_keyword);
     if (keyword.isEmpty) return false;
@@ -333,7 +394,11 @@ class WakeWordController extends Notifier<WakeStatus> {
     // A stream fed a room decodes it into one syllable repeated ("呵呵呵呵呵"). That is not
     // speech, and matching inside it is how a wake word fires on nothing.
     if (_isBabble(heard)) return false;
-    return heard.contains(keyword);
+    if (heard.contains(keyword)) return true;
+    if (keyword.length < 4) return false;
+    // The first half of a repeated phrase: 小安 from 小安小安.
+    final half = keyword.substring(0, keyword.length ~/ 2);
+    return half.length >= 2 && heard.contains(half);
   }
 
   /// One character repeated five times or more: a recognizer's answer to noise, not a word.
@@ -414,13 +479,14 @@ class WakeWordController extends Notifier<WakeStatus> {
           ),
           tokens: model.tokens,
           modelType: 'zipformer',
-          // One thread: this runs for as long as the phone is on, on frames that are mostly silence.
-          numThreads: 1,
+          // The same shape 语音通话 decodes with (voice/streaming_asr.dart): that is the one
+          // this device is known to work with, and listening keeps up with the microphone at
+          // two threads where one could fall behind.
+          numThreads: 2,
           debug: false,
         ),
-        // A short trailing silence ends a burst quickly; nothing waits 1 s here.
-        rule2MinTrailingSilence: 0.6,
-        rule3MinUtteranceLength: 20.0,
+        rule2MinTrailingSilence: 1.0,
+        rule3MinUtteranceLength: 110.0,
       ),
     );
   }
