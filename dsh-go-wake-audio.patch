+
+        /** Display.DEFAULT_DISPLAY_GROUP（隐藏常量） */
+        private const val DEFAULT_DISPLAY_GROUP = 0
+
+        /**
+         * 要不要替这块屏报：只有它真的自成一组时才报。报到默认组（用户主屏所在的组）会让用户的主屏也一直不灭。
+         * [groupId] 读不到为 null，这时按建屏时带没带 [ownGroupFlag] 算。
+         */
+        fun needed(flags: Int, ownGroupFlag: Int, groupId: Int?): Boolean =
+            flags and ownGroupFlag != 0 && groupId != DEFAULT_DISPLAY_GROUP
+
+        /**
+         * IPowerManager 里按屏报用户操作的那个重载 `userActivity(int displayId, long time, int event, int flags)`
+         * （安卓 12 起）；只有不带屏号的老重载时为 null：它报给默认组，会让用户的主屏不灭，不用。
+         */
+        fun userActivityMethod(cls: Class<*>): Method? = cls.methods.firstOrNull {
+            it.name == "userActivity" && it.parameterTypes.contentEquals(PER_DISPLAY)
+        }
+
+        private val PER_DISPLAY = arrayOf<Class<*>>(
+            Int::class.javaPrimitiveType!!, Long::class.javaPrimitiveType!!,
+            Int::class.javaPrimitiveType!!, Int::class.javaPrimitiveType!!,
+        )
+    }
+}
+
+/**
+ * 全进程一份的续亮：所有屏共用一个定时线程，电源接口拿不到就整体停（只记一次日志）。
+ * 拿不到的场合只是「没人替屏续亮」，屏照常建、照常用。
+ */
+internal object DisplayAwakeKeeper {
+    private const val TAG = "DshDisplay"
+
+    private val threads by lazy {
+        Executors.newSingleThreadScheduledExecutor { r -> Thread(r, "dsh-display-awake").apply { isDaemon = true } }
+    }
+
+    private val awake: DisplayAwake by lazy {
+        DisplayAwake(::pokeDisplay) { runnable ->
+            val future = threads.scheduleWithFixedDelay(runnable, 0, DisplayAwake.PERIOD_MS, TimeUnit.MILLISECONDS)
+            val cancel: () -> Unit = { future.cancel(false) }
+            cancel
+        }
+    }
+
+    /** IPowerManager 和它按屏报用户操作的方法；拿不到为 null（只记一次，屏照常用，只是没人替它续亮）。 */
+    @get:SuppressLint("PrivateApi")
+    private val userActivity: Pair<Any, Method>? by lazy {
+        runCatching {
+            val binder = Class.forName("android.os.ServiceManager")
+                .getMethod("getService", String::class.java).invoke(null, "power") as IBinder
+            val power = Class.forName("android.os.IPowerManager\$Stub")
+                .getMethod("asInterface", IBinder::class.java).invoke(null, binder)!!
+            power to (DisplayAwake.userActivityMethod(power.javaClass) ?: error("no per-display userActivity"))
+        }.onFailure { Log.w(TAG, "vscreen: awake unavailable ${it.message}") }.getOrNull()
+    }
+
+    private fun pokeDisplay(displayId: Int): Boolean {
+        val (power, method) = userActivity ?: return false
+        return try {
+            method.invoke(power, displayId, SystemClock.uptimeMillis(), DisplayAwake.EVENT_TOUCH, 0)
+            true
+        } catch (t: Throwable) {
+            Log.w(TAG, "vscreen: awake failed displayId=$displayId ${t.javaClass.simpleName}")
+            false
+        }
+    }
+
+    /** 这块屏所在的显示组（DisplayInfo.displayGroupId，隐藏字段）；读不到为 null。 */
+    @SuppressLint("PrivateApi")
+    fun displayGroup(displayId: Int): Int? = runCatching {
+        val global = Class.forName("android.hardware.display.DisplayManagerGlobal")
+            .getMethod("getInstance").invoke(null)!!
+        val info = global.javaClass.getMethod("getDisplayInfo", Int::class.javaPrimitiveType)
+            .invoke(global, displayId)!!
+        info.javaClass.getField("displayGroupId").getInt(info)
+    }.getOrNull()
+
+    /**
+     * 建屏之后调：[flags] 是这次建屏真的用的标志，[ownGroupFlag] 是本机 OWN_DISPLAY_GROUP 的值（没有为 0）。
+     * 判据日志：`vscreen: awake decide displayId=… ownGroup=… group=… keepAwake=…`
+     */
+    fun start(displayId: Int, flags: Int, ownGroupFlag: Int) {
+        val group = displayGroup(displayId)
+        val keepAwake = DisplayAwake.needed(flags, ownGroupFlag, group)
+        Log.i(
+            TAG,
+            "vscreen: awake decide displayId=$displayId ownGroup=${flags and ownGroupFlag != 0} " +
+                "group=${group?.toString() ?: "?"} keepAwake=$keepAwake",
+        )
+        if (!keepAwake) return
+        runCatching { awake.start(displayId) }
+            .onFailure { Log.w(TAG, "vscreen: awake start failed ${it.javaClass.simpleName}") }
+    }
+
+    /** 放屏之前调：别再对一个已经没了的屏报用户操作。 */
+    fun stop(displayId: Int) {
+        runCatching { awake.stop(displayId) }
+    }
+}
