+++ b/app/android/app/src/main/kotlin/io/github/ccch1mneyyy/dsh_app/phone/background/DisplayOrientationKeeper.kt
@@ -0,0 +1,125 @@
+package io.github.ccch1mneyyy.dsh_app.phone.background
+
+import android.annotation.SuppressLint
+import android.content.pm.ActivityInfo
+import android.util.Log
+import android.view.Display
+import java.util.concurrent.ConcurrentHashMap
+
+/**
+ * 方向同步的进程级入口（照 Mika 的 ensureOrientationWatch + syncDisplayOrientations）。
+ *
+ * STEAL_TOP_FOCUS_DISABLED 保住主屏焦点，但有的系统因此不再采纳后台 Activity 的转屏请求：
+ * 横屏应用会被缩在竖屏顶部。这里只在有自己的虚拟屏时开一个方向监听，只纠正自己那些屏的方向。
+ * 锁里只拍屏的快照；查任务、读字段、freezeDisplayRotation 和退回的 `wm` 命令都在锁外，
+ * 不挡建屏、放屏和启动。
+ */
+@SuppressLint("PrivateApi")
+internal object DisplayOrientationKeeper {
+    private const val TAG = "DshDisplay"
+    private const val MAX_TASKS = 100
+    private const val CMD_TIMEOUT_S = 10L
+
+    /** 任务请求的方向（onTaskRequestedOrientationChanged）；方向读不到时拿它兜。 */
+    private val requested = ConcurrentHashMap<Int, Int>()
+
+    private val taskManager by lazy {
+        Class.forName("android.app.ActivityTaskManager").getMethod("getService").invoke(null)!!
+    }
+    private val taskInfo by lazy { Class.forName("android.app.TaskInfo") }
+
+    @Volatile private var watch: DisplayOrientationWatch? = null
+
+    /** 建屏之后调：还有屏就开监听（已经开着就复用，多出来的那份关掉）。 */
+    fun ensure() {
+        if (watch != null) return
+        val created = runCatching {
+            DisplayOrientationWatch(
+                taskManager,
+                active = { DisplayHandles.snapshot().isNotEmpty() },
+                onRequestedOrientation = { taskId, orientation -> requested[taskId] = orientation },
+                onTaskRemoved = { taskId -> requested.remove(taskId) },
+                sync = ::sync,
+            )
+        }.onFailure { Log.w(TAG, "vscreen: orientation watcher unavailable ${it.javaClass.simpleName}") }
+            .getOrNull() ?: return
+        val spare = synchronized(this) {
+            if (watch == null) { watch = created; null } else created
+        }
+        spare?.close()
+    }
+
+    /** 放屏之后调：已经没有屏了就关监听，别再让它在后台扫任务。 */
+    fun release() {
+        if (DisplayHandles.snapshot().isNotEmpty()) return
+        val closing = synchronized(this) { watch.also { watch = null } }
+        closing?.close()
+        if (closing != null) requested.clear()
+    }
+
+    /**
+     * 按各屏最上面任务的应用窗口比例纠正屏方向。
+     * 判据：`vscreen: orientation synced to <屏宽>x<屏高> displayId=… rotation=…`
+     */
+    private fun sync() {
+        val ours = DisplayHandles.snapshot()
+        if (ours.isEmpty()) return
+        val displayIdField = taskInfo.getField("displayId")
+        val top = allTasks().groupBy { displayIdField.getInt(it) }
+        for ((id, display) in ours) runCatching {
+            val task = top[id]?.firstOrNull() ?: return@runCatching
+            val taskId = taskInfo.getField("taskId").getInt(task)
+            val compat = runCatching { taskInfo.getField("appCompatTaskInfo").get(task) }.getOrNull() ?: task
+            val cls = compat.javaClass
+            // 安卓 15 起另有明确的 letterbox 标志；14 的宽高只在部分 letterbox 模式下填充。
+            if (!runCatching { cls.getField("topActivityBoundsLetterboxed").getBoolean(compat) }.getOrDefault(true))
+                return@runCatching
+            val appWidth = runCatching { cls.getField("topActivityLetterboxWidth").getInt(compat) }.getOrDefault(0)
+            val appHeight = runCatching { cls.getField("topActivityLetterboxHeight").getInt(compat) }.getOrDefault(0)
+            val mode = display.display.mode
+            val rotation = DisplayOrientation.rotation(
+                mode.physicalWidth, mode.physicalHeight, display.display.rotation, appWidth, appHeight,
+                requested[taskId] ?: ActivityInfo.SCREEN_ORIENTATION_UNSPECIFIED,
+            ) ?: return@runCatching
+            // 快照之后这块屏可能已经放掉了
+            if (DisplayHandles.snapshot()[id] == null) return@runCatching
+            val frozen = runCatching {
+                val wm = Class.forName("android.view.WindowManagerGlobal")
+                    .getMethod("getWindowManagerService").invoke(null)!!
+                val method = wm.javaClass.methods.first { it.name == "freezeDisplayRotation" }
+                if (method.parameterTypes.size == 3) method.invoke(wm, id, rotation, "dsh")
+                else method.invoke(wm, id, rotation)
+            }.isSuccess
+            if (!frozen) sh("wm", "user-rotation", "-d", id.toString(), "lock", rotation.toString())
+            Log.i(
+                TAG,
+                "vscreen: orientation synced to ${mode.physicalWidth}x${mode.physicalHeight} " +
+                    "displayId=$id rotation=$rotation letterbox=${appWidth}x$appHeight",
+            )
+        }.onFailure { Log.w(TAG, "vscreen: orientation sync failed on display $id ${it.javaClass.simpleName}") }
+    }
+
+    /** 全部任务（各屏都算）；读不到就是空表，方向那一条自己会跳过。 */
+    private fun allTasks(): List<Any> {
+        val methods = taskManager.javaClass.methods.filter { it.name == "getTasks" }
+        val withDisplay = methods.firstOrNull { it.parameterTypes.size == 4 }
+        val tasks = if (withDisplay != null) {
+            withDisplay.invoke(taskManager, MAX_TASKS, false, false, Display.INVALID_DISPLAY)
+        } else {
+            methods.first { it.parameterTypes.size == 3 }.invoke(taskManager, MAX_TASKS, false, false)
+        } as List<*>
+        return tasks.filterNotNull()
+    }
+
+    /** 跑一条 shell 命令，返回退出码（超时 -1）。只用于 `wm` 这一条兜底。 */
+    private fun sh(vararg cmd: String): Int {
+        val process = runCatching { ProcessBuilder(*cmd).redirectErrorStream(true).start() }.getOrNull() ?: return -1
+        return runCatching {
+            if (!process.waitFor(CMD_TIMEOUT_S, java.util.concurrent.TimeUnit.SECONDS)) {
+                process.destroyForcibly()
+                return@runCatching -1
+            }
+            process.exitValue()
+        }.getOrDefault(-1)
+    }
+}
