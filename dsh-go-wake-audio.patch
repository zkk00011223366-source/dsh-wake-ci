@@ -0,0 +1,94 @@
+package io.github.ccch1mneyyy.dsh_app.call
+
+import android.app.Notification
+import android.app.NotificationChannel
+import android.app.NotificationManager
+import android.app.PendingIntent
+import android.app.Service
+import android.content.Context
+import android.content.Intent
+import android.content.pm.ServiceInfo
+import android.os.Build
+import android.os.IBinder
+import io.github.ccch1mneyyy.dsh_app.MainActivity
+import io.github.ccch1mneyyy.dsh_app.R
+import io.github.ccch1mneyyy.dsh_app.i18n.AppStrings
+
+/**
+ * 语音通话 while the app is behind: a microphone foreground service with nothing to do but be
+ * in the foreground.
+ *
+ * Android refuses microphone access to a backgrounded app that has no foreground service of
+ * that type, so a call that kept running after the person opened another app would go deaf —
+ * which is why a call used to end on background. With this up, 操作手机 during a call does not
+ * take the microphone away.
+ */
+class CallForegroundService : Service() {
+    override fun onBind(intent: Intent?): IBinder? = null
+
+    override fun onStartCommand(intent: Intent?, flags: Int, startId: Int): Int {
+        ensureChannel(this)
+        try {
+            if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.Q) {
+                startForeground(ID, notification(this), ServiceInfo.FOREGROUND_SERVICE_TYPE_MICROPHONE)
+            } else {
+                startForeground(ID, notification(this))
+            }
+        } catch (_: Exception) {
+            stopSelf()
+            return START_NOT_STICKY
+        }
+        return START_STICKY
+    }
+
+    private fun notification(context: Context): Notification {
+        val open = PendingIntent.getActivity(
+            context,
+            0,
+            Intent(context, MainActivity::class.java).addFlags(Intent.FLAG_ACTIVITY_SINGLE_TOP),
+            PendingIntent.FLAG_UPDATE_CURRENT or PendingIntent.FLAG_IMMUTABLE,
+        )
+        // minSdk is 26, so the channel-taking builder is always there.
+        return Notification.Builder(context, CHANNEL)
+            .setSmallIcon(R.drawable.ic_stat_dsh)
+            .setContentTitle(AppStrings.get(context, R.string.call_running_title))
+            .setContentText(AppStrings.get(context, R.string.call_running_text))
+            .setOngoing(true)
+            .setContentIntent(open)
+            .build()
+    }
+
+    companion object {
+        private const val CHANNEL = "dsh_call"
+        private const val ID = 47
+
+        fun ensure(context: Context, on: Boolean) {
+            val intent = Intent(context, CallForegroundService::class.java)
+            try {
+                if (on) {
+                    if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.O) {
+                        context.startForegroundService(intent)
+                    } else {
+                        context.startService(intent)
+                    }
+                } else {
+                    context.stopService(intent)
+                }
+            } catch (_: Exception) {
+                // A vendor build refused it: the call still runs while the app is in front.
+            }
+        }
+
+        private fun ensureChannel(context: Context) {
+            if (Build.VERSION.SDK_INT < Build.VERSION_CODES.O) return
+            val nm = context.getSystemService(NotificationManager::class.java) ?: return
+            nm.createNotificationChannel(
+                NotificationChannel(
+                    CHANNEL,
+                    AppStrings.get(context, R.string.call_running_channel),
+                    NotificationManager.IMPORTANCE_LOW,
+                ).apply { setShowBadge(false) },
+            )
+        }
+    }
+}
