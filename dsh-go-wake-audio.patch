+        // 第一次就报不了时 giveUp 可能早于登记跑完：补停一次
+        if (unavailable) stopAll()
+    }
+
+    fun stop(displayId: Int) {
+        synchronized(running) { running.remove(displayId) }?.invoke()
+    }
+
+    fun stopAll() {
+        synchronized(running) { running.values.toList().also { running.clear() } }.forEach { it() }
+    }
+
+    private fun giveUp() {
+        unavailable = true
+        stopAll()
+    }
