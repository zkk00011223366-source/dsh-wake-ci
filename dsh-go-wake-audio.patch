new file mode 100644
index 0000000..b30cbf8
--- /dev/null
+++ b/app/lib/speech/call/active_call.dart
@@ -0,0 +1,110 @@
+import 'package:flutter/foundation.dart';
+
+import '../../app_navigator.dart';
+import '../../voice/live_words.dart';
+import 'voice_call.dart';
+
+/// 全局唯一的活跃通话（微信式最小化）。
+///
+/// 通话页只是这通电话的"视图"：
+/// - [attach] 通话页新建控制器后注册（带"点球弹回"的入口 [reopen]）
+/// - [attachView]/[detachView] 通话页被 push/pop 时维护 [viewOpen]
+/// - [_watchEnd] 控制器 ended 时统一收尾（页面死不死都收得到）
+/// - [toggleView] 点悬浮球：通话页开着就 pop（回到推它上来的那层），
+///   收着就 push（回到同一个通话）。带 600ms 冷却防连点把底层页面弹掉。
+///
+/// 重复进入（AI 键/唤醒词/快捷方式）由 openChatCall 检查 [live]：
+/// 有活通话就 toggle 而不是新开（用户选 A：复用当前通话）。
+class ActiveCall extends ChangeNotifier {
+  static ActiveCall? _instance;
+
+  /// 进程内唯一的那个实例；通话页与各入口共用。
+  static ActiveCall get instance => _instance ??= ActiveCall();
+
+  static bool get hasLiveCall => _instance?.live ?? false;
+
+  VoiceCallController? _call;
+  CallConversation? conversation;
+  /// 通话的字幕/识别流：收起时**不释放**（页面 dispose 会把它交给这里保管），
+  /// 弹回时直接复用，避免"收起后音频会话被系统收走、只剩文字"（16:24 反馈）。
+  LiveWords? liveWords;
+  DateTime? since;
+  bool viewOpen = false;
+  DateTime? _lastToggle;
+
+  bool get live => _call != null && _call!.phase != CallPhase.ended;
+
+  VoiceCallController? get call => live ? _call : null;
+
+  /// 通话时长起点（悬浮窗计时用）。
+  DateTime? get startedAt => since;
+  set startedAt(DateTime value) => since = value;
+
+  /// 点悬浮球时把通话页弹回来；openChatCall 首次开页时注册。
+  void Function()? reopen;
+
+  /// 通话结束时的跨界面收尾（清「正在通话」标记、灭球、关 keepAlive、唤醒词拿回麦克风）。
+  /// openChatCall 首次开页时注册（它有 container，能读 provider）。
+  void Function()? onEnded;
+
+  /// 新建通话后注册（通话页创建控制器时调用）。[reopen] 由 openChatCall 先挂好。
+  void attach(VoiceCallController controller, {required DateTime start, CallConversation? conv}) {
+    _call = controller;
+    since = start;
+    conversation = conv;
+    // 新建时通话页正在被 push：视图是开着的。
+    viewOpen = true;
+    // 自己盯结束：收起态下挂断时页面已死，没人能再收尾。
+    controller.addListener(_watchEnd);
+    notifyListeners();
+  }
+
+  void _watchEnd() {
+    final c = _call;
+    if (c == null || c.phase != CallPhase.ended) return;
+    c.removeListener(_watchEnd);
+    // 页面还活着（viewOpen）就由页面 dispose 控制器；页面已死就这里销毁。
+    if (!viewOpen) c.dispose();
+    final onEnded = this.onEnded;
+    _call = null;
+    conversation = null;
+    liveWords = null;
+    since = null;
+    viewOpen = false;
+    reopen = null;
+    this.onEnded = null;
+    notifyListeners();
+    onEnded?.call();
+  }
+
+  /// 通话页被 push（视图回来）。
+  void attachView() {
+    viewOpen = true;
+    notifyListeners();
+  }
+
+  /// 通话页被 pop（收起），通话继续。
+  void detachView() {
+    viewOpen = false;
+    notifyListeners();
+  }
+
+  /// 点悬浮球：开着就收起，收着就弹回。
+  ///
+  /// viewOpen 的权威归通话页（initState 置 true、dispose 置 false）；这里只发起 pop/push。
+  /// 冷却 600ms > 通话页 pop 动画（520ms）：动画走完、页面 dispose 置位之前连点不会把
+  /// 底层页面也 pop 掉。
+  void toggleView() {
+    final now = DateTime.now();
+    if (_lastToggle != null && now.difference(_lastToggle!) < const Duration(milliseconds: 600)) return;
+    _lastToggle = now;
+    if (!live) return;
+    if (viewOpen) {
+      appNavigatorKey.currentState?.pop();
+    } else {
+      final open = reopen;
+      if (open == null) return;
+      open();
+    }
+  }
+}
