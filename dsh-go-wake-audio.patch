+            val b = manager.currentWindowMetrics.bounds
+            SafeArea(b.width(), b.height(), 0, status, 0, nav)
+        } else {
+            val m = res.displayMetrics
+            SafeArea(m.widthPixels, m.heightPixels, 0, status, 0, nav)
