+package io.github.ccch1mneyyy.dsh_app.phone.vscreen
+
+import android.annotation.SuppressLint
+import android.content.Context
+import android.content.Intent
+import android.content.pm.PackageManager
+import android.graphics.Color
+import android.graphics.PixelFormat
+import android.graphics.drawable.GradientDrawable
+import android.os.Build
+import android.os.Handler
+import android.os.Looper
+import android.os.SystemClock
+import android.view.Gravity
+import android.view.MotionEvent
+import android.view.View
+import android.view.WindowManager
+import android.widget.FrameLayout
+import android.widget.TextView
+import io.github.ccch1mneyyy.dsh_app.pet.Dock
+import io.github.ccch1mneyyy.dsh_app.pet.EdgeSnap
+import io.github.ccch1mneyyy.dsh_app.pet.SafeArea
+import io.github.ccch1mneyyy.dsh_app.pet.Side
+import io.github.ccch1mneyyy.dsh_app.pet.WindowPos
+import kotlin.math.abs
+import kotlin.math.roundToInt
+
+/**
+ * 主屏上的「转」: the phone's own app goes to the virtual screen, and the assistant takes over.
+ *
+ * It rests as a 12×56 dp sliver against an edge (`第十二节 3`), so nothing is covered. A tap opens
+ * it into a 40 dp round key; a tap on the key converts. Doing nothing for three seconds, or
+ * touching outside, puts it back — never a drag it did not ask for.
+ *
+ * 只在真的“有可迁移应用”时才出现（第十节 10）：桌面、本 App 自己在前面、或者真拿不到前台应用
+ * 时它不露头。问的是主屏无障碍那份前台包名——读不到（无障碍没连）就照常出现，让那一下点击自己
+ * 报出原因，而不是把功能藏起来。
+ */
+object TransferBall {
+    var onAction: ((String) -> Unit)? = null
+
+    private const val PREFS = "transfer_ball"
+    private const val KEY_SIDE = "side"
+    private const val KEY_FRACTION = "fraction"
+    private const val SLIVER_W = 12f
+    private const val SLIVER_H = 56f
+    private const val BALL = 44f
+
+    /** §14: the ball folds back on its own after this long. */
+    private const val OPEN_MS = 3_000L
+
+    /** How often the ball re-checks that there is still something to hand over. */
+    private const val WATCH_MS = 2_000L
+
+    /** 第十八节: 统一 0.85 常态、按下 1.0，与窗口按键同款。 */
+    private const val REST_ALPHA = 0.85f
+
+    /** ⇄（arrowsLeftRight，0xe011）：单色线框图标，与窗口按键同一套字体。 */
+    private const val ICON_EYE = 0xe02e
+    private const val ICON_SWAP = 0xe011
+
+    private var wm: WindowManager? = null
+    private var root: FrameLayout? = null
+    private var label: TextView? = null
+
+    /** 展开态的两个图标（收成边条时隐藏）。 */
+    private var iconColumn: View? = null
+    /** 主屏操作场景：球里只有【切换】一个键（垂直正中），不是两格。 */
+    private var singleKey = false
+    private var params: WindowManager.LayoutParams? = null
+    private var dock = Dock(side = Side.RIGHT, yFraction = 0.5f)
+    private var open = false
+
+    /** The app asked for the ball; it stays off screen whenever nothing is handable. */
+    private var wanted = false
+
+    /** 由眼睛键触发的显示：不看前台是谁，一律露头。 */
+    @Volatile private var forcedByEye = false
+
+    /** 球现在要不要在场（占屏判断用：球在就说明虚拟屏上还有活要看）。 */
+    val isWanted: Boolean get() = wanted
+    private val main = Handler(Looper.getMainLooper())
+    private val fold = Runnable { setOpen(false) }
+    private val watch = object : Runnable {
+        override fun run() {
+            // 球只跟"任务"绑定，不跟"前台应用"绑定（用户 15:3x 实测：球的显隐会跟着
+            // AI 的悬浮窗一起变，就是因为在读主屏前台包名）。显隐完全由上层按任务算好后
+            // 通过 setWanted 下发，这里只负责把它画出来或收起来。
+            val context = appContext ?: return
+            // 窗口可见时不许挂黄条：验收要求"窗口可见就没有球"。wanted 留住，
+            // 窗口再收起来时它自己回来（否则一次 on=true 会让它一直压在画面上）。
+            if (wanted && root != null && VirtualScreenOverlay.shown &&
+                VirtualScreenOverlay.currentShape() != "SLIVER"
+            ) {
+                hide()
+                main.postDelayed(this, WATCH_MS)
+                return
+            }
+            if (wanted && root == null) {
+                if (!show(context)) {
+                    main.postDelayed(this, WATCH_MS)
+                    return
+                }
+            } else if (!wanted && root != null) {
+                hide()
+            } else if (wanted && root != null && singleKey != mainScene()) {
+                // 场景换了（主屏 ⇄ 后台屏）：球的键数跟着变，尺寸/形状/颜色不变。
+                show(context)
+            }
+            main.postDelayed(this, WATCH_MS)
+        }
+    }
+
+    private var appContext: Context? = null
+
+    val shown: Boolean get() = root != null
+
+    /** 想不想要: the app says yes or no; the ball decides on its own whether right now is a moment. */
+    fun setWanted(on: Boolean, context: Context? = null, forced: Boolean = false) {
+        if (context != null) appContext = context.applicationContext
+        wanted = on
+        // forced：眼睛键把窗口收起来之后，球必须出现——那一刻主屏前台往往就是本 App
+        // 自己，按"前台可迁移"的过滤会被藏掉（用户实测点眼睛后没有球）。
+        forcedByEye = on && forced
+        main.removeCallbacks(watch)
+        if (!on) {
+            hide()
+            return
+        }
+        main.post(watch)
+    }
+
+    fun show(context: Context): Boolean {
+        hide()
+        appContext = context.applicationContext
+        val app = context.applicationContext
+        val manager = app.getSystemService(Context.WINDOW_SERVICE) as? WindowManager ?: return false
+        val saved = app.getSharedPreferences(PREFS, Context.MODE_PRIVATE)
+        dock = Dock(
+            side = if (saved.getString(KEY_SIDE, "r") == "l") Side.LEFT else Side.RIGHT,
+            // 第十节 4：切换球默认右侧、高度 0.62。
+            yFraction = saved.getFloat(KEY_FRACTION, 0.62f),
+        )
+        val px = app.resources.displayMetrics.density
+        val area = area(app, manager)
+        val (w, h) = sizeOf(false, px)
+        val margin = (10 * px).roundToInt()
+        var at = EdgeSnap.position(dock, w, h, area, margin)
+        // 与虚拟屏小窗同侧时自动错开，谁后出现谁让位（第十节 4）。
+        val window = VirtualScreenOverlay.currentRect()
+        if (window != null) {
+            val y = OverlaySpacing.apart(dock.side, at.x, at.y, w, h, area, margin,
+                VirtualScreenOverlay.currentSide(), window)
+            at = WindowPos(at.x, y)
+        }
+
+        // 合并球：竖排两个图标（上=眼睛 回虚拟屏，下=⇄ 转进虚拟屏），黄底。
+        val holder = FrameLayout(app).apply {
+            background = GradientDrawable().apply {
+                cornerRadius = 22 * px
+                setColor(0xF2FFC53D.toInt())
+            }
+        }
+        val icon = { glyph: Int ->
+            TextView(app).apply {
+                text = String(Character.toChars(glyph))
+                gravity = Gravity.CENTER
+                setTextColor(0xE6303444.toInt())
+                setTextSize(android.util.TypedValue.COMPLEX_UNIT_SP, 15f)
+                runCatching { typeface = android.graphics.Typeface.createFromAsset(app.assets, "flutter_assets/assets/fonts/DshIcons.ttf") }
+            }
+        }
+        val eyeIcon = icon(ICON_EYE)
+        val swapIcon = icon(ICON_SWAP)
+        // 主屏操作场景（窗口不可见、虚拟屏里也没有在跑的任务）：球里只留【切换】一个键，
+        // 让它占满整个球高 → 图标落在垂直正中。球的尺寸/圆角/颜色一行都不改，
+        // 不是"把上面那个键抹掉留空格"（用户要求）。虚拟屏/后台屏仍是上眼睛、下切换。
+        val single = mainScene()
+        singleKey = single
+        // 判据（一行判单/双键）：主屏 = ball1（只有切换），后台屏 = ball2（眼睛+切换）。
+        io.github.ccch1mneyyy.dsh_app.wake.WakeTrace.log(
+            "ball: shape=${if (single) "ball1" else "ball2"} window=${VirtualScreenOverlay.shown}")
+        val col = android.widget.LinearLayout(app).apply { orientation = android.widget.LinearLayout.VERTICAL }
+        if (single) {
+            col.addView(swapIcon, android.widget.LinearLayout.LayoutParams(-1, -1))
+        } else {
+            col.addView(eyeIcon, android.widget.LinearLayout.LayoutParams(-1, 0, 1f))
+            col.addView(swapIcon, android.widget.LinearLayout.LayoutParams(-1, 0, 1f))
+        }
+        holder.addView(col, FrameLayout.LayoutParams(-1, -1))
+        iconColumn = col
+        val lp = WindowManager.LayoutParams(
+            w,
+            h,
+            overlayType(),
+            WindowManager.LayoutParams.FLAG_NOT_FOCUSABLE or
+                WindowManager.LayoutParams.FLAG_LAYOUT_NO_LIMITS or
+                WindowManager.LayoutParams.FLAG_LAYOUT_IN_SCREEN or
+                // 第十四节 4: 点球外也收回去，和等 3 秒一样。
+                WindowManager.LayoutParams.FLAG_WATCH_OUTSIDE_TOUCH,
+            PixelFormat.TRANSLUCENT,
+        ).apply {
+            gravity = Gravity.TOP or Gravity.START
+            x = at.x
+            y = at.y
+        }
+        attachTouch(app, holder, manager, lp, area, px)
+        return try {
+            manager.addView(holder, lp)
+            wm = manager
+            root = holder
+            label = null
+            params = lp
+            open = false
+            true
+        } catch (_: Exception) {
+            root = null
+            label = null
+            params = null
+            wm = null
+            false
+        }
+    }
+
+    /** 此刻贴着哪一侧；给虚拟屏小窗错位用。 */
+    fun currentSide(): Side? = if (root != null) dock.side else null
+
+    /**
+     * 主屏操作场景（与 PhoneRegistry.ballAction 里 state=="main" 同一套判据）：
+     * 窗口不可见，且虚拟屏里没有在跑的任务。这时球里只留【切换】一个键。
+     * 后台屏（任务还在虚拟屏里跑）和虚拟屏场景仍然是上眼睛、下切换。
+     */
+    private fun mainScene(): Boolean {
+        val sliver = VirtualScreenOverlay.currentShape() == "SLIVER"
+        val windowShown = VirtualScreenOverlay.shown && !sliver
+        // 用"虚拟屏里真有任务"这条账：预览登记在任务被切换键搬回主屏后还挂着，
+        // 只看它会一直画双键（经验包之外的实测：设主屏给了双键条）。
+        // 唯一判定点：主屏态才单键（其余双键/不挂条由 VscreenUi 决定）
+        return VscreenUi.decide(windowShown, why = "ball") == VscreenUi.BALL1
+    }
+
+    /** 球此刻的矩形；给虚拟屏小窗错位用。 */
+    fun currentRect(): android.graphics.Rect? {
+        val view = root ?: return null
+        val lp = params ?: return null
+        return android.graphics.Rect(lp.x, lp.y, lp.x + view.width, lp.y + view.height)
+    }
+
+    fun hide() {
+        main.removeCallbacks(fold)
+        val view = root ?: return
+        root = null
+        label = null
+        params = null
+        open = false
+        val manager = wm
+        wm = null
+        try {
+            manager?.removeView(view)
+        } catch (_: Exception) {
+        }
+    }
+
+    private fun sizeOf(expanded: Boolean, px: Float): Pair<Int, Int> =
+        // 合并球：竖排两个键，所以展开态是 44×84dp 的胶囊（不是正方形）。
+        if (expanded) (44 * px).roundToInt() to (84 * px).roundToInt()
+        else (SLIVER_W * px).roundToInt() to (SLIVER_H * px).roundToInt()
+
+    private fun setOpen(expanded: Boolean) {
+        // 只有展开态显示两个图标；收成边条时只剩黄色条。
+        iconColumn?.visibility = if (expanded) View.VISIBLE else View.GONE
+        val view = root ?: return
+        val manager = wm ?: return
+        val lp = params ?: return
+        if (open == expanded) return
+        open = expanded
+        main.removeCallbacks(fold)
+        val px = view.context.resources.displayMetrics.density
+        val area = area(view.context, manager)
+        val (w, h) = sizeOf(expanded, px)
+        val at = EdgeSnap.position(dock, w, h, area, (10 * px).roundToInt())
+        lp.width = w
+        lp.height = h
+        lp.x = at.x
+        lp.y = at.y
+        view.background = if (expanded) ballBackground(px) else sliverBackground(px)
+        // 第十节 10：半透明，不挡内容；手指按住时变实，免得按错方向。
+        view.alpha = REST_ALPHA
+        label?.visibility = if (expanded) View.VISIBLE else View.GONE
+        try {
+            manager.updateViewLayout(view, lp)
+        } catch (_: Exception) {
+        }
+        if (expanded) main.postDelayed(fold, OPEN_MS)
+    }
+
+    @SuppressLint("ClickableViewAccessibility")
+    private fun attachTouch(
+        context: Context,
+        view: View,
+        manager: WindowManager,
+        lp: WindowManager.LayoutParams,
+        area: SafeArea,
+        px: Float,
+    ) {
+        val margin = (10 * px).roundToInt()
+        var startX = 0f
+        var startY = 0f
+        var fromX = 0
+        var fromY = 0
+        var lastX = 0f
+        var lastAt = 0L
+        var vx = 0f
+        var dragging = false
+        var downAt = 0L
+        var downY = 0f
+
+        view.setOnTouchListener { _, event ->
+            when (event.actionMasked) {
+                MotionEvent.ACTION_DOWN -> {
+                    downY = event.rawY
+                    startX = event.rawX
+                    startY = event.rawY
+                    fromX = lp.x
+                    fromY = lp.y
+                    lastX = event.rawX
+                    lastAt = SystemClock.elapsedRealtime()
+                    downAt = lastAt
+                    vx = 0f
+                    dragging = false
+                    // 按住就实：40% 只是歇着时的样子。
+                    view.alpha = 1f
+                    true
+                }
+                MotionEvent.ACTION_MOVE -> {
+                    val dx = event.rawX - startX
+                    val dy = event.rawY - startY
+                    if (!dragging && (abs(dx) > 6 * px || abs(dy) > 6 * px)) dragging = true
+                    if (dragging) {
+                        val now = SystemClock.elapsedRealtime()
+                        if (now > lastAt) vx = (event.rawX - lastX) * 1000f / (now - lastAt)
+                        lastX = event.rawX
+                        lastAt = now
+                        // A ball dragged up and down may leave the edge: it stays where it is.
+                        lp.x = (fromX + dx).roundToInt().coerceIn(
+                            EdgeSnap.minX(area, margin),
+                            EdgeSnap.maxX(area, lp.width, margin),
+                        )
+                        lp.y = (fromY + dy).roundToInt().coerceIn(
+                            EdgeSnap.minY(area, margin),
+                            EdgeSnap.maxY(area, lp.height, margin),
+                        )
+                        try {
+                            manager.updateViewLayout(view, lp)
+                        } catch (_: Exception) {
+                        }
+                    }
+                    true
+                }
+                MotionEvent.ACTION_OUTSIDE -> {
+                    setOpen(false)
+                    true
+                }
+                MotionEvent.ACTION_UP, MotionEvent.ACTION_CANCEL -> {
+                    if (dragging) {
+                        dock = EdgeSnap.dockFor(lp.x, lp.y, lp.width, lp.height, area, margin, vx)
+                        context.getSharedPreferences(PREFS, Context.MODE_PRIVATE).edit()
+                            .putString(KEY_SIDE, if (dock.side == Side.LEFT) "l" else "r")
+                            .putFloat(KEY_FRACTION, dock.yFraction)
+                            .apply()
+                        setOpen(false)
+                        return@setOnTouchListener true
+                    }
+                    if (SystemClock.elapsedRealtime() - downAt > 400) return@setOnTouchListener true
+                    if (open) {
+                        // 以球自身中心为界：上半=眼睛，下半=切换。
+                        // 眼睛 = 虚拟屏 ⇄ 后台屏（永不碰主屏）；切换 = 主屏 ⇄ 虚拟屏（永不进后台屏）。
+                        // 具体怎么走由原生按当前状态决定（PhoneRegistry.ballAction）。
+                        // 主屏态只有一个键（切换）居中：整颗球都算切换。
+                        val centerY = lp.y + lp.height / 2f
+                        val half = if (singleKey) "swap" else if (downY < centerY) "eye" else "swap"
+                        // 原生优先：Dart 那条通道在 App 于后台时没人接，点了会静默丢掉（问题#3）。
+                        val native = io.github.ccch1mneyyy.dsh_app.phone.PhoneRegistry
+                            .ballAction?.invoke(half) == true
+                        io.github.ccch1mneyyy.dsh_app.wake.WakeTrace.log(
+                            "ball: tap=$half native=$native")
+                        if (!native) onAction?.invoke(half)
+                        setOpen(false)
+                    } else {
+                        setOpen(true)
+                    }
+                    true
+                }
+                else -> false
+            }
+        }
+    }
+
+    @Suppress("DEPRECATION")
+    private fun overlayType(): Int =
+        if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.O) WindowManager.LayoutParams.TYPE_APPLICATION_OVERLAY
+        else WindowManager.LayoutParams.TYPE_PHONE
+
+    private fun area(context: Context, manager: WindowManager): SafeArea =
+        if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.R) {
+            val b = manager.currentWindowMetrics.bounds
+            SafeArea(b.width(), b.height(), 0, 0, 0, 0)
+        } else {
+            val m = context.resources.displayMetrics
+            SafeArea(m.widthPixels, m.heightPixels, 0, 0, 0, 0)
+        }
+
+    private fun sliverBackground(px: Float) = GradientDrawable().apply {
+        cornerRadius = 6 * px
+        // 吸边长条跟球同色（黄色），之前还是深灰（00:02）。
+        setColor(0xE6FFC53D.toInt())
+    }
+
+    /** 第十八节: 半透明深色圆 + 细描边，没有彩色。 */
+    private fun ballBackground(px: Float) = GradientDrawable().apply {
+        shape = GradientDrawable.OVAL
+        // 主屏上的"转进虚拟屏"球：黄色（用户 22:24），黑底太不显眼。
+        setColor(0xF2FFC53D.toInt())
+        setStroke((1.5f * px).roundToInt(), 0x66FFFFFF)
+    }
+}
+
+/**
+ * 两块浮层（虚拟屏小窗、切换球）贴在同一侧时的竖直避让：后出现的一块让开，
+ * 保证互不重叠、也不压住对方（第十节 4）。
+ */
+internal object OverlaySpacing {
+    fun apart(
+        side: Side,
+        x: Int,
+        y: Int,
+        w: Int,
+        h: Int,
+        area: SafeArea,
+        margin: Int,
+        otherSide: Side?,
+        other: android.graphics.Rect?,
+    ): Int {
+        if (other == null || otherSide != side) return y
+        val self = android.graphics.Rect(x, y, x + w, y + h)
+        if (!android.graphics.Rect.intersects(self, other)) return y
+        val below = other.bottom + margin
+        if (below + h <= area.screenH - margin) return below
+        val above = other.top - h - margin
+        return if (above >= margin) above else y
+    }
+}
