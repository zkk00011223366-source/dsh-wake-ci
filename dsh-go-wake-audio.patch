+            // 位置钉在左上角（applyShape 里处理）。
+            val w = area.screenW - area.left - area.right - margin * 2
+            val h = area.screenH - area.top - area.bottom - margin * 2
+            return w.coerceAtLeast(1) to h.coerceAtLeast(1)
+        }
+        // 不再乘持久化 zoom：残留缩放会把小窗压成残废条（12:0x）。
+        val z = 1f
+        if (shape == Shape.SLIVER) {
+            return (SLIVER_W * px).roundToInt() to (SLIVER_H * px).roundToInt()
+        }
+        val target = if (shape == Shape.SMALL) SMALL_W else EXPAND_W
+        val a = aspect()
+        var w = target * z
+        var h = w * a
+        // 太扁/太长都改从宽推：保持比例，只换基准边。
+        val minH = if (shape == Shape.SMALL) 96f else 160f
+        // 展开态的高度上限 = 屏幕可用高度（之前写死 400dp，而竖屏比例下 1.0× 就已经顶到
+        // 400dp，于是 ＋ 再按也没变化 —— 用户看到的就是「放大缩小没反应」）。
+        val maxH = if (shape == Shape.SMALL) 300f else (area.screenH - margin * 2) / px
+        if (h < minH) {
+            h = minH
+            w = h / a
+        } else if (h > maxH) {
+            h = maxH
+            w = h / a
+        }
+        // 不超出屏幕（留出贴边距离）。
+        val maxW = area.screenW - margin * 2
+        val maxHPx = area.screenH - margin * 2
+        if (w * px > maxW) {
+            w = maxW / px
+            h = w * a
+        }
+        if (h * px > maxHPx) {
+            h = maxHPx / px
+            w = h / a
+        }
+        // 底部再多给约 1mm：浮点换算 + 圆角裁剪会让最底下一条被吃掉（22:12 反馈）。
+        val extra = (1.2f * px).roundToInt()
+        return (w * px).roundToInt().coerceAtLeast(1) to
+            ((h * px).roundToInt() + extra).coerceAtLeast(1)
+    }
+
+    /** 展开态的最低倍率是 1.0：再小底部那排键放不下（4×44 + 3×8 = 200dp）。 */
+    private fun effectiveZoom(shape: Shape): Float =
+        if (shape == Shape.EXPAND) maxOf(zoom, EXPAND_MIN_ZOOM) else zoom
+
+    private fun applyShape(
+        next: Shape,
+        manager: WindowManager,
+        lp: WindowManager.LayoutParams,
+        view: View,
+        area: SafeArea,
+        px: Float,
+    ) {
+        if (next != Shape.EXPAND) fullscreen = false
+        shape = next
+        val (w, h) = windowSize(next, px, area)
+        WakeTrace.log("window: shape=$next size=${w}x$h live=$liveSurface")
+        main.postDelayed({
+            val b = root
+            WakeTrace.log(
+                "window: size-check box=${b?.width}x${b?.height} " +
+                    "content=${content?.width}x${content?.height} lp=${params?.width}x${params?.height}")
+            // 窗口尺寸定了再算适配：画面完整放进窗口。
+            applyFitTransform()
+        }, 120)
+        val margin = (10 * px).roundToInt()
+        // 窗口 = 画面：高度不再给把手留空间（把手是独立窗口）。
+        // 全屏不按贴边位置摆：钉在安全区左上角。
+        val at = if (next == Shape.EXPAND && fullscreen) {
+            WindowPos(EdgeSnap.minX(area, margin), EdgeSnap.minY(area, margin))
+        } else {
+            EdgeSnap.position(dock, w, h, area, margin)
+        }
+        lp.width = w
+        lp.height = h
+        lp.x = at.x
+        // 与主屏的切换球同侧时自动错开（第十节 4）。
+        val ball = TransferBall.currentRect()
+        lp.y = if (ball == null) at.y else OverlaySpacing.apart(
+            dock.side, at.x, at.y, w, h, area, margin, TransferBall.currentSide(), ball,
+        )
+        try {
+            manager.updateViewLayout(view, lp)
+        } catch (_: Exception) {
+        }
+        // 窗口尺寸变了要重贴一次固定 surface 尺寸：不然全屏回中窗时 SurfaceView 的
+        // 图层几何还停在旧尺寸上，画面只显示一半（用户 15:21 实测）。
+        main.postDelayed({ fixSurfaceSize() }, 60)
+        // 全屏/退出全屏：把虚拟屏 resize 到窗口尺寸，画面才不会被裁或缩小（18:4x）。
+        runCatching {
+            val dm = view.context.resources.displayMetrics
+            // 只有"已经知道虚拟屏真实尺寸"时才允许 resize。displayW/H 还是 0（窗口刚打开、
+            // attach 回包没到）时，以前会算成 1×1 并发下去——虚拟屏被缩成 1 像素，屏里的应用
+            // 配置被毁、自己跳回主屏（23:14 腾讯视频"起不来、停在启动页"就是这个）。
+            val known = displayW > 0 && displayH > 0
+            val targetW = if (next == Shape.EXPAND && fullscreen) w else displayW
+            val targetH = if (next == Shape.EXPAND && fullscreen) h else displayH
+            if (known && targetW > 0 && targetH > 0 && (targetW != displayW || targetH != displayH)) {
+                val ok = io.github.ccch1mneyyy.dsh_app.phone.background.BackgroundControl.get(view.context)
+                    .resizeDisplay(targetW, targetH, dm.densityDpi)
+                if (ok) {
+                    displayW = targetW; displayH = targetH
+                    WakeTrace.log("window: display resized to ${targetW}x$targetH fullscreen=$fullscreen")
+                }
+            }
+        }
+        // 位置定了再摆把手：它与主窗底边对齐，全屏态不显示（用户 19:20）。
+        syncGripWindow(view.context, manager, lp.x, lp.y, w, h, next == Shape.EXPAND && !fullscreen)
+        // 非 SLIVER 时 box 完全透明（画面自己带圆角），窗口边缘就是画面边缘。
+        // 球只在"窗口不可见"时出现（文档 §五 显示条件）：细条也算收起 → 立刻出球；
+        // 小窗/中窗/全屏可见时窗口里已经有眼睛和切换键，重复没意义 → 收球。
+        val ballCtx = context
+        if (ballCtx != null) {
+            if (next == Shape.SLIVER) TransferBall.setWanted(true, ballCtx, forced = true)
+            else TransferBall.setWanted(false)
+        }
+        view.background = if (next == Shape.SLIVER) sliverBackground(px) else null
+        // INVISIBLE, not GONE: a GONE SurfaceView destroys its surface, and the display would
+        // have to be re-attached every time the window parks.
+        content?.visibility = if (next == Shape.SLIVER) View.INVISIBLE else View.VISIBLE
+        // 小窗只有画面：一颗键都不放（用户 16:40 要求）。点一下变大，键才出来。
+        backKey?.visibility = if (next == Shape.EXPAND) View.VISIBLE else View.GONE
+        // 底部一排（⇄ 切主屏 / ⛶ 全屏与回中窗）：展开和全屏都有；小窗、竖条没有（用户 19:25）。
+        bottomRight?.visibility = if (next == Shape.EXPAND) View.VISIBLE else View.GONE
+        volumeKey?.visibility = if (next == Shape.EXPAND) View.VISIBLE else View.GONE
+        eyeKey?.visibility = if (next == Shape.EXPAND) View.VISIBLE else View.GONE
+        closeKey?.visibility = if (next == Shape.EXPAND) View.VISIBLE else View.GONE
+        fullscreenKey?.visibility = if (next == Shape.EXPAND) View.VISIBLE else View.GONE
+        transferKey?.visibility = if (next == Shape.EXPAND) View.VISIBLE else View.GONE
+        // 有大画面了就不再挂提示：它是“还没开始”的说明，盖在应用上面既不礼貌也看不清。
+        hint?.visibility = if (next == Shape.EXPAND && !hasPicture()) View.VISIBLE else View.GONE
+
+        if (volumeRow != null && next != Shape.EXPAND) volumeRow?.visibility = View.GONE
+        applyValidity()
+        applyLive()
+    }
+
+    /**
+     * 缩放改的是**整个窗口**（第二十四节 3）：−/＋ 按倍率档改窗口尺寸（保持宽高比），画面始终
+     * 铺满窗口，不做内部裁剪。窗口左上角不动，出界时拉回。
+     */
+    private fun applyZoomStep(manager: WindowManager, view: View, area: SafeArea, px: Float) {
+        val (w, h) = windowSize(shape, px, area)
+        // 用窗口自己当前的 LayoutParams：show() 里那份 `params` 在窗口被系统重建后可能已经
+        // 不是同一个对象，拿旧的去 updateViewLayout 会静默失败（点 ＋/− 没反应就是这个）。
+        val lp = (view.layoutParams as? WindowManager.LayoutParams) ?: params ?: return
+        val margin = (10 * px).roundToInt()
+        lp.width = w
+        lp.height = h
+        lp.x = lp.x.coerceIn(EdgeSnap.minX(area, margin), EdgeSnap.maxX(area, w, margin))
+        lp.y = lp.y.coerceIn(EdgeSnap.minY(area, margin), EdgeSnap.maxY(area, h, margin))
+        try {
+            manager.updateViewLayout(view, lp)
+        } catch (e: Exception) {
+            WakeTrace.log("window: zoom apply failed ${e.javaClass.simpleName}: ${e.message}")
+        }
+        WakeTrace.log("window: zoom=${zoom} size=${w}x$h at=${lp.x},${lp.y}")
+        syncGripWindow(view.context, manager, lp.x, lp.y, w, h, shape == Shape.EXPAND && !fullscreen)
+        applyValidity()
+        applyLive()
+    }
+
+    /** 画面尺寸刚知道（直显 attach 或第一帧预览）：窗口立刻按真实比例重排。 */
+    private fun rememberAspect(app: Context) {
+        if (displayWidth <= 0 || displayHeight <= 0) return
+        val a = displayHeight.toFloat() / displayWidth.toFloat()
+        if (abs(a - savedAspect) < 0.001f) return
+        savedAspect = a
+        app.getSharedPreferences(PREFS, Context.MODE_PRIVATE).edit().putFloat(KEY_ASPECT, a).apply()
+    }
+
+    private var gripWin: View? = null
+    private var gripParams: WindowManager.LayoutParams? = null
+
+    /**
+     * 展开态的拖拽条：**独立的第二个窗口**，贴在主窗底边外面。
+     * 结构重构（20:30）：把手不再画在主窗里，主窗尺寸就等于画面，永远不压内容。
+     * 拖它 → 拖动主窗。
+     */
+    private fun syncGripWindow(
+        app: Context, manager: WindowManager,
+        x: Int, y: Int, w: Int, h: Int, show: Boolean,
+    ) {
+        val px = app.resources.displayMetrics.density
+        val gw = (56 * px).roundToInt()
+        val gh = gripHeight(px)
+        val gap = (3 * px).roundToInt()
+        if (!show) {
+            gripWin?.let { runCatching { manager.removeView(it) } }
+            gripWin = null
+            gripParams = null
+            return
+        }
+        val view = gripWin ?: View(app).apply {
+            background = GradientDrawable().apply {
+                cornerRadius = gh / 2f
+                // 拖拽条也用红色，和吸边竖条一致（用户 22:30）。
+                setColor(0xCCEF5350.toInt())
+            }
+            val touch = object : View.OnTouchListener {
+                var startX = 0f
+                var startY = 0f
+                var fromX = 0
+                var fromY = 0
+                override fun onTouch(v: View, e: MotionEvent): Boolean {
+                    val lp = params ?: return false
+                    when (e.actionMasked) {
+                        MotionEvent.ACTION_DOWN -> {
+                            startX = e.rawX
+                            startY = e.rawY
+                            fromX = lp.x
+                            fromY = lp.y
+                            v.alpha = 1f
+                        }
+                        MotionEvent.ACTION_MOVE -> {
+                            val box = root ?: return true
+                            // 横向也要能拖（22:07 反馈：之前只改了 y）。
+                            lp.x = (fromX + (e.rawX - startX)).toInt()
+                            lp.y = (fromY + (e.rawY - startY)).toInt()
+                            runCatching { manager.updateViewLayout(box, lp) }
+                            syncGripWindow(app, manager, lp.x, lp.y, lp.width, lp.height, true)
+                        }
+                        MotionEvent.ACTION_UP, MotionEvent.ACTION_CANCEL -> {
+                            v.alpha = 0.85f
+                            parkFromWindow()
+                        }
+                    }
+                    return true
+                }
+            }
+            setOnTouchListener(touch)
+        }
+        gripWin = view
+        val lp = gripParams ?: WindowManager.LayoutParams(
+            gw, gh, overlayType(),
+            WindowManager.LayoutParams.FLAG_NOT_FOCUSABLE or
+                WindowManager.LayoutParams.FLAG_LAYOUT_NO_LIMITS or
+                WindowManager.LayoutParams.FLAG_LAYOUT_IN_SCREEN,
+            PixelFormat.TRANSLUCENT,
+        ).apply { gravity = Gravity.TOP or Gravity.START }
+        lp.x = x + (w - gw) / 2
+        lp.y = y + h + gap
+        lp.width = gw
+        lp.height = gh
+        try {
+            if (gripParams == null) manager.addView(view, lp) else manager.updateViewLayout(view, lp)
+        } catch (_: Exception) {
+        }
+        gripParams = lp
+    }
+
+    /** 松手后按主窗当前位置吸边（把手拖动结束时调用）。 */
+    private fun parkFromWindow() {
+        val app = context ?: return
+        val manager = wm ?: return
+        val box = root ?: return
+        val lp = (box.layoutParams as? WindowManager.LayoutParams) ?: params ?: return
+        val px = app.resources.displayMetrics.density
+        val area = area(app, manager)
+        // 按松手位置算贴哪边、纵向比例（不依赖 PetFrames 的 FramePx）。
+        val margin = (10 * px).roundToInt()
+        val cx = lp.x + lp.width / 2
+        val side = if (cx < area.screenW / 2) Side.LEFT else Side.RIGHT
+        val lo = EdgeSnap.minY(area, margin)
+        val hi = EdgeSnap.maxY(area, lp.height, margin)
+        val fraction = if (hi > lo) ((lp.y - lo).toFloat() / (hi - lo)).coerceIn(0f, 1f) else dock.yFraction
+        dock = Dock(side, fraction)
+        // 只保留拖动：松手后窗口按松手位置贴边摆好，**不再吸成 12×56 细条**。
+        // 以前这里在靠近左右边缘时切到 Shape.SLIVER，用户要求彻底停用（绘制代码留着不调用）。
+        applyShape(shape, manager, lp, box, area, px)
+        val sp = app.getSharedPreferences(PREFS, Context.MODE_PRIVATE).edit()
+        sp.putString(KEY_SIDE, if (dock.side == Side.LEFT) "l" else "r").putFloat(KEY_FRACTION, dock.yFraction).apply()
+    }
+
+    private fun applyAspect() {
+        context?.let { rememberAspect(it) }
+        val box = root ?: return
+        val manager = wm ?: return
+        val app = context ?: return
+        val px = app.resources.displayMetrics.density
+        applyZoomStep(manager, box, area(app, manager), px)
+    }
+
+    /** 到位置灰（第十二节 2）：没有前台应用时「返」「转」不可用，与缩放键到边界时同一套表现。 */
+    private fun applyValidity() {
+        backKey?.alpha = if (hasApp) KEY_ALPHA else KEY_ALPHA_DIM
+        transferKey?.let { key ->
+            // 只在展开态显示；没有应用时置灰而不是消失（用户 15:15：按钮有时有有时没有）。
+            key.visibility = if (shape == Shape.EXPAND) View.VISIBLE else View.GONE
+            key.alpha = if (hasApp) KEY_ALPHA else KEY_ALPHA_DIM
+        }
+        fullscreenKey?.alpha = if (fullscreen) 1f else KEY_ALPHA
+    }
+
+    /** 此刻贴着哪一侧；给切换球错位用。 */
+    fun currentSide(): Side? = if (root != null) dock.side else null
+
+    /** 窗口此刻在屏幕上的矩形；给切换球错位用。 */
+    fun currentRect(): android.graphics.Rect? {
+        val box = root ?: return null
+        val lp = params ?: return null
+        return android.graphics.Rect(lp.x, lp.y, lp.x + box.width, lp.y + box.height)
+    }
+
+    /** 全屏/还原：铺满安全区，再点回展开尺寸。 */
+    private fun toggleFullscreen() {
+        val box = root ?: return
+        val manager = wm ?: return
+        val app = context ?: return
+        val lp = (box.layoutParams as? WindowManager.LayoutParams) ?: params ?: return
+        val px = app.resources.displayMetrics.density
+        fullscreen = !fullscreen
+        val a = area(app, manager)
+        if (fullscreen) {
+            // 全屏：直接铺满安全区，不再经过 windowSize 的分支判断
+            // （23:59 实测：窗口仍是展开尺寸，说明那条分支没被执行）。
+            val margin = (10 * px).roundToInt()
+            val availW = a.screenW - a.left - a.right - margin * 2
+            val availH = a.screenH - a.top - a.bottom - margin * 2
+            // 全屏 = 在安全区里按内容比例放到最大（不裁内容，也不变形）。
+            val ar = if (displayHeight > 0) displayHeight.toFloat() / displayWidth.toFloat() else screenAspect()
+            val w: Int
+            val hgt: Int
+            if (availW.toFloat() / availH <= 1f / ar) {
+                w = availW
+                hgt = (availW * ar).toInt()
+            } else {
+                hgt = availH
+                w = (availH / ar).toInt()
+            }
+            lp.width = w
+            lp.height = hgt
+            lp.x = EdgeSnap.minX(a, margin)
+            lp.y = EdgeSnap.minY(a, margin)
+            shape = Shape.EXPAND
+            try { manager.updateViewLayout(box, lp) } catch (_: Exception) {}
+            content?.layoutParams = (content?.layoutParams as? FrameLayout.LayoutParams ?: FrameLayout.LayoutParams(-1, -1)).also {
+                it.width = w
+                it.height = hgt
+            }
+            content?.requestLayout()
+            syncGripWindow(app, manager, lp.x, lp.y, w, hgt, false)
+            // 需求八：全屏要真铺满——把虚拟屏本身 resize 成窗口尺寸，而不是只放大窗口。
+            if (restoreW <= 0 && displayW > 0) { restoreW = displayW; restoreH = displayH }
+            worker.execute {
+                val ok = runCatching {
+                    io.github.ccch1mneyyy.dsh_app.phone.background.BackgroundControl.get(app)
+                        .resizeDisplay(w, hgt, app.resources.displayMetrics.densityDpi)
+                }.getOrDefault(false)
+                WakeTrace.log("window: display resized to ${w}x$hgt fullscreen=true ok=$ok")
+                if (ok) main.post { displayW = w; displayH = hgt }
+            }
+            WakeTrace.log("window: fullscreen size=${w}x$hgt at=${lp.x},${lp.y}")
+            main.postDelayed({ applyFitTransform() }, 120)
+            return
+        }
+        // 退出全屏：先把虚拟屏还原成进全屏前的尺寸，窗口再回展开尺寸
+        WakeTrace.log("window: fullscreen=false")
+        if (restoreW > 0) {
+            val rw = restoreW; val rh = restoreH
+            // 先还原尺寸再 applyShape：否则 aspect() 还按全屏尺寸算，窗口会变成一条窄条（真机实测）。
+            displayW = rw; displayH = rh
+            worker.execute {
+                val ok = runCatching {
+                    io.github.ccch1mneyyy.dsh_app.phone.background.BackgroundControl.get(app)
+                        .resizeDisplay(rw, rh, app.resources.displayMetrics.densityDpi)
+                }.getOrDefault(false)
+                WakeTrace.log("window: display resized to ${rw}x$rh fullscreen=false ok=$ok")
+                if (ok) main.post { displayW = rw; displayH = rh }
+            }
+            restoreW = 0; restoreH = 0
+        }
+        applyShape(Shape.EXPAND, manager, lp, box, a, px)
+    }
+
+    private fun stepZoom(direction: Int) {
+        val index = ZOOMS.indexOfFirst { it >= zoom - 0.001f }.let { if (it < 0) ZOOMS.size - 1 else it }
+        val next = (index + direction).coerceIn(0, ZOOMS.size - 1)
+        if (ZOOMS[next] == zoom) return
+        zoom = ZOOMS[next]
+        val box = root ?: return
+        val manager = wm ?: return
+        val app = context ?: return
+        val px = app.resources.displayMetrics.density
+        applyZoomStep(manager, box, area(app, manager), px)
+        app.getSharedPreferences(PREFS, Context.MODE_PRIVATE).edit().putFloat(KEY_ZOOM, zoom).apply()
+    }
+
+    private fun resetZoom() {
+        if (abs(zoom - 1.0f) < 0.001f) return
+        zoom = 1.0f
+        val box = root ?: return
+        val manager = wm ?: return
+        val app = context ?: return
+        val px = app.resources.displayMetrics.density
+        applyZoomStep(manager, box, area(app, manager), px)
+        app.getSharedPreferences(PREFS, Context.MODE_PRIVATE).edit().putFloat(KEY_ZOOM, zoom).apply()
+    }
