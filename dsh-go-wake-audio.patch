@@ -0,0 +1,31 @@
+package io.github.ccch1mneyyy.dsh_app.phone.background
+
+import android.hardware.display.VirtualDisplay
+
+/**
+ * displayId → VirtualDisplay 的强引用表（照 Mika 的 `displays[id] = vd`）。
+ *
+ * 句柄只被 core 的字段拿着时，"字段被清掉"就等于**丢屏**：系统里那块屏还在（合成、耗电、
+ * 占着屏号），我们却再也放不掉它，下一次建屏还会撞上它。所以建好就一直按住，放屏时才摘。
+ */
+internal object DisplayHandles {
+    private val handles = HashMap<Int, VirtualDisplay>()
+
+    /** 建屏成功后按住句柄，返回屏号。 */
+    fun put(display: VirtualDisplay): Int {
+        val id = display.display.displayId
+        synchronized(handles) { handles[id] = display }
+        return id
+    }
+
+    /** 取回并摘掉：core 的字段被清过（换屏、回滚）也还能把这块屏放掉。 */
+    fun take(displayId: Int): VirtualDisplay? = synchronized(handles) { handles.remove(displayId) }
+
+    /** 只摘掉：句柄已经放掉了，表里那份不该再留着。 */
+    fun forget(displayId: Int) {
+        synchronized(handles) { handles.remove(displayId) }
+    }
+
+    /** 现在按住的所有屏（副本）：方向同步按它逐块纠正。 */
+    fun snapshot(): Map<Int, VirtualDisplay> = synchronized(handles) { handles.toMap() }
+}
