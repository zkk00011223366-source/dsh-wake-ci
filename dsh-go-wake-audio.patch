@@ -0,0 +1,69 @@
+package io.github.ccch1mneyyy.dsh_app.phone.vscreen
+
+import android.app.Presentation
+import android.content.Context
+import android.graphics.Color
+import android.graphics.drawable.GradientDrawable
+import android.os.Bundle
+import android.view.Display
+import android.view.Gravity
+import android.view.View
+import android.view.ViewGroup
+import android.widget.FrameLayout
+
+/**
+ * 虚拟屏显示层：把整块虚拟屏交给系统画（与 Mika / Operit 同路）。
+ *
+ * 旧做法是 TextureView + 自己算窗口/内容尺寸，窗口一变画面就"漏出来"（只有中窗显示全）。
+ * Presentation 由系统按窗口大小绘制整块 display：小窗/中窗/全屏天然一致，不需要我们算比例。
+ *
+ * 用法：
+ *   val host = PresentationHost(context, virtualDisplay) { contentView -> … }
+ *   host.show(viewGroup)   // 挂到悬浮窗容器上
+ *   host.dismiss()         // 卸载
+ */
+class PresentationHost(
+    private val context: Context,
+    private val display: Display,
+    private val onContent: (FrameLayout) -> Unit = {},
+) {
+    private var presentation: Presentation? = null
+
+    /** 圆角容器：系统画的内容放进这里，四角由容器裁剪。 */
+    private fun contentShell(radiusPx: Float): FrameLayout = FrameLayout(context).apply {
+        clipChildren = true
+        clipToOutline = true
+        outlineProvider = object : android.view.ViewOutlineProvider() {
+            override fun getOutline(view: View, outline: android.graphics.Outline) {
+                outline.setRoundRect(0, 0, view.width, view.height, radiusPx)
+            }
+        }
+        setBackgroundColor(Color.rgb(8, 10, 18))
+    }
+
+    /** 在 [display] 上显示整块虚拟屏。[radiusPx] 与悬浮窗圆角保持一致。 */
+    fun show(parent: ViewGroup, radiusPx: Float) {
+        dismiss()
+        val shell = contentShell(radiusPx)
+        val p = Presentation(context, display).apply {
+            setContentView(shell, ViewGroup.LayoutParams(-1, -1))
+            window?.setBackgroundDrawable(GradientDrawable().apply { setColor(Color.TRANSPARENT) })
+            window?.setGravity(Gravity.TOP or Gravity.START)
+        }
+        presentation = p
+        onContent(shell)
+        parent.addView(shell, FrameLayout.LayoutParams(-1, -1))
+        runCatching { p.show() }
+    }
+
+    /** 卸载（窗口关闭/切后台时调用）。 */
+    fun dismiss() {
+        runCatching { presentation?.dismiss() }
+        presentation = null
+    }
+
+    fun isShowing(): Boolean = presentation?.isShowing == true
+
+    /** Presentation 的窗口回调（需要时扩展）。 */
+    fun onCreate(bundle: Bundle?) = Unit
+}
