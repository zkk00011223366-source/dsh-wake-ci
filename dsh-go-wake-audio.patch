+    /** 把 SurfaceView 的 surface 固定成虚拟屏真实尺寸，让系统缩放而不是 1:1 裁。 */
+    private fun fixSurfaceSize() {
+        val w = displayW
+        val h = displayH
+        if (w <= 0 || h <= 0) return
