+  /// 唤醒词 as a keyword spotter, built the first time a frame arrives.
+  sherpa.KeywordSpotter? _spotter;
+  sherpa.OnlineStream? _kwsStream;
+  String _kwsKeyword = '';
+  bool _kwsPreparing = false;
+  int _pending = 0;
+  int _streamSamples = 0;
+  int _quietSamples = 0;
+  double _lastLevel = 0;
+
+  /// 小安语音助手's numbers on this phone: 5x into the model, one decode per 200 ms.
+  static const _gain = 5.0;
+  static const _decodeEvery = 3200;
+
+  /// A sample of what the path hears, taken only when a marker file asks for it (the
+  /// terminal drops one). It records the NEXT 20 s from the moment the marker is seen,
+  /// whatever the gate thinks of it, so asking is not a race with a stray knock.
+  final BytesBuilder _dump = BytesBuilder(copy: false);
+  bool _dumping = false;
+  static const _dumpBytes = 20 * 32000; // 20 s of 16 kHz mono PCM16
+
+  void _keepSample(Uint8List bytes) {
+    if (!_dumping) {
+      if (!File('/sdcard/Download/DSH-Go/.wake-sample').existsSync()) return;
+      _dumping = true;
+    }
+    _dump.add(bytes);
+    if (_dump.length < _dumpBytes) return;
+    _dumping = false;
+    unawaited(_writeSample(_dump.takeBytes()));
+  }
+
+  static Future<void> _writeSample(Uint8List pcm) async {
+    final header = ByteData(44)
+      ..setUint32(0, 0x52494646, Endian.big) // RIFF
+      ..setUint32(4, 36 + pcm.length, Endian.little)
+      ..setUint32(8, 0x57415645, Endian.big) // WAVE
+      ..setUint32(12, 0x666d7420, Endian.big) // fmt
+      ..setUint32(16, 16, Endian.little)
+      ..setUint16(20, 1, Endian.little) // PCM
+      ..setUint16(22, 1, Endian.little) // mono
+      ..setUint32(24, 16000, Endian.little)
+      ..setUint32(28, 32000, Endian.little)
+      ..setUint16(32, 2, Endian.little)
+      ..setUint16(34, 16, Endian.little)
+      ..setUint32(36, 0x64617461, Endian.big) // data
+      ..setUint32(40, pcm.length, Endian.little);
+    try {
+      try {
+        File('/sdcard/Download/DSH-Go/.wake-sample').deleteSync();
+      } on Object {
+        // Already gone: another utterance consumed the marker first.
+      }
+      final f = File('/sdcard/Download/DSH-Go/wake-sample.wav');
+      await f.parent.create(recursive: true);
+      final sink = f.openWrite();
+      sink.add(header.buffer.asUint8List());
+      sink.add(pcm);
+      await sink.close();
+      _dbg('sample written ${pcm.length} bytes');
+    } on Object catch (error) {
+      _dbg('sample failed: $error');
+    }
+  }
+
+  void _onEvent(Map<Object?, Object?> event) {
+    final kind = event['kind'];
+    if (kind != 'wake.pcm') _dbg('event $kind');
+    switch (kind) {
+      case 'wake.pcm':
+        final bytes = event['bytes'];
+        if (bytes is Uint8List) {
+          _pcmCount++;
+          _keepSample(bytes);
+          final level = event['level'];
+          if (level is num) _lastLevel = level.toDouble();
+          if (_pcmCount % 50 == 1) {
+            final floor = event['floor'];
+            _dbg(
+              'pcm #$_pcmCount bytes=${bytes.length}'
+              '${level is num && floor is num ? ' level=${level.toStringAsFixed(1)} floor=${floor.toStringAsFixed(1)}' : ''}',
+            );
+          }
+          _feed(bytes);
+        } else {
+          _dbg('pcm bytes type=${bytes.runtimeType}');
+        }
+      case 'wake.speechEnd':
+        // A pause is not the end of the stream: 小安语音助手 keeps listening on the same one
+        // and only drops it after 5 s of quiet, which is what keeps a slow 小安 from being
+        // cut in half between the two halves of the phrase. The reset now happens in _feed.
+        break;
+      case 'wake.listening':
+        if (ref.mounted) state = state.copyWith(listening: WakeListening.listening, clearReason: true);
+      case 'wake.yield':
+        // 麦克风让位: dictation or a call took it; it comes back with that page.
+        _resetStream();
+        if (ref.mounted) state = state.copyWith(listening: WakeListening.paused, clearReason: true);
+      case 'wake.stopped':
+        if (ref.mounted && state.listening == WakeListening.listening) {
+          state = state.copyWith(listening: WakeListening.paused, clearReason: true);
+        }
+      case 'wake.disabled':
+        // 通知上的「关闭」= 设置里的开关关掉.
+        unawaited(ref.read(wakeSettingsProvider.notifier).edit((saved) => saved.copyWith(enabled: false)));
+        if (ref.mounted) state = state.copyWith(listening: WakeListening.off, clearReason: true);
+      case 'wake.error':
+        if (ref.mounted) {
+          state = state.copyWith(
+            listening: WakeListening.failed,
+            reason: event['reason'] is String ? event['reason'] as String : 'service',
+          );
+        }
+    }
+  }
+
+  /// What is being said, as raw 16 kHz mono PCM16, from the first frame over the floor to
+  /// 1.2 s after the last one.
+  final BytesBuilder _utterance = BytesBuilder(copy: false);
+  bool _inSpeech = false;
+
+  /// A whole utterance goes to the engine's recognizer (SenseVoice, the one 语音输入 uses)
+  /// instead of being decoded by a streaming model that cannot leave its own loop. 小安语音助手
+  /// does the same: record, recognize once, match. There is no stream state to get stuck in.
+  void _feed(Uint8List bytes) {
+    if (!ref.read(wakeSettingsProvider).enabled || _suspended) return;
+    _preroll.add(bytes);
+    _prerollBytes += bytes.length;
+    while (_prerollBytes > _prerollLimit && _preroll.isNotEmpty) {
+      _prerollBytes -= _preroll.removeAt(0).length;
+    }
+    if (_keyword != _kwsKeyword) unawaited(_prepareSpotter());
+    final spotter = _spotter;
+    final stream = _kwsStream;
+    // Both arms hear every frame again. The spotter is the fast one; the utterance arm is
+    // kept because it is the only one that has ever woken this phone (the spotter loads but
+    // has never matched), and it is held to a strict rule below so a conversation that
+    // merely mentions 小安小安 no longer opens a call.
+    if (spotter != null && stream != null) _feedSpotter(spotter, stream, bytes);
+    // 能量门槛可调：嘈杂环境调低更灵敏（设置 › 语音 › 语音唤醒）。
+    if (_lastLevel > ref.read(wakeSettingsProvider).energyDb) {
+      _inSpeech = true;
+      _quietSamples = 0;
+      _utterance.add(bytes);
+      // 噪声环境里门槛调低会把环境声当人声，音频无限增长 → 服务端报
+      // "Audio is invalid or exceeds the configured byte limit"（11:5x）。上限 8 秒。
+      if (_utterance.length > 16 * 2 * 8000) _closeUtterance();
+      return;
+    }
+    if (!_inSpeech) return;
+    _utterance.add(bytes);
+    _quietSamples += bytes.length;
+    if (_quietSamples < 19200) return; // 1.2 s of quiet ends what was said
+    _closeUtterance();
+  }
+
+  /// 收口一段话：太短当敲击丢掉，否则送去识别。
+  void _closeUtterance() {
+    final pcm = _utterance.takeBytes();
+    _inSpeech = false;
+    _quietSamples = 0;
+    if (pcm.length < 16000) return; // under half a second is a knock, not a word
+    unawaited(_recognize(pcm));
+  }
+
+  /// Feeds one frame to the keyword spotter. 手机自带的唤醒 goes exactly this way: a model
+  /// that only knows the phrase, with a threshold, never a general recognizer's text.
+  void _feedSpotter(sherpa.KeywordSpotter spotter, sherpa.OnlineStream stream, Uint8List bytes) {
+    try {
+      final samples = Float32List(bytes.length ~/ 2);
+      final data = ByteData.sublistView(bytes);
+      for (var i = 0; i < samples.length; i++) {
+        samples[i] = data.getInt16(i * 2, Endian.little) / 32768.0;
+      }
+      stream.acceptWaveform(samples: samples, sampleRate: 16000);
+      while (spotter.isReady(stream)) {
+        spotter.decode(stream);
+      }
+      final hit = spotter.getResult(stream).keyword;
+      if (hit.isEmpty) return;
+      _dbg('MATCH(kws): $hit');
+      if (ref.mounted) state = state.copyWith(heard: hit);
+      spotter.reset(stream);
+      unawaited(_fire());
+    } on Object catch (error) {
+      _dbg('kws feed failed: $error');
+      _spotter = null;
+      _kwsStream = null;
+    }
+  }
+
+  Future<void> _prepareSpotter() async {
+    if (_kwsPreparing) return;
+    final keyword = _keyword;
+    if (keyword.isEmpty || keyword == _kwsKeyword) return;
+    final line = wakeKeywordLine(keyword);
+    if (line == null) {
+      // Not a phrase pinyin can spell (letters, digits): the utterance arm answers instead.
+      _dbg('kws: "$keyword" cannot be written as pinyin');
+      return;
+    }
+    // Once per keyword: a failure here is remembered, not retried on every frame.
+    _kwsKeyword = keyword;
+    _kwsPreparing = true;
+    try {
+      final dir = await _kwsDirectory();
+      if (dir == null) return;
+      sherpa.initBindings();
+      final bytes = utf8.encode(line).length;
+      sherpa.KeywordSpotter build(String modelType) => sherpa.KeywordSpotter(
+        sherpa.KeywordSpotterConfig(
+          model: sherpa.OnlineModelConfig(
+            transducer: sherpa.OnlineTransducerModelConfig(
+              encoder: '$dir/encoder.int8.onnx',
+              decoder: '$dir/decoder.int8.onnx',
+              joiner: '$dir/joiner.int8.onnx',
+            ),
+            tokens: '$dir/tokens.txt',
+            modelType: modelType,
+            numThreads: 1,
+            debug: false,
+          ),
+          keywordsBuf: line,
+          keywordsBufSize: bytes,
+          // 手机里的唤醒 first tries: the stock thresholds answer only a deliberate,
+          // close-range phrase. A lower trigger and a stronger keyword bias make 小安 land
+          // on the first try without matching ordinary speech (the model still has to see
+          // the whole phrase).
+          keywordsScore: 1.5,
+          keywordsThreshold: 0.15,
+        ),
+      );
+      sherpa.KeywordSpotter? spotter;
+      // Empty first: the offline run that does detect 小安小安 (and the model's own test
+      // audio) passes no model_type at all, and a wrong-but-accepted one loads silently and
+      // never matches. zipformer2 stays as the second try.
+      for (final type in ['', 'zipformer2']) {
+        try {
+          spotter = build(type);
+          break;
+        } on Object catch (error) {
+          _dbg('kws model type "$type" refused: $error');
+        }
+      }
+      if (spotter == null) return;
+      _spotter?.free();
+      _kwsStream = spotter.createStream();
+      _spotter = spotter;
+      _dbg('kws ready: $line');
+    } on Object catch (error) {
+      _dbg('kws failed: $error');
+    } finally {
+      _kwsPreparing = false;
+    }
+  }
+
+  /// The spotter's model, copied out of assets once (sherpa reads paths, not bytes).
+  Future<String?> _kwsDirectory() async {
+    try {
+      final dir = Directory('${(await getApplicationSupportDirectory()).path}/kws');
+      final marker = File('${dir.path}/encoder.int8.onnx');
+      if (!marker.existsSync() || marker.lengthSync() < 1000000) {
+        await dir.create(recursive: true);
+        for (final name in ['encoder.int8.onnx', 'decoder.int8.onnx', 'joiner.int8.onnx', 'tokens.txt']) {
+          final data = await rootBundle.load('assets/kws/$name');
+          await File('${dir.path}/$name').writeAsBytes(
+            data.buffer.asUint8List(data.offsetInBytes, data.lengthInBytes),
+            flush: true,
+          );
+        }
+      }
+      return dir.path;
+    } on Object catch (error) {
+      _dbg('kws assets failed: $error');
+      return null;
+    }
+  }
+
+  Uint8List _takePreRoll() {
+    final out = BytesBuilder(copy: false);
+    for (final frame in _preroll) {
+      out.add(frame);
+    }
+    _preroll.clear();
+    _prerollBytes = 0;
+    return out.takeBytes();
+  }
+
+  /// What was said around 唤醒词, from the pre-roll; null when the engine is unreachable or
+  /// has nothing to say (the keyword alone is then the message).
+  Future<String?> _transcribePreRoll(Uint8List pcm) async {
+    try {
+      if (pcm.length < 16000) return null;
+      final client = ref.read(activeConnectionProvider).value?.client;
+      if (client == null) return null;
+      final transcript = await client.transcribe(_wav(pcm)).timeout(const Duration(seconds: 3));
+      final text = transcript.text.trim();
+      return text.isEmpty ? null : text;
+    } on Object {
+      return null;
+    }
+  }
+
+  /// The pre-roll text of the wake that just happened, waiting at most [wait]. Reading it
+  /// clears it: one wake, one message.
+  Future<String?> takeWakeUtterance({Duration wait = const Duration(milliseconds: 1500)}) async {
+    final pending = _wakeUtterance;
+    _wakeUtterance = null;
+    if (pending == null) return null;
+    try {
+      return await pending.timeout(wait);
+    } on Object {
+      return null;
+    }
+  }
+
+  Future<void> _recognize(Uint8List pcm) async {
+    try {
+      final client = ref.read(activeConnectionProvider).value?.client;
+      if (client == null) {
+        _dbg('recognize: no host connection');
+        return;
+      }
+      final transcript = await client.transcribe(_wav(pcm));
+      final text = transcript.text.trim();
+      if (text.isEmpty) return;
+      _dbg('heard: $text');
+      if (ref.mounted && text != state.heard) state = state.copyWith(heard: text);
+      if (_utteranceMatches(text)) {
+        _dbg('MATCH: $text');
+        unawaited(_fire());
+      }
+    } on Object catch (error) {
+      _dbg('recognize failed: $error');
+    }
+  }
+
+  static Uint8List _wav(Uint8List pcm) {
+    final header = ByteData(44)
+      ..setUint32(0, 0x52494646, Endian.big) // RIFF
+      ..setUint32(4, 36 + pcm.length, Endian.little)
+      ..setUint32(8, 0x57415645, Endian.big) // WAVE
+      ..setUint32(12, 0x666d7420, Endian.big) // fmt
+      ..setUint32(16, 16, Endian.little)
+      ..setUint16(20, 1, Endian.little) // PCM
+      ..setUint16(22, 1, Endian.little) // mono
+      ..setUint32(24, 16000, Endian.little)
+      ..setUint32(28, 32000, Endian.little)
+      ..setUint16(32, 2, Endian.little)
+      ..setUint16(34, 16, Endian.little)
+      ..setUint32(36, 0x64617461, Endian.big) // data
+      ..setUint32(40, pcm.length, Endian.little);
+    final out = BytesBuilder(copy: false)
+      ..add(header.buffer.asUint8List())
+      ..add(pcm);
+    return out.takeBytes();
+  }
+
+  /// 唤醒词 at the start of what was said, which is how a person calls the assistant.
+  ///
+  /// 整段识别 cannot tell "小安小安" from a sentence that happens to mention it, and it only
+  /// answers once the utterance ends — so it is held to: the whole utterance is the phrase,
+  /// it begins with the phrase, or it is short and contains it (a 「嗯」 in front, nothing more).
+  bool _utteranceMatches(String text) {
+    final keyword = _compact(_keyword);
+    if (keyword.isEmpty) return false;
+    final heard = _compact(text);
+    if (heard.isEmpty) return false;
+    if (heard == keyword || heard.startsWith(keyword)) return true;
+    return heard.length <= keyword.length + 4 && heard.contains(keyword);
+  }
+
+  static final _noise = RegExp(r'[^0-9A-Za-z\u4e00-\u9fff]+');
+
+  /// 纯标点 / 「嗯啊哦」 never matches a keyword that has a letter or a han character in it.
+  static String _compact(String text) => text.replaceAll(_noise, '').toLowerCase();
+
+  Future<void> _fire() async {
+    final now = DateTime.now();
+    final until = _cooldownUntil;
+    if (until != null && now.isBefore(until)) {
+      _dbg('fire: cooling down');
+      return;
+    }
+    _dbg('fire: start');
+    _cooldownUntil = now.add(_cooldown);
+    final settings = ref.read(wakeSettingsProvider);
+    if (settings.chime) unawaited(SystemSound.play(SystemSoundType.alert));
+    if (settings.vibrate) unawaited(HapticFeedback.heavyImpact());
+    _resetStream();
+    final preroll = _takePreRoll();
+    _wakeUtterance = _transcribePreRoll(preroll);
+    if (ref.mounted) state = state.copyWith(listening: WakeListening.paused, hits: state.hits + 1, clearReason: true);
+    // 麦克风让位 before the call page opens: two AudioRecords on the same microphone make the
+    // call hear a room and the assistant answer over itself. A wake always opens the call now,
+    // and when it cannot, the fallback below starts listening again.
+    await _stopService();
+    try {
+      await ref.read(wakePlatformProvider).present();
+      _dbg('fire: presented');
+    } on Object {
+      // The activity could not be brought forward (or there is no such channel): the caller's
+      // screen is unchanged, and the call still opens in the app when it comes back.
+    }
+    // 没有接上通话（屏幕上没有会话）: listening comes back on its own.
+    _resumeTimer?.cancel();
+    _resumeTimer = Timer(_callGrace, () => unawaited(resume()));
+  }
+
+  /// The recognizer for the stream of the 实时字幕 model, built on the first frame.
+  sherpa.OnlineRecognizer? _ensureRecognizer() {
+    final existing = _recognizer;
+    if (existing != null) return existing;
+    final model = ref.read(streamingAsrModelProvider).model;
+    if (model == null) return null;
+    try {
+      _recognizer = _create(model);
+      _stream = _recognizer!.createStream();
+      _streamStarted = DateTime.now();
+      return _recognizer;
+    } on Object catch (error) {
+      if (ref.mounted) {
+        state = state.copyWith(listening: WakeListening.failed, reason: 'model: $error');
+      }
+      return null;
+    }
+  }
+
+  static sherpa.OnlineRecognizer _create(StreamingAsrModel model) {
+    for (final path in [model.encoder, model.decoder, model.joiner, model.tokens]) {
+      final stat = File(path).statSync();
+      if (stat.type != FileSystemEntityType.file || stat.size == 0) {
+        throw FileSystemException('wake: model file is missing or empty', path);
+      }
+    }
+    sherpa.initBindings();
+    return sherpa.OnlineRecognizer(
+      sherpa.OnlineRecognizerConfig(
+        model: sherpa.OnlineModelConfig(
+          transducer: sherpa.OnlineTransducerModelConfig(
+            encoder: model.encoder,
+            decoder: model.decoder,
+            joiner: model.joiner,
+          ),
+          tokens: model.tokens,
+          modelType: 'zipformer',
+          // The same shape 语音通话 decodes with (voice/streaming_asr.dart): that is the one
+          // this device is known to work with, and listening keeps up with the microphone at
+          // two threads where one could fall behind.
+          numThreads: 2,
+          debug: false,
+        ),
+        rule2MinTrailingSilence: 1.0,
+        rule3MinUtteranceLength: 110.0,
+      ),
+    );
+  }
+
+  void _resetStream() {
+    _text = '';
+    _pending = 0;
+    _streamSamples = 0;
+    _quietSamples = 0;
+    _streamStarted = null;
+    final recognizer = _recognizer;
+    final stream = _stream;
+    if (recognizer == null || stream == null) return;
+    try {
+      recognizer.reset(stream);
+      _streamStarted = DateTime.now();
+    } on Object {
+      _release();
+    }
+  }
+
+  void _release() {
+    final stream = _stream;
+    final recognizer = _recognizer;
+    _stream = null;
+    _recognizer = null;
+    _streamStarted = null;
+    try {
+      stream?.free();
+    } on Object {
+      // Already freed.
+    }
+    try {
+      recognizer?.free();
+    } on Object {
+      // Already freed.
+    }
+  }
+}
