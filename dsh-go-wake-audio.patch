+++ b/app/android/app/src/main/kotlin/io/github/ccch1mneyyy/dsh_app/phone/vscreen/SwitchPromptOverlay.kt
@@ -0,0 +1,142 @@
+package io.github.ccch1mneyyy.dsh_app.phone.vscreen
+
+import android.annotation.SuppressLint
+import android.content.Context
+import android.graphics.Color
+import android.graphics.PixelFormat
+import android.graphics.drawable.GradientDrawable
+import android.os.Handler
+import android.os.Looper
+import android.view.Gravity
+import android.view.View
+import android.view.WindowManager
+import android.widget.FrameLayout
+import android.widget.LinearLayout
+import android.widget.TextView
+import io.github.ccch1mneyyy.dsh_app.wake.WakeTrace
+import kotlin.math.roundToInt
+
+/**
+ * 切换前台时的提示胶囊（11:4x）：
+ *
+ *   「检测到你切到前台」  [我来操作]  [AI 继续]   10
+ *
+ * · 不抢焦点，不挡画面中心；点完立刻消失并回一条提示
+ * · 10 秒不选 → 默认「我来操作」（人正在动手机，就让他来）
+ * · 只是提示：真正的动作（停任务 / 搬回虚拟屏）由 Dart 侧根据回调执行
+ */
+object SwitchPromptOverlay {
+    /** 用户的选择：manual（我接管）/ ai（继续 AI）。 */
+    var onPick: ((String) -> Unit)? = null
+
+    private var root: View? = null
+    private var wm: WindowManager? = null
+    private var ticker: Runnable? = null
+    private var remaining = 10
+
+    fun isShowing(): Boolean = root != null
+
+    @SuppressLint("ClickableViewAccessibility")
+    fun show(context: Context, seconds: Int = 10) {
+        hide()
+        val app = context.applicationContext
+        val px = app.resources.displayMetrics.density
+        val manager = app.getSystemService(Context.WINDOW_SERVICE) as WindowManager
+
+        val row = LinearLayout(app).apply {
+            orientation = LinearLayout.HORIZONTAL
+            gravity = Gravity.CENTER_VERTICAL
+            setPadding((16 * px).roundToInt(), (8 * px).roundToInt(), (8 * px).roundToInt(), (8 * px).roundToInt())
+            background = GradientDrawable().apply {
+                cornerRadius = 22 * px
+                setColor(0xF220E3B0.toInt())
+            }
+        }
+        val label = TextView(app).apply {
+            text = "检测到你切到前台"
+            setTextColor(Color.rgb(16, 24, 32))
+            textSize = 13f
+        }
+        row.addView(label, LinearLayout.LayoutParams(0, -2, 1f))
+
+        val countdown = TextView(app).apply {
+            text = seconds.toString()
+            setTextColor(Color.rgb(16, 24, 32))
+            textSize = 13f
+            setPadding((8 * px).roundToInt(), 0, (8 * px).roundToInt(), 0)
+        }
+        row.addView(countdown)
+
+        fun button(text: String, pick: String): TextView = TextView(app).apply {
+            this.text = text
+            setTextColor(Color.WHITE)
+            textSize = 13f
+            gravity = Gravity.CENTER
+            setPadding((12 * px).roundToInt(), (6 * px).roundToInt(), (12 * px).roundToInt(), (6 * px).roundToInt())
+            background = GradientDrawable().apply {
+                cornerRadius = 16 * px
+                setColor(0xFF16202C.toInt())
+            }
+            setOnClickListener {
+                WakeTrace.log("prompt: pick=$pick")
+                hide()
+                onPick?.invoke(pick)
+            }
+        }
+        row.addView(button("我来操作", "manual"))
+        (row.getChildAt(row.childCount - 1) as TextView).setPadding(
+            (12 * px).roundToInt(), (6 * px).roundToInt(), (10 * px).roundToInt(), (6 * px).roundToInt(),
+        )
+        row.addView(button("AI 继续", "ai"))
+
+        val lp = WindowManager.LayoutParams(
+            WindowManager.LayoutParams.MATCH_PARENT,
+            WindowManager.LayoutParams.WRAP_CONTENT,
+            WindowManager.LayoutParams.TYPE_APPLICATION_OVERLAY,
+            WindowManager.LayoutParams.FLAG_NOT_FOCUSABLE or
+                WindowManager.LayoutParams.FLAG_LAYOUT_IN_SCREEN,
+            PixelFormat.TRANSLUCENT,
+        ).apply {
+            gravity = Gravity.TOP
+            y = (56 * px).roundToInt()
+            x = (16 * px).roundToInt()
+        }
+        val added = runCatching { manager.addView(row, lp) }.isSuccess
+        if (!added) {
+            WakeTrace.log("prompt: addView failed (no overlay permission?)")
+            root = null
+            wm = null
+            return
+        }
+        root = row
+        wm = manager
+        WakeTrace.log("prompt: shown (${seconds}s)")
+
+        remaining = seconds
+        val handler = Handler(Looper.getMainLooper())
+        val r = object : Runnable {
+            override fun run() {
+                remaining -= 1
+                countdown.text = remaining.toString()
+                if (remaining <= 0) {
+                    WakeTrace.log("prompt: timeout → manual")
+                    hide()
+                    onPick?.invoke("manual")
+                    return
+                }
+                handler.postDelayed(this, 1000)
+            }
+        }
+        ticker = r
+        handler.postDelayed(r, 1000)
+    }
+
+    fun hide() {
+        ticker?.let { Handler(Looper.getMainLooper()).removeCallbacks(it) }
+        ticker = null
+        val view = root ?: return
+        root = null
+        runCatching { wm?.removeView(view) }
+        wm = null
+    }
+}
diff --git a/app/android/app/src/main/kotlin/io/github/ccch1mneyyy/dsh_app/phone/vscreen/TaskMover.kt b/app/android/app/src/main/kotlin/io/github/ccch1mneyyy/dsh_app/phone/vscreen/TaskMover.kt
new file mode 100644
index 0000000..19aecfe
--- /dev/null
+++ b/app/android/app/src/main/kotlin/io/github/ccch1mneyyy/dsh_app/phone/vscreen/TaskMover.kt
@@ -0,0 +1,152 @@
+package io.github.ccch1mneyyy.dsh_app.phone.vscreen
+
+import android.content.Context
+import android.hardware.display.DisplayManager
+import android.util.Log
+import io.github.ccch1mneyyy.dsh_app.phone.Decision
+import io.github.ccch1mneyyy.dsh_app.phone.PhoneShellExecutor
+import io.github.ccch1mneyyy.dsh_app.wake.WakeTrace
+
+/**
+ * 双向任务迁移: moving a running app's task between the background display and the phone's own
+ * screen, so what the assistant prepared can be handed over (and what the person is using can be
+ * handed back) without relaunching it.
+ *
+ * The call itself is hidden API (`IActivityTaskManager.moveRootTaskToDisplay`) and only works
+ * from shell uid — which is where the privileged side runs. This object is the app-process half:
+ * it resolves the task that currently owns a display and reports what it could see, so a failure
+ * is a message rather than a silent no-op.
+ */
+object TaskMover {
+    private const val TAG = "DshTaskMove"
+
+    /** The display ids in play: the phone's own screen is always [android.view.Display.DEFAULT_DISPLAY]. */
+    fun displays(context: Context): List<Int> {
+        val manager = context.getSystemService(DisplayManager::class.java) ?: return listOf(0)
+        return manager.displays.map { it.displayId }.distinct()
+    }
+
+    /**
+     * Runs `moveRootTaskToDisplay(taskId, displayId)` through the hidden ActivityTaskManager.
+     * Returns null on success, or a short reason. Shell uid (Shizuku) is required; a normal app
+     * gets a security exception, which is reported rather than swallowed.
+     */
+    fun move(taskId: Int, displayId: Int): String? = try {
+        val managerClass = Class.forName("android.app.ActivityTaskManager")
+        val service = managerClass.getMethod("getService").invoke(null)
+        val move = service.javaClass.methods.firstOrNull {
+            it.name == "moveRootTaskToDisplay" && it.parameterTypes.size == 2
+        } ?: return "noMoveApi"
+        move.invoke(service, taskId, displayId)
+        null
+    } catch (e: Throwable) {
+        Log.w(TAG, "move failed", e)
+        (e.cause?.javaClass?.simpleName ?: e.javaClass.simpleName)
+    }
+
+    /**
+     * 一次 `am task move-task` 的结果：ok 之外还要有 exit code / stderr，
+     * 以及**搬完回读到的 displayId**——退出码不代表任务真的换了屏（真机 19:23 的日志：
+     * `ok=true` 之后两次读屏仍在 displayId=128），所以 ok 必须由回读说了算。
+     */
+    data class MoveOutcome(
+        val ok: Boolean,
+        val exitCode: Int?,
+        val detail: String,
+        val reason: String?,
+        val displayAfter: Int? = null,
+    ) {
+        val line: String
+            get() = "ok=$ok exit=${exitCode ?: "-"} reason=${reason ?: "-"} " +
+                "after=${displayAfter ?: "unknown"} detail=${detail.take(160)}"
+    }
+
+    /**
+     * 切换键/眼睛键的迁移走系统命令 `am task move-task <taskId> <displayId>`（与 Mika 同路），
+     * 由本机 shell 后端执行；不像反射那样依赖调用者 uid，失败也能带回 stderr 和退出码。
+     * 这个调用是阻塞的（几十到几百毫秒），调用方必须在后台线程用它，别压在 UI 线程上。
+     */
+    /**
+     * 回读一个任务停在哪块屏：`dumpsys activity activities` 里该任务那段下面的 `mDisplayId=`。
+     * 过滤放在设备端（grep），回传只有一两行，不会把整份 dumpsys 拖回来；读不到就 null。
+     */
+    fun displayOfTask(shell: PhoneShellExecutor?, taskId: Int): Int? {
+        val runner = shell ?: return null
+        val command = "dumpsys activity activities | grep -A40 \"#$taskId \" | grep -m1 mDisplayId="
+        val out = try {
+            runner.execute(0L, command, 6_000L, { true }) { _, _ -> Decision.ALLOW_ONCE }
+        } catch (t: Throwable) {
+            Log.w(TAG, "display read-back threw", t)
+            return null
+        }
+        val text = ((out["stdout"] as? String) ?: "").trim()
+        return Regex("mDisplayId=(\\d+)").find(text)?.groupValues?.get(1)?.toIntOrNull()
+    }
+
+    private val packageName = Regex("[a-zA-Z][a-zA-Z0-9_]*(\\.[a-zA-Z0-9_]+)+")
+
+    /**
+     * 回读一个包现在停在哪块屏（6.1 的打开后校验）：`dumpsys activity activities` 里包名所在的
+     * 任务块下面的第一个 `mDisplayId=`。过滤放在设备端（awk），回传只有一行。
+     * 读不到（没有这个包的任务 / 命令失败）返回 null——那是"未证实"，不许当成"在虚拟屏"。
+     */
+    fun displayOfPackage(shell: PhoneShellExecutor?, pkg: String): Int? {
+        val runner = shell ?: return null
+        if (!packageName.matches(pkg)) return null
+        // 任务头写的是 `A=<uid>:<pkg>`；没有那行时退到 realActivity 的 `<pkg>/`。
+        val patterns = listOf(":" + pkg + " ", pkg + "/")
+        for (pattern in patterns) {
+            val command = "dumpsys activity activities | awk -v p='$pattern' " +
+                "'index(\$0, p) > 0 { f = 1 } f && /mDisplayId=/ { print; exit }'"
+            val text = try {
+                val out = runner.execute(0L, command, 6_000L, { true }) { _, _ -> Decision.ALLOW_ONCE }
+                ((out["stdout"] as? String) ?: "").trim()
+            } catch (t: Throwable) {
+                Log.w(TAG, "display-of-package read-back threw", t)
+                ""
+            }
+            Regex("mDisplayId=(\\d+)").find(text)?.groupValues?.get(1)?.toIntOrNull()?.let { return it }
+        }
+        return null
+    }
+
+    fun moveViaShell(shell: PhoneShellExecutor?, taskId: Int, displayId: Int): MoveOutcome {
+        if (taskId <= 0 || displayId < 0) return MoveOutcome(false, null, "", "invalidArguments")
+        val runner = shell ?: return MoveOutcome(false, null, "", "noShell")
+        // 这台 ROM 没有 `am task move-task`（exit=255 unknown command），真机可用的是
+        // `am display move-stack <taskId> <displayId>`（用户实测：整条任务换屏、不重开）。
+        val command = "am display move-stack $taskId $displayId"
+        val out = try {
+            runner.execute(0L, command, 6_000L, { true }) { _, _ -> Decision.ALLOW_ONCE }
+        } catch (t: Throwable) {
+            Log.w(TAG, "am task move-task threw", t)
+            return MoveOutcome(false, null, t.message ?: "", t.javaClass.simpleName)
+        }
+        val exit = (out["exitCode"] as? Number)?.toInt()
+        val stderr = (out["stderr"] as? String).orEmpty().trim()
+        val stdout = (out["stdout"] as? String).orEmpty().trim()
+        val started = out["started"] == true
+        // am 失败不总带非零退出码（有的 ROM 只往 stderr 写），两个都看一眼。
+        val complained = listOf(stderr, stdout).any { text ->
+            Regex("(?i)(error|exception|denied|unknown|usage:)").containsMatchIn(text)
+        }
+        val accepted = started && exit == 0 && !complained
+        // 回读：任务现在到底在哪块屏。读不到就当"未证实"——照报成功，但日志里是 unknown，
+        // 绝不冒充"已验证"。
+        val after = displayOfTask(runner, taskId)
+        val ok = accepted && (after == null || after == displayId)
+        val reason = when {
+            accepted && after != null && after != displayId -> "stillOnDisplay$after"
+            ok -> null
+            out["errorCode"] is String -> out["errorCode"] as String
+            // 不能写 `!started`：上一行的 `as String` 会把换行后的 `!` 吃成 `String!`（Kotlin 的
+            // 平台类型写法），整段变成语法错误。
+            started.not() -> "notStarted"
+            complained -> "moveRejected"
+            else -> "exit$exit"
+        }
+        WakeTrace.log("vscreen: am task move-task $taskId $displayId " +
+            MoveOutcome(ok, exit, stderr.ifBlank { stdout }.take(160), reason, after).line)
+        return MoveOutcome(ok, exit, stderr.ifBlank { stdout }.take(300), reason, after)
+    }
+}
