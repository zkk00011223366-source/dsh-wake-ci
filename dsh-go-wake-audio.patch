+import 'dart:async';
+
+import 'package:flutter/services.dart';
+
+import 'package:flutter_riverpod/flutter_riverpod.dart';
+
+import '../voice/wake_word.dart' show diagWake;
+import 'package:shared_preferences/shared_preferences.dart';
+
+import '../phone/virtual_screen_window.dart';
+import 'phone_state.dart';
+
+/// 弹胶囊那一刻的任务号（选择时用；那时任务已经不在虚拟屏里）。
+class VirtualPrompt {
+  static int? taskId;
+}
+
+
+/// 虚拟屏 悬浮窗 的设置：画面刷新多快、画质多高、操作目标在哪块屏、悬浮窗开着没有。
+class VirtualScreenSettings {
+  const VirtualScreenSettings({
+    this.fps = 15,
+    this.quality = 80,
+    this.target = VirtualScreenTarget.virtual,
+    // 悬浮屏常开：后台任务一起来就摆出来，关了也记得住（下次不再自己弹）。
+    this.window = true,
+    // 允许手动操作：关着时画面只读（防误触打断 AI），开着时手指直接作用于虚拟屏。
+    this.manual = false,
+  });
+
+  final int fps;
+
+  /// JPEG 画质，60 / 80 / 100 —— 只影响预览的清晰度与流量。
+  final int quality;
+
+  final VirtualScreenTarget target;
+
+  /// 悬浮屏开关：开着就记住，重开 App 自动恢复；后台任务起来时也会自己弹出来。
+  final bool window;
+
+  /// 允许手动操作（默认关）：关 = 画面只读，开 = 点/长按/滑动直接落到虚拟屏里的应用上。
+  final bool manual;
+
+  VirtualScreenSettings copyWith({
+    int? fps,
+    int? quality,
+    VirtualScreenTarget? target,
+    bool? window,
+    bool? manual,
+  }) => VirtualScreenSettings(
+    fps: fps ?? this.fps,
+    quality: quality ?? this.quality,
+    target: target ?? this.target,
+    window: window ?? this.window,
+    manual: manual ?? this.manual,
+  );
+}
+
+/// 助手动手的地方：虚拟屏（默认），还是人眼前的这块（特例）。
+/// 默认操作屏：主屏 / 后台屏（不弹窗）/ 虚拟屏（弹窗）。
+/// AI 的明确指令（background=main/virtual/silent）优先于此设置。
+/// 你手动从球里打开查看：静默模式不再立刻把窗口关掉（11:2x）。
+bool vscreenManualView = false;
+
+/// 眼睛键把当前操作对象送进后台后置位：这条路径不许再自动弹窗
+/// （用户硬性要求：点眼睛不得弹出空的/黑屏悬浮窗；窗口出现必须有画面）。
+bool vscreenKeepBackground = false;
+
+/// 球上【切换】（主屏 → 虚拟屏）按下时置位：值 = 等画面的截止时间。
+/// 这期间只留黄球、不开窗；应用起来（虚拟屏里真有任务）且画面到了才开窗。
+/// 截止时间过了还没起来 → 本次不再弹窗，继续只剩球（再按一次【切换】或点眼睛才恢复）。
