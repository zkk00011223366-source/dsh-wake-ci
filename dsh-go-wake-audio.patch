+                }
+                else -> false
+            }
+        }
+    }
+
+    private fun fmt(value: Double): String = String.format(java.util.Locale.US, "%.3f", value)
+
+
+    private fun sliverBackground(px: Float) = GradientDrawable().apply {
+        cornerRadius = 6 * px
+        // 虚拟屏吸边条：红色（用户 22:22），和通话的绿色区分开。
+        setColor(0xCCEF5350.toInt())
+    }
+
+    /** The picture itself: the app's own page for this screen, not a dialog. */
+    private fun openApp(context: Context) {
+        onAction?.invoke("open")
+        try {
+            context.startActivity(
+                Intent(context, MainActivity::class.java)
+                    .addFlags(Intent.FLAG_ACTIVITY_NEW_TASK or Intent.FLAG_ACTIVITY_REORDER_TO_FRONT),
+            )
+        } catch (_: Exception) {
+        }
+    }
