@@ -0,0 +1,64 @@
+package io.github.ccch1mneyyy.dsh_app.phone.vscreen
+
+import io.github.ccch1mneyyy.dsh_app.phone.PhoneRegistry
+import io.github.ccch1mneyyy.dsh_app.wake.WakeTrace
+
+/**
+ * 三通道 → 界面形态的唯一判定点（真值表见交接第十一节）。
+ *
+ * 以前窗口显隐、黄条键数、键的行为分散在三处各算各的，改动互相打架。
+ * 现在只允许这里算：输入 channel / hasTask / shown，输出 window / ball2 / ball1 / none。
+ * 任何地方要决定"该出现什么"，只许调用 [decide]，不许自己判断。
+ */
+object VscreenUi {
+    const val WINDOW = "window"
+    const val BALL2 = "ball2"
+    const val BALL1 = "ball1"
+    const val NONE = "none"
+
+    /** 生效通道：virtual / silent / main（main 兼容旧的 background 命名）。 */
+    fun channel(): String = when (PhoneRegistry.vscreenTarget) {
+        "background" -> "silent"
+        "silent" -> "silent"
+        "main" -> "main"
+        "virtual" -> "virtual"
+        else -> "none"      // 本次任务还没开过通道：不给条、不给窗（不拿设置冒充）
+    }
+
+    fun hasTask(): Boolean = PhoneRegistry.vscreenTaskAlive?.invoke() == true
+
+    /** 唯一判定：返回 ui 形态，并把命中的规则打进日志。 */
+    fun decide(shown: Boolean, why: String = ""): String {
+        val ch = channel()
+        val task = hasTask()
+        val ui = when {
+            shown -> WINDOW                                  // R7：窗口可见 → 窗口（不挂条）
+            ch == "none" -> NONE                             // R0：还没开通道
+            ch == "virtual" && task -> WINDOW                // R1：虚拟屏 + 有任务 → 小窗
+            ch == "virtual" && !task -> NONE                 // R2：虚拟屏开局 → 等窗口，不挂条
+            ch == "silent" -> BALL2                          // R3：后台屏 → 双键条
+            // R5：单键条严格跟"主屏通道"绑定——只要有主屏任务就出单键，不等虚拟屏状态
+            ch == "main" -> BALL1
+            else -> NONE
+        }
+        warnIfOpenMissing(ch, task)
+        WakeTrace.log("ui-rule: $why channel=$ch hasTask=$task shown=$shown -> $ui")
+        return ui
+    }
+
+    /** 上一次报过的"以为开了、其实没开"，只在状态变化时记一行，免得每秒刷屏。 */
+    @Volatile private var missingReported: String? = null
+
+    /**
+     * 6.3：通道是 silent/virtual，账本却说没有任务——说明这一下**没真的开进虚拟屏**，
+     * 界面却按"已开"在走（双键条 / 等窗口）。这条日志是给"以为开了、其实没开"留的证据。
+     */
+    private fun warnIfOpenMissing(ch: String, hasTask: Boolean) {
+        val key = if (!hasTask && ch != "main" && ch != "none") ch else null
+        if (key == missingReported) return
+        missingReported = key
+        if (key != null) {
+            WakeTrace.log("vscreen: open-missing channel=$key hasTask=false — 以为开了，其实没开")
+        }
+    }
+}
