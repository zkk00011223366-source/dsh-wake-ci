+
+  @override
+  int build() {
+    // Every 唤醒 asks once, even the same phrase twice in a row.
+    ref.listen(wakeWordProvider, (before, after) {
+      if (after.hits > (before?.hits ?? 0)) {
+        phrase = ref.read(wakeSettingsProvider).keyword;
+        state = state + 1;
+        _dbg('call request #$state (${phrase})');
+      }
+    });
+    return 0;
+  }
+
+  /// 语音通话 asked for from outside the wake word — the AI key's shortcut
+  /// (`shortcuts.xml` → EntryActivity → launcher_entries.dart): the same path a wake
+  /// takes, so the call opens exactly once whichever asked.
+  void request(String phrase) {
+    this.phrase = phrase;
+    state = state + 1;
+  }
+}
