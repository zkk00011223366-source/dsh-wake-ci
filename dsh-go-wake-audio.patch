@@ -0,0 +1,39 @@
+package io.github.ccch1mneyyy.dsh_app.phone.vscreen
+
+import org.junit.Assert.assertEquals
+import org.junit.Test
+
+/** 比例只有一个来源：物理缓冲 + 旋转 → 逻辑宽高；四分之一圈交换宽高。 */
+class DisplayFrameGeometryTest {
+    @Test
+    fun uprightKeepsTheBufferAsIs() {
+        val g = DisplayFrameGeometry(720, 1600, 0)
+        assertEquals(720, g.width)
+        assertEquals(1600, g.height)
+        assertEquals(1600f / 720f, g.aspect, 0.0001f)
+    }
+
+    @Test
+    fun quarterTurnsSwapWidthAndHeight() {
+        for (rotation in listOf(1, 3)) {
+            val g = DisplayFrameGeometry(720, 1600, rotation)
+            assertEquals(1600, g.width)
+            assertEquals(720, g.height)
+            assertEquals(720f / 1600f, g.aspect, 0.0001f)
+        }
+        for (rotation in listOf(0, 2)) {
+            assertEquals(720, DisplayFrameGeometry(720, 1600, rotation).width)
+        }
+    }
+
+    @Test
+    fun missingSizeHasNoAspect() {
+        assertEquals(0f, DisplayFrameGeometry(0, 1600, 0).aspect, 0.0001f)
+    }
+
+    @Test
+    fun previewFollowsShortSide() {
+        assertEquals(360, DisplayFrameGeometry(720, 1600, 0).previewWidth(360))
+        assertEquals(800, DisplayFrameGeometry(1600, 720, 0).previewWidth(360))
+    }
+}
