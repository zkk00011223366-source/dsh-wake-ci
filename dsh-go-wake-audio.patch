+package io.github.ccch1mneyyy.dsh_app.call
+
+import android.content.Context
+import android.os.SystemClock
+import io.flutter.embedding.engine.plugins.FlutterPlugin
+import io.flutter.plugin.common.MethodCall
+import io.flutter.plugin.common.MethodChannel
+
+/**
+ * 语音通话 悬浮窗: the card's window, and the one thing it can ask for.
+ *
+ *   dsh/call-overlay   show { startedAtElapsedMs } -> bool · hide
+ *   dsh/call-overlay   action "hangUp" (the card's key)
+ */
+class CallOverlayPlugin : FlutterPlugin, MethodChannel.MethodCallHandler {
+    private var channel: MethodChannel? = null
+    private var context: Context? = null
+
+    override fun onAttachedToEngine(binding: FlutterPlugin.FlutterPluginBinding) {
+        context = binding.applicationContext
+        val ch = MethodChannel(binding.binaryMessenger, CHANNEL)
+        ch.setMethodCallHandler(this)
+        channel = ch
+        CallOverlay.onAction = { action -> ch.invokeMethod("action", action) }
+    }
+
+    override fun onDetachedFromEngine(binding: FlutterPlugin.FlutterPluginBinding) {
+        CallOverlay.onAction = null
+        CallOverlay.hide()
+        channel?.setMethodCallHandler(null)
+        channel = null
+        context = null
+    }
+
+    override fun onMethodCall(call: MethodCall, result: MethodChannel.Result) {
+        val app = context
+        when (call.method) {
+            "show" -> {
+                if (app == null) {
+                    result.success(false)
+                    return
+                }
+                val startedAt = (call.argument<Number>("startedAtElapsedMs"))?.toLong()
+                    ?: SystemClock.elapsedRealtime()
+                result.success(CallOverlay.show(app, startedAt))
+            }
+            "hide" -> {
+                CallOverlay.hide()
+                result.success(null)
+            }
+            // The microphone foreground service that keeps a call recording while the app is
+            // behind (操作手机 during a call must not end it).
+            "keepAlive" -> {
+                if (app != null) {
+                    CallForegroundService.ensure(app, call.argument<Boolean>("active") == true)
+                }
+                result.success(null)
+            }
+            else -> result.notImplemented()
+        }
+    }
+
+    companion object {
+        private const val CHANNEL = "dsh/call-overlay"
+
+        /** 通话是否进行中（由 Dart 的 keepAlive 维护）。 */
+        @Volatile
+        internal var callActive = false
+    }
+}
