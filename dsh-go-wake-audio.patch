+            "probe" -> result.success(
+                mapOf(
+                    "movedAgoMs" to (android.os.SystemClock.elapsedRealtime() - PhoneRegistry.lastEngineMoveMs),
+                    "shown" to VirtualScreenOverlay.shown,
+                    "taskId" to VirtualScreenOverlay.currentTaskId(),
+                    "hasTask" to (PhoneRegistry.backgroundAlive?.invoke() == true),
+                ),
+            )
+            // 虚拟屏上有没有前台应用：没有时窗口里的「返」「转」置灰（第十二节 2）。
+            "state" -> {
+                VirtualScreenOverlay.setHasApp(call.argument<Boolean>("hasApp") ?: true)
+                // 任务号也可能变（迁移后）：Dart 一侧知道最新的，同步给窗口。
+                (call.argument<Number>("taskId"))?.toLong()?.let { VirtualScreenOverlay.setTaskId(it) }
+                result.success(null)
+            }
+            "prompt" -> {
+                // Dart 判定"应用被从虚拟屏挪到主屏"时调用：弹胶囊等用户选。
+                val on = call.argument<Boolean>("on") != false
+                val ctx = context
+                if (on && ctx != null) SwitchPromptOverlay.show(ctx) else SwitchPromptOverlay.hide()
+                result.success(true)
+            }
+            "ball" -> {
+                if (app == null) {
+                    result.success(false)
+                    return
+                }
+                // 第十节 10: 只在主屏上真有可迁移应用时才露头（桌面、本 App 自己在前面时不出现）。
+                val on = call.argument<Boolean>("on") == true
+                // 静默模式（不弹窗）没有窗口来占屏：一次操作收尾就把屏销毁，屏里的应用跟着被杀。
+                // 球在场就等于"虚拟屏上还有东西要看"，用它占住这块屏（第⑦项 静默保活）。
+                // 窗口开着时本来就占着屏，别在球收起时把它放掉。
+                if (on) PhoneRegistry.holdDisplayForWindow?.invoke(true)
+                // M：只要虚拟屏上还有任务就常驻 hold，和窗口开没开无关。
+                // 以前球一收就放屏，屏被回收 → 读不到 → AI 退回主屏（"keeps collapsing"）。
+                else if (!VirtualScreenOverlay.shown &&
+                    PhoneRegistry.backgroundAlive?.invoke() != true
+                ) PhoneRegistry.holdDisplayForWindow?.invoke(false)
+                TransferBall.setWanted(on, app)
+                io.github.ccch1mneyyy.dsh_app.wake.WakeTrace.log("ball: on=$on hold=$on")
+                result.success(true)
+            }
+            else -> result.notImplemented()
+        }
+    }
+
+    private companion object {
+        const val CHANNEL = "dsh/virtual-screen"
+    }
+}
