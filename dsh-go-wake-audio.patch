+    /** 自绘喇叭图标：开声 = 喇叭 + 两道声波；静音 = 喇叭 + X（字体里没有静音字形）。 */
+    private class SoundGlyph(context: Context, private val px: Float, var muted: Boolean) : View(context) {
+        private val paint = Paint(Paint.ANTI_ALIAS_FLAG).apply {
+            style = Paint.Style.STROKE
+            strokeWidth = 1.6f * px
+            color = Color.WHITE
+            strokeJoin = Paint.Join.ROUND
+            strokeCap = Paint.Cap.ROUND
+        }
+
+        override fun onDraw(canvas: Canvas) {
+            val w = width.toFloat(); val h = height.toFloat()
+            val cx = w / 2f; val cy = h / 2f
+            val u = 7.2f * px
+            // 喇叭主体（三角 + 矩形）
+            // 整体略向左，给右边的 ✕/声波留位置，不越出圆底（00:03 反馈）。
+            val cx2 = cx - u * 0.55f
+            val path = android.graphics.Path()
+            path.moveTo(cx - u * 0.9f, cy - u * 0.35f)
+            path.lineTo(cx - u * 0.35f, cy - u * 0.35f)
+            path.lineTo(cx + u * 0.45f, cy - u * 0.95f)
+            path.lineTo(cx + u * 0.45f, cy + u * 0.95f)
+            path.lineTo(cx - u * 0.35f, cy + u * 0.35f)
+            path.lineTo(cx - u * 0.9f, cy + u * 0.35f)
+            path.close()
+            canvas.drawPath(path, paint)
+            if (muted) {
+                val d = 3.4f * px
+                canvas.drawLine(cx2 + u * 0.55f, cy - d, cx2 + u * 1.05f, cy + d, paint)
+                canvas.drawLine(cx2 + u * 0.55f, cy + d, cx2 + u * 1.05f, cy - d, paint)
+            } else {
+                canvas.drawArc(cx2 + u * 0.35f - 4.6f * px, cy - 4.6f * px, cx2 + u * 0.35f + 4.6f * px, cy + 4.6f * px, -55f, 110f, false, paint)
+                canvas.drawArc(cx2 + u * 0.35f - 8.2f * px, cy - 8.2f * px, cx2 + u * 0.35f + 8.2f * px, cy + 8.2f * px, -50f, 100f, false, paint)
+            }
+        }
+    }
+
+    private var soundGlyph: SoundGlyph? = null
+
+    private fun buildChrome(app: Context, box: FrameLayout, px: Float) {
+        val gap = (8 * px).roundToInt()
+        val edge = (8 * px).roundToInt()
+        // 第十二节: a 28 dp key, but never a touch area under 44 dp.
+        val touch = (44 * px).roundToInt()
+
+        // 顶部一行放齐四颗键（返 音 眼 …×）：同一行、同尺寸、同一垂直中心，不再一个贴左一个贴右
+        // 各算各的 margin —— 之前 × 明显比另外三个偏高，就是两套布局各摆各的。
+        fun hit(view: android.view.View, name: String) {
+            fun attach(v: android.view.View) {
+                v.setOnTouchListener { vv, e ->
+                    if (e.actionMasked == android.view.MotionEvent.ACTION_DOWN) {
+                        val xy = IntArray(2); vv.getLocationOnScreen(xy)
+                        WakeTrace.log("key hit=$name at=${xy[0]},${xy[1]}")
+                    }
+                    false
+                }
+            }
+            attach(view)
+            // 图标是子 View 时也挂一份，并且不让它自己消费点击：
+            // 以前中心那个图标把触摸吃掉，外层监听收不到，按键看起来"没反应"。
+            (view as? android.view.ViewGroup)?.let { g ->
+                for (i in 0 until g.childCount) {
+                    val c = g.getChildAt(i)
+                    c.isClickable = false
+                    c.isFocusable = false
+                    attach(c)
+                }
+            }
+        }
+        val back = roundKey(app, ICON_BACK, px) { requestBack() }.also { hit(it, "back") }
+        val sound = SoundGlyph(app, px, true)
+        soundGlyph = sound
+        val volume = roundKeyCustom(app, px, { sound }) {
+            // 默认静音：第一次点开声音，再点关掉。
+            toggleMute()
+        }.also { hit(it, "sound") }
+        val eye = roundKey(app, ICON_EYE, px) { toggleEye() }.also { hit(it, "eye") }
+        val close = roundKey(app, ICON_CLOSE, px) { endTask() }.also { hit(it, "close") }
+        val topRow = LinearLayout(app).apply {
+            orientation = LinearLayout.HORIZONTAL
+            gravity = Gravity.CENTER_VERTICAL
+        }
+        topRow.addView(back, LinearLayout.LayoutParams(touch, touch))
+        topRow.addView(volume, LinearLayout.LayoutParams(touch, touch).apply { leftMargin = gap })
+        topRow.addView(eye, LinearLayout.LayoutParams(touch, touch).apply { leftMargin = gap })
+        // 中间弹性留白，把 × 顶到最右，四颗键仍在同一条水平线上。
+        topRow.addView(View(app), LinearLayout.LayoutParams(0, 1).apply { weight = 1f })
+        topRow.addView(close, LinearLayout.LayoutParams(touch, touch))
+        // 键条的空白处也吃掉手势：不让点击穿透注入到应用（那里的应用可能正好是返回键）。
+        topRow.setOnTouchListener { _, _ -> true }
+        box.addView(topRow, FrameLayout.LayoutParams(-1, touch, Gravity.TOP).apply {
+            setMargins(edge, edge, edge, 0)
+        })
+        backKey = back
+        volumeKey = volume
+        eyeKey = eye
+        eyeGlyph = eye.getChildAt(0) as? TextView
+        topLeft = topRow
+        closeKey = close
+
+        // 底部一排：左 ⇄（把这块屏上的应用转到主屏），右"全屏"（用户 15:15：
+        // 不要放大缩小了，改成点一下直接全屏，再点退出）。
+        val transfer = roundKey(app, ICON_SWAP, px) { transferToMain() }.also { hit(it, "swap") }
+        val fullscreen = roundKeyCustom(app, px, { FullscreenGlyph(app, px) }) { toggleFullscreen() }.also { hit(it, "full") }
+        val right = LinearLayout(app).apply { orientation = LinearLayout.HORIZONTAL }
+        right.addView(transfer, LinearLayout.LayoutParams(touch, touch))
+        right.addView(fullscreen, LinearLayout.LayoutParams(touch, touch).apply { leftMargin = gap })
+        right.setOnTouchListener { _, _ -> true }
+        box.addView(right, FrameLayout.LayoutParams(-2, -2, Gravity.BOTTOM or Gravity.END).apply {
+            setMargins(0, 0, edge, edge)
+        })
+        transferKey = transfer
+        fullscreenKey = fullscreen
+        bottomRight = right
+
+        val caption = TextView(app).apply {
+            text = "在后台进行，可以继续用手机。点小画面可以放大看。"
+            setTextColor(0xB3FFFFFF.toInt())
+            textSize = 9f
+            maxLines = 2
+        }
+        box.addView(caption, FrameLayout.LayoutParams(-1, -2, Gravity.TOP).apply {
+            setMargins(edge, edge + touch, edge, 0)
+        })
+        hint = caption
+
+
+        // 拖拽条已改成独立小窗（syncGripWindow），这里不再往主窗里放任何东西。
+
+
+        // 音量条已取消：声音键改成"静音开关"（用户 20:45），不再弹滑杆。
+        volumeRow = null
+    }
+
+    private fun currentVolumePercent(app: Context): Int = try {
+        val audio = app.getSystemService(Context.AUDIO_SERVICE) as? AudioManager
+        val max = audio?.getStreamMaxVolume(AudioManager.STREAM_MUSIC) ?: 0
+        val now = audio?.getStreamVolume(AudioManager.STREAM_MUSIC) ?: 0
+        if (max <= 0) 50 else (now * 100 / max).coerceIn(0, 100)
+    } catch (_: Exception) {
+        50
+    }
+
+    private fun setVolumePercent(app: Context, percent: Int) {
+        try {
+            val audio = app.getSystemService(Context.AUDIO_SERVICE) as? AudioManager ?: return
+            val max = audio.getStreamMaxVolume(AudioManager.STREAM_MUSIC)
+            if (max <= 0) return
+            audio.setStreamVolume(AudioManager.STREAM_MUSIC, (percent * max / 100).coerceIn(0, max), 0)
+        } catch (_: Exception) {
+        }
+    }
+
+    /** 声音键：静音 ↔ 有声（默认静音），图标跟着变；不再弹音量条。 */
+    private fun toggleMute() {
+        val app = context ?: return
+        applyMuted(app, !muted)
+    }
+
+    private fun applyMuted(app: Context, value: Boolean) {
+        muted = value
+        soundGlyph?.let { it.muted = value; it.invalidate() }
+        try {
+            val audio = app.getSystemService(Context.AUDIO_SERVICE) as? AudioManager ?: return
+            val max = audio.getStreamMaxVolume(AudioManager.STREAM_MUSIC)
+            if (max <= 0) return
+            if (muted) {
+                if (savedVolume < 0) savedVolume = audio.getStreamVolume(AudioManager.STREAM_MUSIC)
+                audio.setStreamVolume(AudioManager.STREAM_MUSIC, 0, 0)
+            } else {
+                val back = if (savedVolume > 0) savedVolume else max / 2
+                audio.setStreamVolume(AudioManager.STREAM_MUSIC, back.coerceIn(0, max), 0)
+            }
+        } catch (_: Exception) {
+        }
+        WakeTrace.log("window: muted=$muted")
+    }
+
+    private fun restoreVolume(app: Context) {
+        val back = savedVolume
+        savedVolume = -1
+        if (back < 0) return
+        try {
+            val audio = app.getSystemService(Context.AUDIO_SERVICE) as? AudioManager ?: return
+            val max = audio.getStreamMaxVolume(AudioManager.STREAM_MUSIC)
+            if (max > 0) audio.setStreamVolume(AudioManager.STREAM_MUSIC, back.coerceIn(0, max), 0)
+        } catch (_: Exception) {
+        }
+    }
+
+    /** 眼睛: hide the picture, keep the display (and its task) running; the glyph follows. */
+    private fun toggleEye() {
+        // 眼睛键 = 切到后台操作：只隐藏窗口（surface/预览都保留）。
+        hideWindowOnly()
+        return
+        @Suppress("UNREACHABLE_CODE")
+        eyeHidden = !eyeHidden
+        eyeGlyph?.text = String(Character.toChars(if (eyeHidden) ICON_EYE_SLASH else ICON_EYE))
+        applyLive()
+    }
+
+    /** 返: the app on the virtual screen steps back one level. */
+    /**
+     * ← 返回键 = **收起窗口**（用户 19:02 选定）。不进引擎、不等回包：
+     * 之前走通道问引擎"让应用后退"，回包丢失就把界面卡在忙，表现成"返回键完全没反应"。
+     * 展开 → 收成小窗；小窗 → 整个收起（等同 × 的收窗，但不杀任务）。
+     */
+    private fun requestBack() {
+        val app = context ?: return
+        val manager = wm ?: return
+        val box = root ?: return
+        val lp = (box.layoutParams as? WindowManager.LayoutParams) ?: params ?: return
+        val px = app.resources.displayMetrics.density
+        WakeTrace.log("window: back (collapse) shape=$shape")
+        // 语义：中窗/全屏 → 回小窗；已经在小窗 → 收起成黄条（等同眼睛键）。
+        // 以前小窗按 ← 什么都不做（注释写了但没实现）。
+        if (shape == Shape.SMALL) {
+            WakeTrace.log("window: back on SMALL → hide to bar")
+            hideWindowOnly()
+            return
+        }
+        // 收起 = 回到"虚拟屏刚启动时"的尺寸和形态（小窗），不是关闭窗口（用户 19:05）。
+        applyShape(Shape.SMALL, manager, lp, box, area(app, manager), px)
+    }
+
+    /** 转: this screen's app goes to the phone itself, and the window steps aside. */
+    private fun transferToMain() {
+        // 以前这里 hasApp=false 就直接 return，什么都不做也不打日志，
+        // 界面上就是"切换键失效"。现在只在真的没有任务号时才跳过，并且必须留痕。
+        val id0 = taskId.takeIf { it > 0 } ?: previewTaskId
+        if (id0 == null || id0 <= 0) {
+            WakeTrace.log("window: transfer skipped, no task id")
+            return
+        }
+        // 带上窗口实际绑定的任务号：Dart 那边的状态可能是旧的/空的，
+        // 之前就出现 handOverTask(taskId:0) → noTask（20:23 日志）。
+        val id = taskId.takeIf { it > 0 } ?: previewTaskId
+        onAction?.invoke(if (id != null && id > 0) "toMain:$id" else "toMain")
+    }
+
+    /**
+     * ×：关窗 + 结束任务（用户 19:32 选定）。
+     * 语义：**先把屏里的应用交回主屏**，再结束任务——否则任务收尾会释放 hold、销毁虚拟屏，
+     * 屏里那个应用连带被杀（用户看到"应用没了"）。交不回去就照旧结束。
+     */
+    private fun endTask() {
+        // 带上窗口实际绑定的任务号：不带号时原生找不到"当前任务"，停止会静默失败（10:1x）。
+        val id = previewTaskId.takeIf { it > 0 } ?: taskId
+        hide()
+        val hand = io.github.ccch1mneyyy.dsh_app.phone.PhoneRegistry.handBackToMain
+        if (hand == null) {
+            WakeTrace.log("window: stop without hand-back (no hook) task=$id")
+            onAction?.invoke(if (id > 0) "stop:$id" else "stop")
+            return
+        }
+        worker.execute {
+            val handed = runCatching { hand.invoke(); true }.getOrDefault(false)
+            WakeTrace.log("window: hand back before stop handed=$handed task=$id")
+            main.post { onAction?.invoke(if (id > 0) "stop:$id" else "stop") }
+        }
+    }
+
+    // Touch: dragging, parking, shapes, and the person's own fingers
+
+    /**
+     * 手势挂最外层容器（box），坐标全用 raw（第二十一节 2）：SMALL / EXPAND 都能拖、都能甩边贴
+     * 边。键、音量条、提示条自己接自己那块（命中它们时这里让路），画面内容层不接任何事件。
+     */
+    @SuppressLint("ClickableViewAccessibility")
+    private fun attachTouch(
+        context: Context,
+        box: View,
+        manager: WindowManager,
+        lp: WindowManager.LayoutParams,
+        area: SafeArea,
+        px: Float,
+    ) {
+        val margin = (10 * px).roundToInt()
+        var startX = 0f
+        var startY = 0f
+        var fromX = 0
+        var fromY = 0
+        var lastX = 0f
+        var lastAt = 0L
+        var vx = 0f
+        var dragging = false
+        var downAt = 0L
+        var moved = 0f
+        var longFired = false
+        var windowGrab = true
+        var longPress: Runnable? = null
+
+        fun fraction(rawX: Float, rawY: Float): Pair<Double, Double> {
+            // 窗口 = 画面，比例直接按窗口算（不再有卡片层与底部多出的高度）。
+            val fx = ((rawX - lp.x) / lp.width.toFloat()).coerceIn(0f, 1f).toDouble()
+            val fy = ((rawY - lp.y) / lp.height.toFloat()).coerceIn(0f, 1f).toDouble()
+            return fx to fy
+        }
+
+        /** 注入不可用（或 shell 那条失败）时的退路：交给 Dart 走无障碍手势，异步、不卡手指。 */
+        fun fallbackGesture(kind: String, fx: Double, fy: Double, to: android.graphics.PointF?) {
+            val tail = if (to == null) "" else {
+                val (tx, ty) = fraction(to.x, to.y)
+                "," + fmt(tx) + "," + fmt(ty)
+            }
+            // 带上窗口实际绑定的任务号：Dart 侧状态可能是旧的，之前点按因此报
+            // "原观察不再可用"（20:19 截图里的红叉）。
+            val id = taskId.takeIf { it > 0 } ?: previewTaskId
+            // 带上 displayId 与显示尺寸：Dart 侧据此走 shell 注入（与 Mika 同路）。
+            val head = if (id > 0 && displayId > 0) {
+                "manual:$id:$displayId:${displayW}x${displayH}:"
+            } else if (id > 0) {
+                "manual:$id:"
+            } else "manual:"
+            onAction?.invoke(head + fmt(fx) + "," + fmt(fy) + "," + kind + tail)
+        }
+
+        fun inject(kind: String, at: android.graphics.PointF, to: android.graphics.PointF? = null) {
+            // 手指抬起时窗口可能已经被收掉（"5 秒没画面自动收窗"/眼睛键）。那时再往旧屏注入，
+            // 点击就落进一块没有任务的屏里（真机 23:33:45.58：hide 之后 84ms 仍 input -d 143 tap）。
+            if (root == null) {
+                WakeTrace.log("window: inject skipped (window closed) $kind")
+                return
+            }
+            val (fx, fy) = fraction(at.x, at.y)
+            // 优先走 shell 注入（与 Mika 同路）：不依赖无障碍坐标范围，改分辨率也不受影响。
+            if (displayId > 0 && displayW > 0 && displayH > 0) {
+                val x1 = (fx * displayW).toInt().coerceIn(0, displayW - 1)
+                val y1 = (fy * displayH).toInt().coerceIn(0, displayH - 1)
+                val cmd = when (kind) {
+                    "tap" -> "input -d $displayId tap $x1 $y1"
+                    "long" -> "input -d $displayId swipe $x1 $y1 $x1 $y1 600"
+                    else -> {
+                        val (tx, ty) = fraction(to?.x ?: at.x, to?.y ?: at.y)
+                        val x2 = (tx * displayW).toInt().coerceIn(0, displayW - 1)
+                        val y2 = (ty * displayH).toInt().coerceIn(0, displayH - 1)
+                        "input -d $displayId swipe $x1 $y1 $x2 $y2 220"
+                    }
+                }
+                // 这条命令是 shell 往返（超时上限 4 秒）。以前在手指抬起的回调里同步跑，
+                // 手动操作一开就整块卡住——UI 线程阻塞到 ANR 就是"点一下就闪退"的来源。
+                // 放到后台线程；失败再退回无障碍手势。
+                worker.execute {
+                    val ok = runCatching {
+                        io.github.ccch1mneyyy.dsh_app.phone.PhoneRegistry.injectDisplayInput?.invoke(cmd)
+                    }.getOrNull() == true
+                    if (ok) {
+                        WakeTrace.log("window: shell inject $cmd")
+                    } else {
+                        WakeTrace.log("window: shell inject failed $cmd fallback=previewGesture")
+                        main.post { fallbackGesture(kind, fx, fy, to) }
+                    }
+                }
+                return
+            }
+            // 退回无障碍：写清楚原因，避免"看起来改了其实没走新路"（10:0x）。
+            WakeTrace.log("window: shell inject unavailable (displayId=$displayId ch=${io.github.ccch1mneyyy.dsh_app.phone.PhoneRegistry.injectDisplayInput != null}) fallback=previewGesture")
+            fallbackGesture(kind, fx, fy, to)
+        }
+
+        fun hit(view: View?, rawX: Float, rawY: Float): Boolean {
+            val v = view ?: return false
+            if (v.visibility != View.VISIBLE) return false
+            val rect = android.graphics.Rect()
+            v.getGlobalVisibleRect(rect)
+            return rect.contains(rawX.roundToInt(), rawY.roundToInt())
+        }
+
+        /** 这一下落在键/音量条/提示条上：让它们自己处理。 */
+        fun onChrome(rawX: Float, rawY: Float): Boolean =
+            hit(backKey, rawX, rawY) || hit(volumeKey, rawX, rawY) || hit(eyeKey, rawX, rawY) ||
+                hit(closeKey, rawX, rawY) || hit(transferKey, rawX, rawY) ||
+                hit(fullscreenKey, rawX, rawY) || hit(volumeRow, rawX, rawY) || hit(hint, rawX, rawY)
+
