++/**
++ * 重启后恢复监听: the setting is remembered natively ([WakePrefs]), so listening can come back
++ * after a reboot without the app being opened first.
++ *
++ * Android 14 (API 34) and later refuse a microphone foreground service started from
++ * BOOT_COMPLETED — the platform does not hand the microphone to a background start, whatever the
++ * app asks. There the flag is left standing and listening comes back the moment the app's Dart
++ * side runs again (which is also what the widget, the launcher and a notification tap do).
++ */
++class WakeBootReceiver : BroadcastReceiver() {
++    override fun onReceive(context: Context, intent: Intent) {
++        val action = intent.action
++        if (action != Intent.ACTION_BOOT_COMPLETED && action != Intent.ACTION_MY_PACKAGE_REPLACED) return
++        if (!WakePrefs.enabled(context)) return
++        if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.UPSIDE_DOWN_CAKE) {
++            Log.i("DshWake", "boot: microphone services cannot start from BOOT_COMPLETED on API 34+; listening resumes with the app")
++            return
++        }
++        WakeWordService.ensure(context, true)
++    }
++}
