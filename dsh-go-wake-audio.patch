@@ -0,0 +1,320 @@
+package io.github.ccch1mneyyy.dsh_app.call
+
+import android.annotation.SuppressLint
+import android.content.Context
+import android.content.Intent
+import android.graphics.Canvas
+import android.graphics.Color
+import android.graphics.Paint
+import android.graphics.PixelFormat
+import android.graphics.RadialGradient
+import android.graphics.Shader
+import android.graphics.drawable.GradientDrawable
+import android.os.Build
+import android.os.SystemClock
+import android.view.Gravity
+import android.view.MotionEvent
+import android.view.View
+import android.view.WindowManager
+import android.widget.Chronometer
+import android.widget.FrameLayout
+import android.widget.LinearLayout
+import io.github.ccch1mneyyy.dsh_app.MainActivity
+import io.github.ccch1mneyyy.dsh_app.pet.Dock
+import io.github.ccch1mneyyy.dsh_app.pet.EdgeSnap
+import io.github.ccch1mneyyy.dsh_app.pet.SafeArea
+import io.github.ccch1mneyyy.dsh_app.pet.Side
+import kotlin.math.abs
+import kotlin.math.roundToInt
+
+/**
+ * 语音通话 in a window of its own — 微信's floating call, not picture-in-picture.
+ *
+ * The window carries no keys: ending a call belongs to the call page, and a key that small was
+ * both easy to hit by accident and too narrow for a word. It shows the light and how long the
+ * call has run. Dragged and released, it parks against the nearest edge and shrinks to a thin
+ * sliver — a tab that keeps nothing covered. A tap on the sliver brings the window back; a tap
+ * on the window brings the conversation back.
+ */
+object CallOverlay {
+    /** What the window asks for: bring the conversation back. */
+    var onAction: ((String) -> Unit)? = null
+
+    private const val PREFS = "call_overlay"
+    private const val KEY_SIDE = "side"
+    private const val KEY_FRACTION = "fraction"
+
+    /** A window width (dp) and height (dp) for the two shapes it takes. */
+    private const val CARD_W = 84f
+    private const val CARD_H = 104f
+    private const val SLIVER_W = 12f
+    private const val SLIVER_H = 56f
+
+    private var wm: WindowManager? = null
+    private var card: View? = null
+    private var params: WindowManager.LayoutParams? = null
+    private var dock = Dock.DEFAULT
+    private var context: Context? = null
+    private var collapsed = false
+
+    val shown: Boolean get() = card != null
+
+    fun show(context: Context, startedAtElapsed: Long): Boolean {
+        hide()
+        val app = context.applicationContext
+        val manager = app.getSystemService(Context.WINDOW_SERVICE) as? WindowManager ?: return false
+        val saved = app.getSharedPreferences(PREFS, Context.MODE_PRIVATE)
+        dock = Dock(
+            side = if (saved.getString(KEY_SIDE, "r") == "l") Side.LEFT else Side.RIGHT,
+            yFraction = saved.getFloat(KEY_FRACTION, Dock.DEFAULT.yFraction),
+        )
+        val area = safeArea(app, manager)
+        val px = app.resources.displayMetrics.density
+        val w = (CARD_W * px).roundToInt()
+        val h = (CARD_H * px).roundToInt()
+        val at = EdgeSnap.position(dock, w, h, area, (10 * px).roundToInt())
+
+        val view = buildCard(app, startedAtElapsed, px)
+        val lp = WindowManager.LayoutParams(
+            w,
+            h,
+            overlayType(),
+            WindowManager.LayoutParams.FLAG_NOT_FOCUSABLE or
+                WindowManager.LayoutParams.FLAG_LAYOUT_NO_LIMITS or
+                WindowManager.LayoutParams.FLAG_LAYOUT_IN_SCREEN,
+            PixelFormat.TRANSLUCENT,
+        ).apply {
+            gravity = Gravity.TOP or Gravity.START
+            x = at.x
+            y = at.y
+        }
+        attachTouch(app, view, manager, lp, area, px)
+        return try {
+            manager.addView(view, lp)
+            this.context = app
+            wm = manager
+            card = view
+            params = lp
+            collapsed = false
+            true
+        } catch (_: Exception) {
+            card = null
+            params = null
+            wm = null
+            false
+        }
+    }
+
+    fun hide() {
+        val view = card ?: return
+        card = null
+        params = null
+        collapsed = false
+        val manager = wm
+        wm = null
+        context = null
+        try {
+            manager?.removeView(view)
+        } catch (_: Exception) {
+        }
+    }
+
+    @Suppress("DEPRECATION")
+    private fun overlayType(): Int =
+        if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.O) WindowManager.LayoutParams.TYPE_APPLICATION_OVERLAY
+        else WindowManager.LayoutParams.TYPE_PHONE
+
+    private fun safeArea(context: Context, manager: WindowManager): SafeArea =
+        if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.R) {
+            val b = manager.currentWindowMetrics.bounds
+            SafeArea(b.width(), b.height(), 0, 0, 0, 0)
+        } else {
+            val m = context.resources.displayMetrics
+            SafeArea(m.widthPixels, m.heightPixels, 0, 0, 0, 0)
+        }
+
+    /** The window's shape: the card with the light and the timer, and the sliver it parks as. */
+    @SuppressLint("ClickableViewAccessibility")
+    private fun attachTouch(
+        context: Context,
+        view: View,
+        manager: WindowManager,
+        lp: WindowManager.LayoutParams,
+        area: SafeArea,
+        px: Float,
+    ) {
+        val margin = (10 * px).roundToInt()
+        var startX = 0f
+        var startY = 0f
+        var fromX = 0
+        var fromY = 0
+        var lastX = 0f
+        var lastAt = 0L
+        var vx = 0f
+        var dragging = false
+        val cardW = (CARD_W * px).roundToInt()
+        val cardH = (CARD_H * px).roundToInt()
+        val sliverW = (SLIVER_W * px).roundToInt()
+        val sliverH = (SLIVER_H * px).roundToInt()
+
+        fun applyShape(toCollapsed: Boolean) {
+            collapsed = toCollapsed
+            val w = if (toCollapsed) sliverW else cardW
+            val h = if (toCollapsed) sliverH else cardH
+            val at = EdgeSnap.position(dock, w, h, area, margin)
+            lp.width = w
+            lp.height = h
+            lp.x = at.x
+            lp.y = at.y
+            view.layoutParams = lp
+            try {
+                manager.updateViewLayout(view, lp)
+            } catch (_: Exception) {
+            }
+            // The card's own content hides while parked; the sliver is drawn by the window's
+            // background, so nothing has to be swapped out.
+            (view as? FrameLayout)?.getChildAt(0)?.visibility =
+                if (toCollapsed) View.INVISIBLE else View.VISIBLE
+            view.background = if (toCollapsed) sliverBackground(px) else cardBackground(px)
+        }
+
+        view.setOnTouchListener { _, event ->
+            if (collapsed) {
+                // A tap on the sliver only brings the card back; opening the call is the
+                // card's own tap, one step later. Doing both here skipped the card entirely.
+                if (event.actionMasked == MotionEvent.ACTION_UP) applyShape(false)
+                return@setOnTouchListener true
+            }
+            when (event.actionMasked) {
+                MotionEvent.ACTION_DOWN -> {
+                    startX = event.rawX
+                    startY = event.rawY
+                    fromX = lp.x
+                    fromY = lp.y
+                    lastX = event.rawX
+                    lastAt = SystemClock.elapsedRealtime()
+                    vx = 0f
+                    dragging = false
+                    true
+                }
+                MotionEvent.ACTION_MOVE -> {
+                    val dx = event.rawX - startX
+                    val dy = event.rawY - startY
+                    if (!dragging && (abs(dx) > 6 * px || abs(dy) > 6 * px)) dragging = true
+                    if (dragging) {
+                        val now = SystemClock.elapsedRealtime()
+                        if (now > lastAt) vx = (event.rawX - lastX) * 1000f / (now - lastAt)
+                        lastX = event.rawX
+                        lastAt = now
+                        lp.x = (fromX + dx).roundToInt().coerceIn(
+                            EdgeSnap.minX(area, margin),
+                            EdgeSnap.maxX(area, lp.width, margin),
+                        )
+                        lp.y = (fromY + dy).roundToInt().coerceIn(
+                            EdgeSnap.minY(area, margin),
+                            EdgeSnap.maxY(area, lp.height, margin),
+                        )
+                        try {
+                            manager.updateViewLayout(view, lp)
+                        } catch (_: Exception) {
+                        }
+                    }
+                    true
+                }
+                MotionEvent.ACTION_UP, MotionEvent.ACTION_CANCEL -> {
+                    if (!dragging) {
+                        // The drag listener returns true from ACTION_DOWN, which swallows the
+                        // tap a plain OnClickListener would have received; a touch that did not
+                        // move is the tap that brings the conversation back.
+                        view.performClick()
+                        return@setOnTouchListener true
+                    }
+                    dock = EdgeSnap.dockFor(lp.x, lp.y, lp.width, lp.height, area, margin, vx)
+                    val flung = abs(vx) >= EdgeSnap.FLING_PX_PER_S
+                    val nearEdge = lp.x <= EdgeSnap.minX(area, margin) + (12 * px).roundToInt() ||
+                        lp.x >= EdgeSnap.maxX(area, lp.width, margin) - (12 * px).roundToInt()
+                    context.getSharedPreferences(PREFS, Context.MODE_PRIVATE).edit()
+                        .putString(KEY_SIDE, if (dock.side == Side.LEFT) "l" else "r")
+                        .putFloat(KEY_FRACTION, dock.yFraction)
+                        .apply()
+                    // Thrown at a side, or put down against it: the card parks as a sliver.
+                    applyShape(flung || nearEdge)
+                    true
+                }
+                else -> false
+            }
+        }
+    }
+
+    private fun cardBackground(px: Float) = GradientDrawable().apply {
+        cornerRadius = 22 * px
+        setColor(Color.rgb(10, 14, 24))
+        // 边框也改成绿色，和球/吸边条统一（00:33）。
+        setStroke((1.5f * px).roundToInt(), Color.argb(210, 52, 211, 153))
+    }
+
+    private fun sliverBackground(px: Float) = GradientDrawable().apply {
+        cornerRadius = 6 * px
+        // 通话吸边条：绿色（用户 22:22），和虚拟屏的红色区分开。
+        setColor(Color.argb(220, 52, 211, 153))
+    }
+
+    private fun buildCard(context: Context, startedAtElapsed: Long, px: Float): View {
+        val root = FrameLayout(context).apply {
+            background = cardBackground(px)
+            setOnClickListener { openApp(context) }
+        }
+        val column = LinearLayout(context).apply {
+            orientation = LinearLayout.VERTICAL
+            gravity = Gravity.CENTER_HORIZONTAL
+            setPadding(0, (12 * px).roundToInt(), 0, (10 * px).roundToInt())
+        }
+        column.addView(Orb(context), LinearLayout.LayoutParams((44 * px).roundToInt(), (44 * px).roundToInt()))
+        val timer = Chronometer(context).apply {
+            // The window is told how long the call has run; Chronometer counts from a boot-time
+            // stamp, so the base is now minus that.
+            base = SystemClock.elapsedRealtime() - startedAtElapsed.coerceAtLeast(0L)
+            setTextColor(Color.rgb(226, 232, 240))
+            textSize = 12f
+            gravity = Gravity.CENTER
+            setPadding(0, (6 * px).roundToInt(), 0, 0)
+            start()
+        }
+        column.addView(timer, LinearLayout.LayoutParams(-1, -2))
+        root.addView(column, FrameLayout.LayoutParams(-1, -1))
+        return root
+    }
+
+    private fun openApp(context: Context) {
+        // Back to the conversation: the window has done its job once the page is up.
+        hide()
+        onAction?.invoke("open")
+        try {
+            context.startActivity(
+                Intent(context, MainActivity::class.java)
+                    .addFlags(Intent.FLAG_ACTIVITY_NEW_TASK or Intent.FLAG_ACTIVITY_REORDER_TO_FRONT),
+            )
+        } catch (_: Exception) {
+        }
+    }
+
+    /** The light that stands for the call, drawn rather than shipped as a bitmap. */
+    private class Orb(context: Context) : View(context) {
+        private val paint = Paint(Paint.ANTI_ALIAS_FLAG)
+
+        override fun onDraw(canvas: Canvas) {
+            val r = minOf(width, height) / 2f
+            paint.shader = RadialGradient(
+                width / 2f,
+                height / 2f,
+                r,
+                // 球体与吸边条同色系（绿）：中心浅绿、边缘深绿（00:30）。
+                intArrayOf(Color.rgb(209, 250, 229), Color.rgb(16, 74, 56)),
+                floatArrayOf(0f, 1f),
+                Shader.TileMode.CLAMP,
+            )
+            canvas.drawCircle(width / 2f, height / 2f, r, paint)
+            paint.shader = null
+        }
+    }
+}
