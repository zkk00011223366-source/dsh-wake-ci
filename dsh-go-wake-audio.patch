+                if (wasShown) {
+                    runCatching { VirtualScreenOverlay.hideWindowOnly(announce = false) }
+                        .onFailure { io.github.ccch1mneyyy.dsh_app.wake.WakeTrace.log(
+                            "vscreen: hide before move threw ${it.javaClass.simpleName}") }
+                }
+                io.github.ccch1mneyyy.dsh_app.wake.WakeTrace.log(
+                    "vscreen: move start taskId=$taskId display=$target surfaceLive=$live")
+                Thread({
+                    // 主路：引擎侧 moveRootTaskToDisplay。真机上 `am task move-task` 是
+                    // unknown command（exit=255），所以引擎先走，am 只兜底。
+                    val engine = runCatching {
+                        PhoneRegistry.moveDisplayTaskViaEngine?.invoke(toMain)
+                    }.getOrNull()
+                    val engineOk = engine?.get("ok") == true
+                    io.github.ccch1mneyyy.dsh_app.wake.WakeTrace.log(
+                        "vscreen: move engine toMain=$toMain ok=$engineOk reply=$engine")
+                    var ok = engineOk
+                    var how = "via=engine"
+                    if (!engineOk) {
+                        fun tryAm(): TaskMover.MoveOutcome = runCatching {
+                            val move = PhoneRegistry.moveDisplayTask
+                            if (move != null) move(taskId.toInt(), target) else {
+                                val cmd = "am task move-task $taskId $target"
+                                val amOk = PhoneRegistry.injectDisplayInput?.invoke(cmd) == true
+                                TaskMover.MoveOutcome(amOk, null, cmd, if (amOk) null else "noHook")
+                            }
+                        }.getOrElse {
+                            TaskMover.MoveOutcome(false, null, it.message ?: "", it.javaClass.simpleName)
+                        }
+                        var outcome = tryAm()
+                        // shell 执行器同一时刻只跑一条命令：忙的时候回 busy，等一下重试一次，
+                        // 否则日志里只剩 busy，看不出 am 到底能不能搬（23:14 实测）。
+                        if (!outcome.ok && outcome.reason == "busy") {
+                            Thread.sleep(350)
+                            outcome = tryAm()
+                        }
+                        ok = outcome.ok
+                        how = "via=am ${outcome.line}"
+                    }
+                    io.github.ccch1mneyyy.dsh_app.wake.WakeTrace.log(
+                        "vscreen: move done ok=$ok taskId=$taskId display=$target $how")
+                    if (ok) {
+                        val app = context
+                        val owner = if (app != null) runCatching {
+                            io.github.ccch1mneyyy.dsh_app.phone.background.BackgroundControl.get(app)
+                                .anyPreviewTarget()?.owner
+                        }.getOrNull() else null
+                        if (toMain) VsreenTaskMark.markOnMain(owner) else VsreenTaskMark.markOnVirtual(owner)
+                        PhoneRegistry.lastScreen = if (toMain) PhoneScreen.MAIN else PhoneScreen.BACKGROUND
+                        io.github.ccch1mneyyy.dsh_app.wake.WakeTrace.log(
+                            "vscreen: move verify target=${if (toMain) "main" else "virtual"} " +
+                                "owner=${owner ?: "-"} lastScreen=${if (toMain) "main" else "background"}")
+                    }
+                    if (!ok && wasShown) {
+                        main.post {
+                            val ctx = context ?: return@post
+                            runCatching { VirtualScreenOverlay.show(ctx, VirtualScreenOverlay.currentTaskId()) }
+                        }
+                    }
+                    main.post { runCatching { result.success(ok) } }
+                }, "dsh-vscreen-move").start()
+                PhoneRegistry.lastEngineMoveMs = android.os.SystemClock.elapsedRealtime()
+            }
+            "retask" -> {
+                // 窗口已经开着，只是任务换了（迁移）：别重建窗口，换个任务号即可。
+                (call.argument<Number>("taskId"))?.toLong()?.let { VirtualScreenOverlay.setTaskId(it) }
+                result.success(true)
+            }
+            "hide" -> {
+                SwitchPromptOverlay.hide()
+                VirtualScreenOverlay.hide()
+                // 关窗时先把屏里的应用搬回手机（内容不丢失、不被杀），再放开占屏。
+                val keepAlive = PhoneRegistry.backgroundAlive?.invoke() == true
+                val target = PhoneRegistry.holdDisplayForWindow
+                // 球还在场（静默/后台屏）时不能放屏：放掉就相当于把屏里还活着的应用连屏销毁，
+                // 和"静默保活"直接冲突。球不在时才真的放开。
+                val releaseHold = !TransferBall.isWanted
+                result.success(null)
+                Thread {
+                    runCatching {
+                        val hand = PhoneRegistry.handBackToMain
+                        hand?.invoke()
+                    }
+                    if (releaseHold) target?.invoke(false)
+                }.start()
+            }
+            "frame" -> {
+                val bytes = call.argument<ByteArray>("bytes")
+                result.success(bytes != null && VirtualScreenOverlay.pushFrame(bytes))
+            }
+            "wantsFrames" -> result.success(VirtualScreenOverlay.wantsFrames())
