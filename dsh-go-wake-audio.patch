+  /// 才解除（第十四节 1：切到主屏后虚拟屏窗口应消失）。
+  int? _suppressTask;
+
+  /// 刚「转到虚拟屏」的宽限期：迁移成功到状态更新之间有一瞬 lastScreen 还是主屏，
+  /// 原来会因此把窗口关掉（用户 18:49：闪一下就没了）。这段时间内不因瞬时状态关闭。
+  DateTime? _holdOpenUntil;
+
+  /// 上一次 sync 看到的任务号：用来识别"新任务起来了"，从而清掉按过眼睛的静默标记。
+  int? _lastTaskId;
+
+  @override
+  VirtualWindowState build() {
+    _frames; // 先建好：dispose 时才有东西可关
+    ref.listen(virtualScreenSettingsProvider, (before, after) {
+      _window?.setFps(after.fps);
+      if (before?.window != after.window) _applySetting(after.window);
+    });
+    ref.listen(phoneProvider, (_, after) => sync(after.status));
+    ref.onDispose(() {
+      final window = _window;
+      if (window != null) unawaited(window.close());
+    });
+    return const VirtualWindowState();
+  }
+
+  /// 任务号没了再问一句"屏里还有没有应用"，有就保持球（静默保活），没有才收球。
+  Future<void> _ballIfScreenAlive() async {
+    var alive = false;
+    try {
+      final probe = await const MethodChannel('dsh/virtual-screen')
+          .invokeMapMethod<String, dynamic>('probe');
+      alive = probe?['hasTask'] == true;
+    } catch (_) {}
+    if (!ref.mounted) return;
+    if (alive) {
+      if (!_ballOn) {
+        _ballOn = true;
+        unawaited(ref.read(virtualWindowProvider.notifier).setBall(true));
+      }
+    } else if (_ballOn) {
+      _ballOn = false;
+      unawaited(ref.read(virtualWindowProvider.notifier).setBall(false));
+    }
+  }
+
+  /// 胶囊：问"我来操作 / AI 继续"。引擎自己刚搬过屏就不问（那是 AI 的动作）。
+  Future<void> _askUser(int taskId) async {
+    var movedAgo = 1 << 30;
+    try {
+      final probe = await const MethodChannel('dsh/virtual-screen')
+          .invokeMapMethod<String, dynamic>('probe');
+      movedAgo = (probe?['movedAgoMs'] as num?)?.toInt() ?? movedAgo;
+    } catch (_) {}
+    if (movedAgo < 2500) {
+      diagWake('prompt: skipped, engine moved ${movedAgo}ms ago');
+      return;
+    }
+    VirtualPrompt.taskId = taskId;
+    await const MethodChannel('dsh/virtual-screen').invokeMethod<void>('prompt', {'on': true});
+    diagWake('prompt: app left virtual screen → ask user (movedAgo=$movedAgo)');
+  }
+
+  /// 跟着任务状态走：有后台任务、开关开着，就把它摆出来；任务没了就收起来。
+  String? _lastSeenScreen;
+
+
+
+  // 弹胶囊那一刻的任务号：等用户选择时它已经不在虚拟屏，必须提前记住（11:0x）。
+
+  void sync(PhoneStatus status) {
+    // 应用从虚拟屏被挪到主屏（用户手动切前台）→ 弹胶囊问"我来操作 / AI 继续"。
+    final prev = _lastSeenScreen;
+    _lastSeenScreen = status.lastScreen;
+    // 旧条件里还有 !status.task.active，但真机日志里手动切前台那一刻 task 一直是活跃的
+    // （12:39、12:46、12:51 三次 background→main 都是 task=1/2/4），所以胶囊从来没弹过。
+    // 现在改成：只要"从虚拟屏离开"就问，引擎自己搬的（2.5 秒内有搬屏/开屏）不问（第⑥项）。
+    // 文档六：AI 正在跑任务时被切走不弹；只有空闲时才算"你手动切到前台"。
+    if (prev == 'background' &&
+        status.lastScreen != 'background' &&
+        status.task.pendingCalls == 0 &&
+        (state.open || status.backgroundSilent)) {
+      // AI 空闲时后台任务号常常已经为空，这时退回当前任务号，别把胶囊整个吞掉。
+      final taskId = firstBackgroundTaskId(status) ?? status.task.id;
+      if (taskId != null && taskId > 0) unawaited(_askUser(taskId));
+    }
+    if (_busy) return;
+    if (_suppressTask != null) {
+      final stillActive = (status.task.id == _suppressTask && status.task.active) ||
+          status.tasks.any((task) => task.active && task.id == _suppressTask);
+      if (stillActive) {
+        if (state.open) unawaited(close());
+        return;
+      }
+      _suppressTask = null;
+    }
+    final taskId = firstBackgroundTaskId(status);
+    // 新任务起来时清掉"按过眼睛"的标记：否则设的是虚拟屏，新任务还是静默（22:08 实测）。
+    if (_lastTaskId != taskId) {
+      if (_lastTaskId != null && vscreenKeepBackground) {
+        vscreenKeepBackground = false;
+        diagWake('vscreen: 新任务 → 清 keepBackground');
+      }
+      _lastTaskId = taskId;
+    }
+    // 窗口跟随"实际在用哪块屏"（用户 15:47）：AI 明确在主屏操作时窗口不出现；
+    // 只有真的在虚拟屏上干活（或刚转进来）才显示。设置开关只是默认值。
+    // 默认操作=后台屏时，窗口不自动弹（AI 在后台默默干活）；AI 明确要虚拟屏时会切 target。
+    var silent = status.backgroundSilent || vscreenKeepBackground ||
+        ref.read(virtualScreenSettingsProvider).target == VirtualScreenTarget.background;
+    // AI 这次明确要"后台屏"：清掉手动查看，静默重新生效（11:3x）。
+    if (status.backgroundSilent) vscreenManualView = false;
+    if (vscreenManualView && !status.backgroundSilent) silent = false;
+    final onVirtual = status.lastScreen == 'background' && !silent;
+    // 三态映射判据：设置/指令 → 最终选用的 UI 形态。三种设置各发一次任务，
+    // 日志里的 ui 必须分别是 window / ball2 / ball1。
+    final targetName = status.backgroundSilent
+        ? 'background'
+        : (ref.read(virtualScreenSettingsProvider).target.name);
+    // 判据带分解：只看 silent=true 分不清是哪面旗子顶上来的（经验包外的实测需要这一行）。
+    diagWake(
+        'vscreen: target=$targetName ui=${state.open ? "window" : (_ballOn ? "ball2" : "ball1")} '
+        'silent=$silent onVirtual=$onVirtual '
+        'flags(bgSilent=${status.backgroundSilent} keepBg=$vscreenKeepBackground '
+        'target=$targetName manual=$vscreenManualView await=${vscreenAwaitPictureUntil != null})');
+    // 唯一判定点（原生 VscreenUi）已经给出结论：窗口 / ball2 / ball1 / none。
+    // 这里直接采纳，不再用 lastScreen / _ballOn 自己推——今晚 N7/N8/N11 全是重复推导惹的。
+    final ui = status.vscreenUi;
+    if (ui.isNotEmpty) {
+      final wantBall = ui == 'ball2' || ui == 'ball1';
+      // 必须无条件下发：原生"眼睛键"会自己把球叫出来（setWanted(true)），Dart 的 _ballOn
+      // 并不知道；以前用 _ballOn 做门，收到 ui=none 时以为"本来没球"就不关 → 任务结束黄条还挂着。
+      if (wantBall != _ballOn) {
+        _ballOn = wantBall;
+        unawaited(ref.read(virtualWindowProvider.notifier).setBall(wantBall));
+      } else if (!wantBall) {
+        // 兜底再下发一次 false：原生侧可能被强制叫出来过（幂等，不会闪）
+        unawaited(ref.read(virtualWindowProvider.notifier).setBall(false));
+      }
+      if (ui == 'window') {
+        if (taskId != null && !state.open) unawaited(open(taskId));
+      } else if (state.open) {
+        unawaited(close());
+      }
+      diagWake('sync: 采纳 ui=$ui task=$taskId open=${state.open} ball=$_ballOn');
+      return;
+    }
+
+    // 球上【切换】（主屏 → 虚拟屏）之后的等待：应用起来、虚拟屏有画面才开窗，最多等 5 秒。
+    // 没起来 → 留着球、不开窗（绝不先给一个空的虚拟屏窗口）。截止时间过了就本次不再弹，
+    // 再按一次【切换】或点眼睛（都会清掉这个标记）才恢复。
+    final awaitAt = vscreenAwaitPictureUntil;
+    if (awaitAt != null) {
+      final expired = DateTime.now().isAfter(awaitAt);
+      if (taskId != null && onVirtual) {
+        // 应用起来了：正常走下面的开窗，画面没到之前窗口是透明的。
+        vscreenAwaitPictureUntil = null;
+      } else if (expired || taskId == null) {
+        // 到点作废 / 根本没有任务：标记必须清掉，否则下面"任务结束收球"那段永远走不到
+        // （真机 22:09 日志：收球之后又被拉回来，黄条赖着不走）。
+        vscreenAwaitPictureUntil = null;
+        diagWake('vscreen: await 过期 → 清标记（expired=$expired task=$taskId）');
+      } else {
+        if (!state.open && !_ballOn) {
+          _ballOn = true;
+          unawaited(ref.read(virtualWindowProvider.notifier).setBall(true));
+        }
+        return;
+      }
+    }
+    // 球的出现条件（文档 §五 + §九.2）：**有任务、且当前没有可见窗口**就常驻，
+    // 不管此刻在主屏还是后台屏——主屏操作时也留着球，随时能切回来。
+    // 球只跟任务绑定：没有任务 → 收球；没有可见窗口 → 出球。
+    // 窗口开着（小窗/中窗/全屏）时不主动下发，交给原生按形态决定（细条要出球）。
+    if (taskId == null) {
+      // 任务结束：没有可见窗口就不该再挂球（18:4x 用户报"第二个任务结束后黄条不退"）。
+      if (!state.open && _ballOn) {
+        _ballOn = false;
+        unawaited(ref.read(virtualWindowProvider.notifier).setBall(false));
+      }
+    } else if (onVirtual) {
+      // 默认/指令=虚拟屏：先给窗口，不出球（设置只是默认，此处正是默认的体现）。
+      if (_ballOn) {
+        _ballOn = false;
+        unawaited(ref.read(virtualWindowProvider.notifier).setBall(false));
+      }
+    } else if (!state.open && !_ballOn) {
+      // 需求四：设"虚拟屏"时**不许先冒黄条**。任务一起来就直接等窗口（AI 打开应用后
+      // <2 秒窗口出现）；黄条只在主屏/后台屏两种设置下出现。
+      // 只有 AI 真在虚拟屏上操作才不挂条；命令走主屏时必须给单键条。
+      // 只有"AI 还没开始在虚拟屏上操作"才不挂条；一旦 AI 已在虚拟屏（lastScreen=background），
+      // 条必须允许出现——否则用户按眼睛收起后，窗口没了、条也被压掉，屏幕上什么都不剩。
+      if (targetName == VirtualScreenTarget.virtual.name &&
+          status.lastScreen != 'background') {
+        diagWake('ball: skipped（target=virtual，等窗口，不挂条）');
+      } else {
+        _ballOn = true;
+        unawaited(ref.read(virtualWindowProvider.notifier).setBall(true));
+      }
+    }
+    // 宽限期内一直算"该显示"，到期自然失效（不能读一次就清掉，否则第二次 sync 又关了）。
+    // 窗口为什么开/为什么关：迁移、"明确主屏却弹窗"这类问题只靠这行日志能定案。
+    // 应用已经不在虚拟屏（被搬到主屏/结束了）→ 窗口立刻关掉，别留一个卡住的旧窗口（12:0x）。
+    if (state.open && !onVirtual && taskId == null) {
+      unawaited(ref.read(virtualWindowProvider.notifier).close());
+    }
+    diagWake('vsync: lastScreen=${status.lastScreen} task=${firstBackgroundTaskId(status)} open=${state.open} hold=${_holdOpenUntil != null}');
+    final holding = _holdOpenUntil != null && DateTime.now().isBefore(_holdOpenUntil!);
+    if (!holding) _holdOpenUntil = null;
+    if (!onVirtual && !holding) {
+      if (state.open) unawaited(close());
+      return;
+    }
+    if (taskId == null) {
+      if (state.open) unawaited(close());
+      return;
+    }
+    if (state.open && state.taskId == taskId) return;
+    unawaited(open(taskId));
+  }
+
+  /// 迁移成功后的宽限：这之后 3 秒内即使状态还写着"主屏"，也不关窗口。
+  void holdOpen([Duration span = const Duration(seconds: 3)]) {
+    _holdOpenUntil = DateTime.now().add(span);
+  }
+
+  void _applySetting(bool on) {
+    if (!on) {
+      unawaited(close());
+      return;
+    }
+    final taskId = firstBackgroundTaskId(ref.read(phoneProvider).status);
+    if (taskId != null) unawaited(open(taskId));
+  }
+
+  Future<bool> open(int taskId) async {
+    if (state.open && state.taskId == taskId) return true;
+    if (_busy) return false;
+    _busy = true;
+    try {
+      // 悬浮窗看的是预览通道：没开就先开，不然窗口里永远是空的。
+      await ref.read(phoneProvider.notifier).setBackgroundPreview(true);
+      final ok = await _frames.open(taskId, fps: ref.read(virtualScreenSettingsProvider).fps);
+      if (ok) state = VirtualWindowState(open: true, taskId: taskId);
+      return ok;
+    } finally {
+      _busy = false;
+    }
+  }
+
+  /// 主屏上的吸附式悬浮球：窗口在、App 不在前台时出现。
+  Future<bool> setBall(bool on) => _frames.setBall(on);
+
+  /// 收起窗口。[suppressTask]：这个任务还活着的时候别让窗口自己弹回来（刚转到主屏）。
+  Future<void> close({int? suppressTask}) async {
+    if (suppressTask != null) _suppressTask = suppressTask;
+    if (!state.open) return;
+    state = const VirtualWindowState();
+    _busy = true;
+    try {
+      await _frames.close();
+    } finally {
+      _busy = false;
+    }
+  }
+}
+
+/// 悬浮窗要显示的任务：虚拟屏自己的那个活跃任务。旧的「后台槽位」机制已删除（第二十三节），
+/// 任务是谁建的就显示谁，不再按槽位挑。
+int? firstBackgroundTaskId(PhoneStatus status) {
+  final all = (status.tasks.isNotEmpty ? status.tasks : [status.task]).where(
+    (task) => task.active && task.id != null && task.id! > 0,
+  );
+  return all.isEmpty ? null : all.first.id;
+}
