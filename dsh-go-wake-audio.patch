+++ b/app/lib/ui/phone/virtual_screen_host.dart
@@ -0,0 +1,397 @@
+import 'dart:async';
+
+import 'package:flutter/material.dart';
+import 'package:flutter/services.dart';
+import 'package:flutter_riverpod/flutter_riverpod.dart';
+
+import '../../state/phone_state.dart';
+import '../../voice/wake_word.dart' show diagWake;
+import '../../state/virtual_screen_state.dart';
+import '../common/brief_notice.dart';
+import 'background_preview.dart' show PhoneHandOverDone, handOverNotice, phoneHandOverMessage;
+import 'virtual_screen_page.dart';
+
+/// 悬浮窗按下之后回到 App：直接开可操作的虚拟屏整页（不是预览弹窗），手指点哪里就是哪里。
+/// 也把 [virtualWindowProvider] 挂在界面上——它不在 home shell 里就没人恢复「悬浮屏」开关，
+/// 也没人在后台任务起来时把窗口摆出来。画面上不占位置。
+///
+/// 窗口自己只画，需要通道的事都回来问：返（虚拟屏里退一层）、× （终止任务）、转（这块屏上的
+/// 应用搬到手机），以及「允许手动操作」打开后的点按。主屏上的那个吸附式悬浮球也由这里管：
+/// App 不在前台、而且虚拟屏上确实有东西可转的时候才出现。
+class VirtualScreenHost extends ConsumerStatefulWidget {
+  const VirtualScreenHost({super.key});
+
+  @override
+  ConsumerState<VirtualScreenHost> createState() => _VirtualScreenHostState();
+}
+
+/// 任何地方（通话页等）都能触发和按钮一致的转场；宿主挂载时注册。
+Future<void> Function({required bool toMain})? globalHandOver;
+
+class _VirtualScreenHostState extends ConsumerState<VirtualScreenHost> {
+  static const MethodChannel _channel = MethodChannel('dsh/virtual-screen');
+  bool _opening = false;
+  bool _acting = false;
+  bool _foreground = true;
+  /// 刚转过「虚拟屏 → 主屏」：球该出现；任务一结束就收起（用户 10:36：球不能跟着应用乱弹）。
+  bool _justTransferredToMain = false;
+  AppLifecycleListener? _lifecycle;
+  String? _lastBall;
+  String? _lastApp;
+
+  @override
+  void initState() {
+    super.initState();
+    globalHandOver = ({required bool toMain}) => _transfer(toMain: toMain);
+    _foreground = WidgetsBinding.instance.lifecycleState == AppLifecycleState.resumed;
+    _lifecycle = AppLifecycleListener(onStateChange: (state) {
+      _foreground = state == AppLifecycleState.resumed;
+      _syncBall();
+    });
+  }
+
+  @override
+  void dispose() {
+    globalHandOver = null;
+    _lifecycle?.dispose();
+    super.dispose();
+  }
+
+  @override
+  void didChangeDependencies() {
+    super.didChangeDependencies();
+    _channel.setMethodCallHandler(_onCall);
+  }
+
+  Future<void> _onCall(MethodCall call) async {
+    if (call.method != 'action' || call.arguments is! String || !mounted) return;
+    final action = call.arguments as String;
+    if (action == 'manual' || action.startsWith('manual:')) {
+      await _manual(action);
+      return;
+    }
+    if (action == 'open') {
+      await _openPage();
+    } else if (action == 'stop' || action.startsWith('stop:')) {
+      // 单点 × = 直接终止任务（窗口一起收起，原生那边已经收了）。
+      // 带上任务号：不带号原生找不到任务，会静默失败。
+      final id = action.contains(':') ? int.tryParse(action.split(':').last) : null;
+      await ref.read(phoneProvider.notifier).stopTask(taskId: id);
+      await ref.read(virtualWindowProvider.notifier).close();
+    } else if (action == 'back') {
+      await _back();
+    } else if (action == 'toMain' || action.startsWith('toMain:')) {
+      // 原生会把窗口实际绑定的任务号带过来（toMain:7），避免拿空 id 去迁移。
+      final id = action.contains(':') ? int.tryParse(action.split(':').last) : null;
+      await _transfer(toMain: true, taskId: id);
+    } else if (action == 'prompt:manual') {
+      // 用户选择手动接管：停止自动操作，虚拟屏保持存活（不销毁、不释放）。
+      final id = VirtualPrompt.taskId ?? firstBackgroundTaskId(ref.read(phoneProvider).status);
+      VirtualPrompt.taskId = null;
+      // 先占住后台屏再停任务：否则停任务的收尾会把屏释放，屏里的应用被杀
+      // （用户要求：手动接管后界面也不能停）11:1x。
+      ref.read(virtualWindowProvider.notifier).holdOpen();
+      await ref.read(phoneProvider.notifier).stopTask(taskId: id);
+      diagWake('prompt: manual takeover');
+    } else if (action == 'prompt:ai') {
+      // 继续 AI：把应用搬回虚拟屏再继续。
+      const ch = MethodChannel('dsh/virtual-screen');
+      final id = VirtualPrompt.taskId ?? firstBackgroundTaskId(ref.read(phoneProvider).status) ?? 0;
+      VirtualPrompt.taskId = null;
+      await ch.invokeMethod<bool>('moveTask', {'taskId': id, 'toMain': false});
+      // 搬回后重新开窗，否则应用虽回去了但你看不到画面（11:0x）。
+      ref.read(virtualWindowProvider.notifier).holdOpen();
+      await ref.read(virtualWindowProvider.notifier).open(id);
+      diagWake('prompt: ai continues');
+    } else if (action == 'eyeHidden') {
+      // 窗口已隐藏/应用已进后台：这条路径不许自动弹窗，只留两键球。
+      vscreenKeepBackground = true;
+      await ref.read(virtualWindowProvider.notifier).setBall(true);
+    } else if (action == 'eye') {
+      // 合并球上键：回到虚拟屏窗口（小窗形态）。手动查看压过静默（11:2x）。
+      vscreenKeepBackground = false;
+      vscreenManualView = true;
+      // 手动回虚拟屏：不再受"等 5 秒画面"的封顶约束（那是【切换】那一下的规则）。
+      vscreenAwaitPictureUntil = null;
+      final id = firstBackgroundTaskId(ref.read(phoneProvider).status) ?? 0;
+      ref.read(virtualWindowProvider.notifier).holdOpen();
+      await ref.read(virtualWindowProvider.notifier).open(id);
+    } else if (action == 'wantVirtual' || action == 'swap' || action == 'toVirtual') {
+      // 主屏上的【切换】：把本次任务的方向改成虚拟屏——不是把当前应用搬进去。
+      await _wantVirtual();
+    }
+  }
+
+  int? get _taskId =>
+      ref.read(virtualWindowProvider).taskId ?? firstBackgroundTaskId(ref.read(phoneProvider).status);
+
+  /// 球上【切换】（主屏）：把**本次任务的方向**改成虚拟屏，不搬当前应用。
+  /// 之后 AI 的动作用在虚拟屏；窗口要等应用起来、虚拟屏有画面（首帧/直显）之后才出现，
+  /// 最多等 5 秒——等不到就保持只有黄球、不显示窗口（用户要求，见 state 里的等待标记）。
+  Future<void> _wantVirtual() async {
+    diagWake('wantVirtual: 方向改为虚拟屏（不搬当前应用）');
+    vscreenKeepBackground = false;
+    vscreenManualView = false;
+    vscreenAwaitPictureUntil = DateTime.now().add(const Duration(seconds: 5));
+    await ref.read(virtualScreenSettingsProvider.notifier).setTarget(VirtualScreenTarget.virtual);
+    if (!mounted) return;
+    // 窗口还没出现：球先留在场上，屏幕上不能只剩一块空桌面。
+    await ref.read(virtualWindowProvider.notifier).setBall(true);
+    _lastBall = 'on';
+    if (!mounted) return;
+    // 5 秒到点还没开窗：只留球（不留空的虚拟屏窗口），标记保持到用户再按一次【切换】或点眼睛。
+    Timer(const Duration(seconds: 5), () {
+      if (!mounted) return;
+      if (ref.read(virtualWindowProvider).open) return;
+      // 没有任务了就别再把黄条拉回来（真机 22:09：收球 0.3 秒后被这句拉回，赖着不走）。
+      if (firstBackgroundTaskId(ref.read(phoneProvider).status) == null) {
+        diagWake('wantVirtual: 5 秒到点、已无任务 → 收球');
+        unawaited(ref.read(virtualWindowProvider.notifier).setBall(false));
+        _lastBall = 'off';
+        return;
+      }
+      diagWake('wantVirtual: 5 秒没等到画面 → 只留球');
+      unawaited(ref.read(virtualWindowProvider.notifier).setBall(true));
+      _lastBall = 'on';
+    });
+  }
+
+  /// 返：虚拟屏里的应用后退一层。
+  Future<void> _back() async {
+    // 迁移路径的窗口没有任务记录（taskId=0）：照样发返回，原生按"当前那块虚拟屏"处理。
+    final taskId = _taskId ?? 0;
+    if (_acting) {
+      diagWake('back: ignored (acting=$_acting)');
+      return;
+    }
+    diagWake('back: asking task $taskId');
+    _acting = true;
+    try {
+      // 原生回不来就不要再等：之前 _acting 卡在 true，后面所有点按都被当成"忙"吞掉，
+      // 表现就是"返回键完全没反应"（18:55 日志：asking task 8 之后没有回包）。
+      final result = await ref.read(phoneChannelProvider).previewBack(taskId: taskId).timeout(
+        const Duration(seconds: 4),
+        onTimeout: () => const PhoneGestureResult(false, '返回没有响应（虚拟屏可能不在前台）'),
+      );
+      if (mounted && !result.ok && result.message != null) {
+        showBriefNotice(context, result.message!);
+      }
+    } finally {
+      _acting = false;
+    }
+  }
+
+  /// 允许手动操作打开时，画面上的手指直接落到虚拟屏里（坐标是画面上的比例）。
+  Future<void> _manual(String action) async {
+    final taskId = _taskId;
+    diagWake('manual: action=$action taskId=$taskId acting=$_acting');
+    if (taskId == null || _acting) return;
+    // 格式两种都认：manual:x,y,kind（旧）和 manual:<taskId>:x,y,kind（原生带任务号）。
+    final parts = action.split(':');
+    if (parts.length < 2) return;
+    int? nativeId;
+    String payload;
+    if (parts.length >= 3) {
+      nativeId = int.tryParse(parts[1]);
+      payload = parts.sublist(2).join(':');
+    } else {
+      payload = parts[1];
+    }
+    final id = (nativeId != null && nativeId > 0) ? nativeId : taskId;
+    final values = payload.split(',');
+    if (values.length < 3) return;
+    final x = double.tryParse(values[0]);
+    final y = double.tryParse(values[1]);
+    if (x == null || y == null) return;
+    // 滑动必须带终点：原生校验 swipe 需要 x2/y2，之前没传 → 一律"参数不对"（日志 14:55）。
+    final x2 = values.length > 3 ? double.tryParse(values[3]) : null;
+    final y2 = values.length > 4 ? double.tryParse(values[4]) : null;
+    // 每次点击都按 400ms 按住 → 手感"慢半拍"（用户 19:08）。按动作给真实时长。
+    final duration = switch (values[2]) {
+      'tap' => 40,
+      'long' => 600,
+      _ => 220,
+    };
+    // 点按不再排队等上一次（后到覆盖先到）：轻点被 acting 挡住同样像"慢半拍"。
+    final gated = values[2] != 'tap';
+    if (gated) _acting = true;
+    try {
+      final result = await ref.read(phoneChannelProvider).previewGesture(
+        taskId: id,
+        action: values[2],
+        x: x,
+        y: y,
+        x2: x2,
+        y2: y2,
+        durationMs: duration,
+      );
+      diagWake('manual: ok=${result.ok} msg=${result.message ?? ""}');
+      if (mounted && !result.ok && result.message != null) showBriefNotice(context, result.message!);
+    } catch (e) {
+      diagWake('manual: threw $e');
+    } finally {
+      if (gated) _acting = false;
+    }
+  }
+
+  /// 转（两个方向同一个入口）：[toMain] 把虚拟屏上的应用搬到手机；否则把手机的应用交给 AI。
+  /// 迁完自动切换操作目标，并把视线放回该看的地方（转进虚拟屏 → 对话页 + 悬浮窗）。
+  /// 主屏 → 虚拟屏允许没有现成任务：引擎按需建屏（第二十三节 3）。
+  Future<void> _transfer({required bool toMain, int? taskId}) async {
+    diagWake('transfer: toMain=$toMain requested id=${taskId ?? '-'}');
+    if (_acting) return;
+    // 原生带来的 id 优先；没有才退回状态里的任务。
+    final resolved = taskId ?? _taskId;
+    if (toMain && resolved == null) {
+      if (mounted) showBriefNotice(context, '还没拿到虚拟屏的任务号，稍等一下再试。');
+      return;
+    }
+    _acting = true;
+    try {
+      // 先试系统命令（am task move-task）：与 Mika 依赖系统能力同路，最稳。
+      if (resolved != null) {
+        const windowChannel = MethodChannel('dsh/virtual-screen');
+        final moved = await windowChannel
+                .invokeMethod<bool>('moveTask', {'taskId': resolved, 'toMain': toMain}) ??
+            false;
+        diagWake('transfer: move-task toMain=$toMain ok=$moved');
+        if (moved) {
+          if (!mounted) return;
+          final window = ref.read(virtualWindowProvider.notifier);
+          if (toMain) {
+            // ⇄ 的语义（用户实测的正确行为）：应用搬回主屏 → **整个收窗**（不留空窗/黑窗）
+            // → 出黄球（主屏态，单键）。旧代码只 close + _syncBall()：球要等"默认操作屏=主屏"
+            // 才肯出现，任务号一变 sync 还会把空窗弹回来，屏上就是一块黑。
+            _justTransferredToMain = true;
+            await window.close(suppressTask: resolved);
+            await window.setBall(true);
+            _lastBall = 'on';
+          } else {
+            window.holdOpen();
+            await window.open(resolved);
+          }
+          unawaited(ref.read(phoneProvider.notifier).refreshStatus());
+          return;
+        }
+      }
+      final result = resolved == null
+          ? await ref.read(phoneChannelProvider).handOverFromMain()
+          : await ref.read(phoneChannelProvider).handOverTask(taskId: resolved, toMain: toMain);
+      diagWake('transfer: done toMain=$toMain ok=${result.ok} reason=${result.reason}');
+      if (!mounted) return;
+      if (!result.ok) {
+        showBriefNotice(context, phoneHandOverMessage(result.reason));
+        return;
+      }
+      final window = ref.read(virtualWindowProvider.notifier);
+      if (toMain) {
+        // 同上（⇄）：搬到主屏后窗口必须整个消失，球必须出现；不留"切后台"的空窗。
+        _justTransferredToMain = true;
+        await window.close(suppressTask: taskId ?? resolved);
+        await window.setBall(true);
+        _lastBall = 'on';
+        // 不写设置：迁移只影响这一次的窗口显隐，"默认操作屏"是用户选的，不能被迁移改掉（11:1x）。
+      }
+      // 同上：转回虚拟屏也不改设置。
+      // 等状态刷新完再开窗：新任务要出现在 status 里悬浮窗才知道看谁。
+      try {
+        await ref.read(phoneProvider.notifier).refreshStatus();
+      } on Object {
+        // 状态没刷出来也要继续：窗口下轮 sync 会跟上。
+      }
+      showBriefNotice(context, handOverNotice(PhoneHandOverDone(toMain: toMain, fallback: result.fallback)));
+      if (!toMain) {
+        // 主屏回到对话页，悬浮窗自己弹出来（第十五节）。
+        _bringAppForward();
+        // 迁移这条路不建任务记录，状态里可能是空的；窗口照样要开——传 0 表示"当前那块虚拟屏"。
+        // 同时给 3 秒宽限：迁移刚完成时状态里"当前操作屏"可能还写着主屏，别让 sync 把窗口关掉。
+        window.holdOpen();
+        final next = firstBackgroundTaskId(ref.read(phoneProvider).status);
+        await window.open(next ?? 0);
+      }
+      _syncBall();
+    } finally {
+      _acting = false;
+    }
+  }
+
+  void _bringAppForward() {
+    try {
+      const MethodChannel('dsh/app').invokeMethod<void>('bringToFront');
+    } on Object {
+      // 没有这个通道（测试或别的宿主）就当已经在前面了。
+    }
+  }
+
+  Future<void> _openPage() async {
+    if (_opening || !mounted) return;
+    final window = ref.read(virtualWindowProvider.notifier);
+    final taskId = _taskId;
+    if (taskId == null) return;
+    _opening = true;
+    // 点了窗口，原生那边已经把它收起来；这里的状态跟着归零，页面关掉后再摆回去。
+    await window.close();
+    var handedOver = false;
+    try {
+      final moved = await Navigator.of(context, rootNavigator: true).push(VirtualScreenPage.route(taskId));
+      if (!mounted || moved == null) return;
+      handedOver = true;
+      showBriefNotice(context, handOverNotice(moved));
+    } finally {
+      _opening = false;
+      // 常开：只是看了一眼就回来，窗口摆回去。迁移过的这一次由页面说了算（可能那块屏上
+      // 已经空了，硬摆出来只会是一个黑框）。
+      if (mounted && !handedOver) window.sync(ref.read(phoneProvider).status);
+    }
+  }
+
+  /// 窗口里「返」「转」的有效性：虚拟屏上此刻有没有前台应用（第十二节 2 的表）。
+  void _syncAppState() {
+    final status = ref.read(phoneProvider).status;
+    final hasApp = status.ready && (status.task.app?.isNotEmpty ?? false);
+    final key = hasApp ? 'app' : 'none';
+    if (_lastApp == key) return;
+    _lastApp = key;
+    unawaited(_channel.invokeMethod<void>(
+      'state',
+      {'hasApp': hasApp, 'taskId': firstBackgroundTaskId(ref.read(phoneProvider).status) ?? 0},
+    ));
+  }
+
+  /// 主屏的「转」：App 不在前台时出现——有虚拟屏任务在跑（窗口在），或虚拟屏通道可用（随时
+  /// 能把主屏当前应用转进去）；桌面 / 本 App 在前面时球自己会藏起来（第十四节 1 反向切换）。
+  void _syncBall() {
+    final open = ref.read(virtualWindowProvider).open;
+    // 只在「主屏操作 + 刚转过主屏（或虚拟屏窗口开着）」时显示。
+    // 之前用 task.active / channelReady 当条件：只要有个任务在跑，打开任何应用球都弹出来，
+    // 用户 10:36 反馈「球跟随一些应用出现」。现在没有转场或窗口就不弹。
+    // 但"刚把应用搬回主屏"（⇄）和"点了【切换】正在等画面"这两种情况，球是屏幕上唯一的入口，
+    // 不管默认操作屏设成什么都不许收。
+    final onMain = ref.read(virtualScreenSettingsProvider).target == VirtualScreenTarget.main;
+    final waiting = vscreenAwaitPictureUntil != null;
+    // 窗口开着 → 只在主屏操作时出球（原样）；窗口不在 → 只有"刚搬回主屏"或"正等画面"才出球。
+    final want = !_foreground && (open ? onMain : (waiting || _justTransferredToMain));
+    final key = want ? 'on' : 'off';
+    if (_lastBall == key) return;
+    _lastBall = key;
+    unawaited(ref.read(virtualWindowProvider.notifier).setBall(want));
+  }
+
+  @override
+  Widget build(BuildContext context) {
+    ref.watch(virtualWindowProvider);
+    final taskActive = ref.watch(phoneProvider.select((s) => s.status.task.active));
+    WidgetsBinding.instance.addPostFrameCallback((_) {
+      if (!mounted) return;
+      if (!taskActive) _justTransferredToMain = false;
+      _syncBall();
+    });
+    ref.watch(phoneProvider.select((s) => s.status.task.app));
+    WidgetsBinding.instance.addPostFrameCallback((_) {
+      if (!mounted) return;
+      _syncBall();
+      _syncAppState();
+    });
+    return const SizedBox.shrink();
+  }
+}
