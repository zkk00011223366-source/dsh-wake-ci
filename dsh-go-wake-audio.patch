index 0000000..adebc52
--- /dev/null
+++ b/app/lib/ui/phone/virtual_screen_surface.dart
@@ -0,0 +1,286 @@
+import 'dart:async';
+import 'dart:math' as math;
+import 'dart:ui' as ui;
+
+import 'package:flutter/material.dart';
+import 'package:flutter/services.dart';
+
+import '../../l10n/l10n.dart';
+import '../../phone/phone_channel.dart';
+
+/// 虚拟屏的画面本身：订阅虚拟屏的帧、解码、画出来，并把手指的点/长按/滑动换成对那块屏的
+/// 手势。放大预览的对话框和可操作的虚拟屏页面用的是同一个它，所以两处看到的是同一条画面、
+/// 同一套手势。
+class VirtualScreenSurface extends StatefulWidget {
+  const VirtualScreenSurface({
+    required this.channel,
+    required this.taskId,
+    this.enabled = true,
+    this.onGestureBusy,
+    this.onGestureResult,
+    super.key,
+  });
+
+  final PhoneChannel channel;
+  final int taskId;
+
+  /// 通道/页面还能用吗（预览被关掉、页面被别的页盖住时不再订阅）。
+  final bool enabled;
+
+  /// 一次手势正在路上：调用方据此先别做别的（迁移会挪走这块屏）。
+  final ValueChanged<bool>? onGestureBusy;
+
+  /// 手势的结果，没发出去时带着原因。
+  final ValueChanged<PhoneGestureResult>? onGestureResult;
+
+  @override
+  State<VirtualScreenSurface> createState() => _VirtualScreenSurfaceState();
+}
+
+class _VirtualScreenSurfaceState extends State<VirtualScreenSurface> {
+  late final AppLifecycleListener _lifecycle;
+  StreamSubscription<PhonePreviewFrame?>? _subscription;
+  Future<void> _transition = Future.value();
+  bool _resumed = false;
+  bool _routeCurrent = false;
+  bool _visible = false;
+  int _epoch = 0;
+  int _imageRevision = 0;
+  int _nativeGeneration = -1;
+  int _nativeSequence = -1;
+  String _state = 'waiting';
+  ui.Image? _image;
+  PhonePreviewFrame? _pending;
+  bool _decoding = false;
+  // 手动点滑: a drag's two ends, and one gesture in flight at a time.
+  Offset? _swipeFrom;
+  Offset? _swipeLast;
+  bool _gestureBusy = false;
+
+  @override
+  void initState() {
+    super.initState();
+    _resumed = WidgetsBinding.instance.lifecycleState == AppLifecycleState.resumed;
+    _lifecycle = AppLifecycleListener(onStateChange: (state) {
+      _resumed = state == AppLifecycleState.resumed;
+      _syncVisibility();
+    });
+  }
+
+  @override
+  void didChangeDependencies() {
+    super.didChangeDependencies();
+    // ModalRoute.of establishes a dependency on isCurrent; a covering route stops capture.
+    _routeCurrent = ModalRoute.of(context)?.isCurrent == true;
+    _syncVisibility();
+  }
+
+  @override
+  void didUpdateWidget(VirtualScreenSurface oldWidget) {
+    super.didUpdateWidget(oldWidget);
+    if (oldWidget.enabled != widget.enabled || oldWidget.taskId != widget.taskId) _syncVisibility();
+  }
+
+  void _clearImage() {
+    _imageRevision++;
+    _pending = null;
+    final old = _image;
+    _image = null;
+    old?.dispose();
+  }
+
+  Future<void> _cancelSubscription() async {
+    final old = _subscription;
+    _subscription = null;
+    try {
+      await old?.cancel();
+    } on MissingPluginException {
+      // A detached native engine has no remaining consumer to remove.
+    } on PlatformException {
+      // Native task/engine retirement also clears its preview consumer.
+    }
+  }
+
+  void _syncVisibility() {
+    final visible = widget.enabled && _resumed && _routeCurrent;
+    if (_visible == visible) return;
+    _visible = visible;
+    final epoch = ++_epoch;
+    _clearImage();
+    _nativeGeneration = -1;
+    _nativeSequence = -1;
+    if (mounted) setState(() => _state = 'waiting');
+    // Wait for the old EventChannel cancel before listening again on the same channel.
+    _transition = _transition.then((_) async {
+      await _cancelSubscription();
+      if (!mounted || !_visible || _epoch != epoch) return;
+      _subscription = widget.channel.previewFrames(widget.taskId).listen(
+        (frame) {
+          if (mounted && _visible && _epoch == epoch) _receive(frame);
+        },
+        onError: (Object _) {
+          if (!mounted || !_visible || _epoch != epoch) return;
+          _clearImage();
+          setState(() => _state = 'unavailable');
+        },
+      );
+    });
+  }
+
+  void _receive(PhonePreviewFrame? frame) {
+    if (frame == null) {
+      _clearImage();
+      setState(() => _state = 'unavailable');
+      return;
+    }
+    if (frame.taskId != widget.taskId ||
+        frame.generation < _nativeGeneration ||
+        frame.generation == _nativeGeneration && frame.sequence <= _nativeSequence) {
+      return;
+    }
+    if (frame.generation != _nativeGeneration) {
+      _clearImage();
+      setState(() => _state = 'waiting');
+    }
+    _nativeGeneration = frame.generation;
+    _nativeSequence = frame.sequence;
+    if (frame.state != 'frame') {
+      _clearImage();
+      setState(() => _state = frame.state);
+      return;
+    }
+    _pending = frame; // one latest pending frame; a slow decoder never accumulates a queue
+    unawaited(_decodeLatest());
+  }
+
+  Future<void> _decodeLatest() async {
+    if (_decoding) return;
+    _decoding = true;
+    try {
+      while (_pending != null) {
+        final frame = _pending!;
+        _pending = null;
+        final epoch = _epoch;
+        final revision = _imageRevision;
+        ui.Codec? codec;
+        ui.Image? decoded;
+        try {
+          codec = await ui.instantiateImageCodec(frame.imageBytes!,
+              targetWidth: frame.width, targetHeight: frame.height, allowUpscaling: false);
+          decoded = (await codec.getNextFrame()).image;
+        } catch (_) {
+          // No exception details or image bytes enter logs or diagnostics.
+          if (mounted && _visible && _epoch == epoch && _imageRevision == revision && _pending == null) {
+            _clearImage();
+            setState(() => _state = 'unavailable');
+          }
+        } finally {
+          codec?.dispose();
+        }
+        if (decoded == null) continue;
+        if (!mounted || !_visible || _epoch != epoch || _imageRevision != revision) {
+          decoded.dispose();
+          continue;
+        }
+        final old = _image;
+        setState(() {
+          _image = decoded;
+          _state = 'frame';
+        });
+        old?.dispose();
+      }
+    } finally {
+      _decoding = false;
+    }
+  }
+
+  @override
+  void dispose() {
+    _visible = false;
+    _epoch++;
+    _clearImage();
+    _lifecycle.dispose();
+    _transition = _transition.then((_) => _cancelSubscription());
+    super.dispose();
+  }
+
+  /// 手动点滑: where a touch landed, as a fraction of the picture (0..1). Native maps the
+  /// fraction onto the virtual screen, so the preview's scaled-down size never matters. The
+  /// letterbox around a letter-shaped screen is not a target, so a touch there is dropped.
+  Offset? _toPictureFraction(Offset local, Size box, {bool clamp = false}) {
+    final image = _image;
+    if (image == null || image.width <= 0 || image.height <= 0) return null;
+    final iw = image.width.toDouble(), ih = image.height.toDouble();
+    final scale = math.min(box.width / iw, box.height / ih);
+    if (!scale.isFinite || scale <= 0) return null;
+    final left = (box.width - iw * scale) / 2, top = (box.height - ih * scale) / 2;
+    final x = (local.dx - left) / scale / iw, y = (local.dy - top) / scale / ih;
+    if (clamp) return Offset(x.clamp(0.0, 1.0).toDouble(), y.clamp(0.0, 1.0).toDouble());
+    if (x < 0 || y < 0 || x >= 1 || y >= 1) return null;
+    return Offset(x, y);
+  }
+
+  /// One gesture on the enlarged picture: the finger is the consent, native takes a fresh
+  /// observation and injects it into the virtual screen.
+  Future<void> _gesture(String action, Offset from, Size box, {Offset? to}) async {
+    if (_gestureBusy) return;
+    final start = _toPictureFraction(from, box);
+    // A swipe that leaves the picture still ends at its edge, not nowhere.
+    final end = to == null ? null : _toPictureFraction(to, box, clamp: true);
+    if (start == null || action == 'swipe' && end == null) return;
+    setState(() => _gestureBusy = true);
+    widget.onGestureBusy?.call(true);
+    final result = await widget.channel.previewGesture(
+      taskId: widget.taskId,
+      action: action,
+      x: start.dx,
+      y: start.dy,
+      x2: end?.dx,
+      y2: end?.dy,
+      durationMs: action == 'swipe' ? 300 : 400,
+    );
+    if (!mounted) return;
+    setState(() => _gestureBusy = false);
+    widget.onGestureBusy?.call(false);
+    widget.onGestureResult?.call(result);
+  }
+
+  @override
+  Widget build(BuildContext context) {
+    final l10n = context.l10n;
+    final image = _image;
+    if (image == null) {
+      return Center(
+        child: Text(switch (_state) {
+          'off' => l10n.phonePreviewOff,
+          'inUse' => l10n.phonePreviewInUse,
+          'unavailable' || 'protected' => l10n.phonePreviewUnavailable,
+          _ => l10n.phonePreviewWaiting,
+        }, textAlign: TextAlign.center),
+      );
+    }
+    return LayoutBuilder(
+      builder: (context, box) {
+        final size = Size(box.maxWidth, box.maxHeight);
+        return GestureDetector(
+          behavior: HitTestBehavior.opaque,
+          onTapUp: (d) => unawaited(_gesture('tap', d.localPosition, size)),
+          onLongPressStart: (d) => unawaited(_gesture('long', d.localPosition, size)),
+          onPanStart: (d) {
+            _swipeFrom = d.localPosition;
+            _swipeLast = d.localPosition;
+          },
+          onPanUpdate: (d) => _swipeLast = d.localPosition,
+          onPanEnd: (_) {
+            final from = _swipeFrom;
+            final to = _swipeLast;
+            _swipeFrom = null;
+            _swipeLast = null;
+            if (from != null && to != null) unawaited(_gesture('swipe', from, size, to: to));
+          },
+          child: RawImage(image: image, fit: BoxFit.contain, filterQuality: FilterQuality.low),
+        );
+      },
+    );
+  }
+}
