@@ -0,0 +1,39 @@
+package io.github.ccch1mneyyy.dsh_app.wake
+
+import java.io.File
+import java.text.SimpleDateFormat
+import java.util.Date
+import java.util.Locale
+
+/**
+ * 唤醒 / AI 键 的原生轨迹，写进 Dart 侧 diagWake 的同一个文件
+ * (`/sdcard/Download/DSH-Go/wake-debug.log`)：`.wake-log` 存在时才写，写不进去就算了。
+ *
+ * 存在的意义只有一个：一条 AI 键从系统意图到 Dart 的每一步都能在日志里看到，少一步就是
+ * 那一步断了（之前只有 Dart 侧的轨迹，所以「按了没反应」看不出断在原生哪一段）。
+ */
+object WakeTrace {
+    private const val DIR = "/sdcard/Download/DSH-Go"
+    private val marker = File(DIR, ".wake-log")
+    private val file = File(DIR, "wake-debug.log")
+
+    @Volatile private var on: Boolean? = null
+
+    fun log(message: String) {
+        try {
+            if (on != true) {
+                if (!marker.exists()) return
+                on = true
+            }
+            file.appendText(stamp() + " " + message + "\n")
+        } catch (_: Throwable) {
+            // No marker, no storage: the trace is best effort.
+        }
+    }
+
+    private fun stamp(): String = try {
+        SimpleDateFormat("HH:mm:ss.SSS", Locale.US).format(Date())
+    } catch (_: Throwable) {
+        "--:--:--.---"
+    }
+}
