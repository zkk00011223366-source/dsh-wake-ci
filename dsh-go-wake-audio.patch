+  VirtualScreenWindow get _frames => _window ??= VirtualScreenWindow(ref.read(phoneChannelProvider));
+
+  /// 正在开/关：状态推送会把 [sync] 再叫一次，别让它把同一件事排队做两遍。
+  bool _busy = false;
