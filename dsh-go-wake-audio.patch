+package io.github.ccch1mneyyy.dsh_app.phone.vscreen
+
+import android.content.Context
+import android.os.Handler
+import android.os.Looper
+import io.flutter.embedding.engine.plugins.FlutterPlugin
+import io.flutter.plugin.common.MethodCall
+import io.github.ccch1mneyyy.dsh_app.phone.PhoneRegistry
+import io.github.ccch1mneyyy.dsh_app.phone.PhoneScreen
+import io.github.ccch1mneyyy.dsh_app.phone.VsreenTaskMark
+import io.flutter.plugin.common.MethodChannel
+
+/**
+ * 虚拟屏 悬浮窗 的通道。
+ *
+ *   dsh/virtual-screen  show { taskId } -> bool · hide · frame { bytes } -> bool
+ *   dsh/virtual-screen  wantsFrames -> bool
+ *   dsh/virtual-screen  state { hasApp, taskId? }：「返」「转」的有效性 + 任务号
+ *   dsh/virtual-screen  retask { taskId }：窗口不重建，只换任务号
+ *   dsh/virtual-screen  action：窗口自己不动手的那几件事，交给 App 做
+ *                      open | stop | back | toMain | manual:<x>,<y>,tap
+ *   dsh/virtual-screen  ball { on } -> bool：主屏上的吸附式悬浮球（转进虚拟屏）
+ */
+class VirtualScreenPlugin : FlutterPlugin, MethodChannel.MethodCallHandler {
+    private var channel: MethodChannel? = null
+    private var context: Context? = null
+    /** move-task 在后台线程跑，回包必须回主线程（MethodChannel 的约定）。 */
+    private val main = Handler(Looper.getMainLooper())
+
+    override fun onAttachedToEngine(binding: FlutterPlugin.FlutterPluginBinding) {
+        context = binding.applicationContext
+        val ch = MethodChannel(binding.binaryMessenger, CHANNEL)
+        ch.setMethodCallHandler(this)
+        channel = ch
+        VirtualScreenOverlay.onAction = { action -> ch.invokeMethod("action", action) }
+        TransferBall.onAction = { action -> ch.invokeMethod("action", action) }
+        // 切换前台胶囊：选择结果回给 Dart（manual / ai）。
+        SwitchPromptOverlay.onPick = { pick -> ch.invokeMethod("action", "prompt:$pick") }
+    }
+
+    override fun onDetachedFromEngine(binding: FlutterPlugin.FlutterPluginBinding) {
+        VirtualScreenOverlay.onAction = null
+        TransferBall.onAction = null
+        SwitchPromptOverlay.onPick = null
+        VirtualScreenOverlay.hide()
+        // 球自己每 2 秒看一眼主屏：通道没了就一起停，别留一个没人处理的球。
+        TransferBall.setWanted(false)
+        channel?.setMethodCallHandler(null)
+        channel = null
+        context = null
+    }
+
+    override fun onMethodCall(call: MethodCall, result: MethodChannel.Result) {
+        val app = context
+        when (call.method) {
+            "show" -> {
+                if (app == null) {
+                    result.success(false)
+                    return
+                }
+                val taskId = (call.argument<Number>("taskId"))?.toLong() ?: 0L
+                val shown = VirtualScreenOverlay.show(app, taskId)
+                // 窗口一开就占住这块屏（A 方案），任务收尾也不会把屏销毁。
+                if (shown) PhoneRegistry.holdDisplayForWindow?.invoke(true)
+                result.success(shown)
+            }
+            "moveTask" -> {
+                // am task move-task <id> <displayId|0>：系统命令直接搬任务，比引擎 handOver 稳。
+                val taskId = (call.argument<Number>("taskId"))?.toLong() ?: 0L
+                val toMain = call.argument<Boolean>("toMain") == true
+                val target = if (toMain) 0 else VirtualScreenOverlay.currentDisplayId()
+                if (taskId <= 0 || (!toMain && target <= 0)) {
+                    result.success(false)
+                    return
+                }
+                // I：这条命令是阻塞的（几十到几百毫秒）。以前在 Flutter 主线程上直接跑，
+                // 一点【切换】整个界面就卡住，随后被系统判 ANR 直接闪退。
+                // 现在放到后台线程，回包再回主线程；任何异常都不许上抛。
+                val live = VirtualScreenOverlay.isSurfaceLive()
