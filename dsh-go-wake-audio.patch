+                        }
+                    } else {
+                        WakeTrace.log("window: not live yet, stay hidden")
+                    }
+                }, wait)
+            }
+            else if (surface != null) scheduleSurfaceRetry(app, gen)
+            main.post {
+                applyAspect()
+                applyLive()
+            }
+        }
+    }
