@@ -0,0 +1,114 @@
+import 'dart:async';
+
+import 'package:flutter/material.dart';
+import 'package:flutter_riverpod/flutter_riverpod.dart';
+
+import '../../state/phone_state.dart';
+import '../../state/virtual_screen_state.dart';
+import 'background_preview.dart' show PhoneHandOverDone, phoneHandOverMessage;
+import 'virtual_screen_surface.dart';
+
+/// 可操作的虚拟屏：整页，不是弹窗。手指点/长按/滑动直接作用于虚拟屏上的应用，底下两个动作
+/// ——「切到主屏」把这块屏上的应用交回手机，「交给 AI（虚拟屏）」把主屏上的应用搬过来。
+class VirtualScreenPage extends ConsumerStatefulWidget {
+  const VirtualScreenPage({required this.taskId, super.key});
+
+  final int taskId;
+
+  static Route<PhoneHandOverDone> route(int taskId) => MaterialPageRoute<PhoneHandOverDone>(
+    builder: (_) => VirtualScreenPage(taskId: taskId),
+  );
+
+  @override
+  ConsumerState<VirtualScreenPage> createState() => _VirtualScreenPageState();
+}
+
+class _VirtualScreenPageState extends ConsumerState<VirtualScreenPage> {
+  bool _gestureBusy = false;
+  bool _handOverBusy = false;
+  String? _error;
+
+  /// 任务迁移：成功后收起悬浮窗、把操作目标交给应用所在的屏，再把这一页关掉。
+  Future<void> _handOver({required bool toMain}) async {
+    if (_handOverBusy || _gestureBusy) return;
+    setState(() {
+      _handOverBusy = true;
+      _error = null;
+    });
+    final result = await ref.read(phoneChannelProvider).handOverTask(taskId: widget.taskId, toMain: toMain);
+    if (!mounted) return;
+    setState(() => _handOverBusy = false);
+    if (!result.ok) {
+      setState(() => _error = phoneHandOverMessage(result.reason));
+      return;
+    }
+    await ref.read(virtualWindowProvider.notifier).close();
+    unawaited(ref.read(virtualScreenSettingsProvider.notifier)
+        .setTarget(toMain ? VirtualScreenTarget.main : VirtualScreenTarget.virtual));
+    unawaited(ref.read(phoneProvider.notifier).refreshStatus());
+    if (mounted) {
+      Navigator.of(context).pop(PhoneHandOverDone(toMain: toMain, fallback: result.fallback));
+    }
+  }
+
+  @override
+  Widget build(BuildContext context) {
+    final ready = ref.watch(phoneProvider.select((s) => s.status.ready));
+    return Scaffold(
+      appBar: AppBar(title: const Text('虚拟屏')),
+      body: SafeArea(
+        child: Column(
+          children: [
+            Expanded(
+              child: ColoredBox(
+                color: const Color(0xFF070911),
+                child: VirtualScreenSurface(
+                  channel: ref.read(phoneChannelProvider),
+                  taskId: widget.taskId,
+                  enabled: ready,
+                  onGestureBusy: (busy) {
+                    if (mounted) setState(() => _gestureBusy = busy);
+                  },
+                  onGestureResult: (result) {
+                    if (!mounted) return;
+                    setState(() => _error = result.ok ? null : (result.message ?? '这次手势没有发出去。'));
+                  },
+                ),
+              ),
+            ),
+            Padding(
+              padding: const EdgeInsets.fromLTRB(16, 8, 16, 4),
+              child: Text(
+                _error ?? '直接用手指点、长按、滑动这块屏；改动的是虚拟屏上的应用。',
+                maxLines: 3,
+                style: Theme.of(context).textTheme.bodySmall?.copyWith(
+                  color: _error == null
+                      ? Theme.of(context).colorScheme.onSurfaceVariant
+                      : Theme.of(context).colorScheme.error,
+                ),
+              ),
+            ),
+            Padding(
+              padding: const EdgeInsets.fromLTRB(8, 0, 8, 8),
+              child: Row(
+                mainAxisAlignment: MainAxisAlignment.end,
+                children: [
+                  TextButton(
+                    key: const ValueKey('virtual-screen-to-main'),
+                    onPressed: _handOverBusy || _gestureBusy ? null : () => unawaited(_handOver(toMain: true)),
+                    child: const Text('切到主屏'),
+                  ),
+                  TextButton(
+                    key: const ValueKey('virtual-screen-to-virtual'),
+                    onPressed: _handOverBusy || _gestureBusy ? null : () => unawaited(_handOver(toMain: false)),
+                    child: const Text('交给 AI（虚拟屏）'),
+                  ),
+                ],
+              ),
+            ),
+          ],
+        ),
+      ),
+    );
+  }
+}
