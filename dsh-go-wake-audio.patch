+++ b/app/android/app/src/test/kotlin/io/github/ccch1mneyyy/dsh_app/phone/vscreen/FrameMathTest.kt
@@ -0,0 +1,45 @@
+package io.github.ccch1mneyyy.dsh_app.phone.vscreen
+
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+/** 判黑/判变的边界：均匀取样、99.5% 阈值、变化格数下限。 */
+class FrameMathTest {
+    private fun solid(argb: Int): (Int, Int) -> Int = { _, _ -> argb }
+
+    @Test
+    fun allBlackFrameIsBlack() {
+        assertTrue(FrameMath.isBlack(720, 1600, solid(0xFF000000.toInt())))
+    }
+
+    @Test
+    fun oneBrightPointIsEnoughToNotBeBlack() {
+        // 24×24 取样共 576 点，99.5% ≈ 573.1：允许 2 个点不黑，第 3 个就翻。
+        val bright = (0 until 3).toSet()
+        var i = 0
+        val pixel: (Int, Int) -> Int = { _, _ -> if (i++ in bright) 0xFFFFFFFF.toInt() else 0xFF000000.toInt() }
+        assertFalse(FrameMath.isBlack(100, 100, pixel))
+    }
+
+    @Test
+    fun invalidSizeIsNeverBlack() {
+        assertFalse(FrameMath.isBlack(1, 1, solid(0xFF000000.toInt())))
+    }
+
+    @Test
+    fun smallLocalChangeIsNotAPageChange() {
+        val a = IntArray(FrameMath.GRID_W * FrameMath.GRID_H) { 10 }
+        val b = a.copyOf().also { it[0] = 200 }
+        assertFalse(FrameMath.differs(a, b))
+        assertFalse(FrameMath.pageChanged(a, b))
+    }
+
+    @Test
+    fun wholePageChangeIsDetected() {
+        val a = IntArray(FrameMath.GRID_W * FrameMath.GRID_H) { 10 }
+        val b = IntArray(FrameMath.GRID_W * FrameMath.GRID_H) { 200 }
+        assertTrue(FrameMath.differs(a, b))
+        assertTrue(FrameMath.pageChanged(a, b))
+    }
+}
