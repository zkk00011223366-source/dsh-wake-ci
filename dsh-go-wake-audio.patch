+    /** 虚拟屏的宽高比（高/宽）；还不知道尺寸时用 110×196 的默认竖屏比例。 */
+    /**
+     * 窗口宽高比 = 虚拟屏的宽高比。虚拟屏是按手机屏幕比例建的（短边固定 720），
+     * 所以"标准"就是手机屏幕的比例：竖屏用 高/宽，横屏用 宽/高。
+     * 屏的真实尺寸还没拿到时用这个算，不再靠"上次的值"。
+     */
+    /** 底边把手：14dp 高，完全落在卡片外面（不遮挡画面）。 */
+    private fun gripHeight(px: Float): Int = (14 * px).roundToInt()
+
+    private fun aspect(): Float =
+        // 比例永远跟虚拟屏真实尺寸走：用户在设置里选"横屏"时窗口就该是横的
+        // （08:51 确认横屏是用户设置，不能按手机方向掰正）。
+        // 旋转由 DisplayFrameGeometry 统一处理（唯一来源），别在这里再各自算一份。
+        geometry().aspect.takeIf { it > 0f } ?: screenAspect()
