+// 语音唤醒的开关与偏好（设置 › 语音 › 语音唤醒）。
+//
+// What listening does lives in voice/wake_word.dart; this file only holds what the person
+// chose, the way the other speech settings do (speech/speech_settings.dart).
+
+import 'dart:convert';
+
+import 'package:flutter_riverpod/flutter_riverpod.dart';
+import 'package:shared_preferences/shared_preferences.dart';
+
+class WakeSettings {
+  const WakeSettings({
+    this.enabled = false,
+    this.keyword = defaultKeyword,
+    this.chime = true,
+    this.vibrate = true,
+    this.freshChat = false,
+    this.reply = defaultReply,
+    this.energyDb = defaultEnergyDb,
+  });
+
+  /// 小志小志: what the phone answers to until the person types another phrase.
+  static const defaultKeyword = '小志小志';
+
+  /// 唤醒后立刻说出的第一句话：用户可改，默认「我在」。
+  static const defaultReply = '我在';
+
+  /// 唤醒能量门槛（dBFS）：越接近 0 越难触发，越低越灵敏。
+  /// 嘈杂环境（电视在响）调低到 -55 ~ -60；安静环境保持 -40 即可。
+  static const defaultEnergyDb = -40.0;
+
+  /// 常驻监听：the microphone foreground service runs with the screen off.
+  final bool enabled;
+
+  /// 唤醒词：matched inside what the recognizer heard, punctuation and spaces ignored.
+  final String keyword;
+
+  /// 唤醒时的一声提示音。
+  final bool chime;
+
+  /// 唤醒时的一下震动。
+  final bool vibrate;
+
+  /// 唤醒后开一个新对话，而不是接着上次那个。唤醒词和 AI 键共用这一条。
+  final bool freshChat;
+
+  /// 唤醒回应：喊完立刻说的那句话（不等模型）。用户可在设置里自定。
+  final String reply;
+
+  /// 能量门槛：只在"靠能量判断有没有人说话"时使用，越低越灵敏。
+  final double energyDb;
+
+  WakeSettings copyWith({bool? enabled, String? keyword, bool? chime, bool? vibrate, bool? freshChat, String? reply, double? energyDb}) =>
+      WakeSettings(
+        enabled: enabled ?? this.enabled,
+        keyword: keyword ?? this.keyword,
+        chime: chime ?? this.chime,
+        vibrate: vibrate ?? this.vibrate,
+        freshChat: freshChat ?? this.freshChat,
+        reply: reply ?? this.reply,
+        energyDb: energyDb ?? this.energyDb,
+      );
+}
+
+class WakeSettingsController extends Notifier<WakeSettings> {
+  static const _key = 'speech_wake_v1';
+  late Future<void> _loaded;
+
+  @override
+  WakeSettings build() {
+    _loaded = _load();
+    return const WakeSettings();
+  }
+
+  Future<void> _load() async {
+    try {
+      final prefs = await SharedPreferences.getInstance();
+      final raw = prefs.getString(_key);
+      final json = raw == null ? null : jsonDecode(raw);
+      if (json is! Map || !ref.mounted) return;
+      state = WakeSettings(
+        enabled: json['enabled'] == true,
+        keyword: json['keyword'] is String && (json['keyword'] as String).trim().isNotEmpty
+            ? (json['keyword'] as String).trim()
+            : WakeSettings.defaultKeyword,
+        chime: json['chime'] != false,
+        vibrate: json['vibrate'] != false,
+        freshChat: json['freshChat'] == true,
+        reply: json['reply'] is String && (json['reply'] as String).trim().isNotEmpty
+            ? (json['reply'] as String).trim()
+            : WakeSettings.defaultReply,
+        energyDb: json['energyDb'] is num
+            ? (json['energyDb'] as num).toDouble().clamp(-70.0, -20.0)
+            : WakeSettings.defaultEnergyDb,
+      );
+    } on Object {
+      // Defaults for this run.
+    }
+  }
+
+  /// The settings once the saved ones have been read.
+  Future<WakeSettings> ready() async {
+    await _loaded;
+    return state;
+  }
+
+  /// [change] applied to the saved settings once they are in (not to the defaults shown before).
+  Future<void> edit(WakeSettings Function(WakeSettings saved) change) async {
+    await _loaded;
+    if (ref.mounted) await _keep(change(state));
+  }
+
+  Future<void> _keep(WakeSettings next) async {
+    state = next;
+    final prefs = await SharedPreferences.getInstance();
+    await prefs.setString(
+      _key,
+      jsonEncode({
+        'enabled': next.enabled,
+        'keyword': next.keyword,
+        'chime': next.chime,
+        'vibrate': next.vibrate,
+        'freshChat': next.freshChat,
+        'reply': next.reply,
+        'energyDb': next.energyDb,
+      }),
+    );
+  }
+}
+
+final wakeSettingsProvider = NotifierProvider<WakeSettingsController, WakeSettings>(WakeSettingsController.new);
