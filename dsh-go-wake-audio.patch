+                        main.postDelayed(press, 500)
+                    }
+                    true
+                }
+                MotionEvent.ACTION_MOVE -> {
+                    val dx = event.rawX - startX
+                    val dy = event.rawY - startY
+                    moved = if (abs(dx) > abs(dy)) abs(dx) else abs(dy)
+                    if (windowGrab) {
+                        if (!dragging && moved > 6 * px) {
