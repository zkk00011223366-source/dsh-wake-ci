+    // 唤醒后开新对话 or 接着上次：one setting, used by the wake word and by the AI key alike.
+    // Only a wake/shortcut call (a phrase was given) starts fresh; a tap on 通话 keeps the
+    // conversation the person is looking at.
+    final fresh = wakePhrase != null && (await ref.read(wakeSettingsProvider.notifier).ready()).freshChat;
+    if (fresh && mounted) {
+      final made = await ref.read(sessionsProvider.notifier).create();
+      if (!mounted) {
+        unawaited(wake.resume());
+        return;
+      }
+      ref.read(currentSessionProvider.notifier).select(made);
+    }
     final sessionId = ref.read(currentSessionProvider);
     final listed = sessionId == null ? null : ref.read(chatProvider(sessionId)).title;
     final title = listed != null && listed.trim().isNotEmpty ? chatTitleShown(listed.trim()) : appL10n.commonNewChat;
     // The call stays with the conversation it began in, whatever is opened meanwhile.
     var pinned = sessionId;
-    // 唤醒词 goes in before the call opens, not from inside the call's session closure:
-    // that closure only runs when something is sent, and a call waiting for the person to
-    // speak sends nothing — which is why a wake opened a silent page. What the microphone
-    // had just heard (the wake phrase and anything said with it) wins when it says more.
-    if (wakePhrase != null && wakePhrase.trim().isNotEmpty) {
-      final id = pinned ?? await _ensureSession(isCurrent: () => mounted);
-      if (id == null) {
-        unawaited(wake.resume());
-        return;
-      }
-      pinned = id;
-      var text = wakePhrase;
-      final heard = await ref.read(wakeWordProvider.notifier).takeWakeUtterance();
-      if (heard != null && heard.trim().length >= wakePhrase.trim().length) text = heard;
-      await ref.read(chatProvider(id).notifier).send(text.trim());
-    }
     unawaited(
       openChatCall(
         context,
@@ -1561,6 +1557,26 @@ class _ChatScreenState extends ConsumerState<ChatScreen> with WidgetsBindingObse
         unawaited(wake.resume());
       }),
     );
+    // 唤醒词 after the page is up: the call must open whatever the send does — a wake that
+    // only produced a text reply was a call that never opened because the send threw first.
+    if (wakePhrase != null && wakePhrase.trim().isNotEmpty) {
+      final id = pinned ?? await _ensureSession(isCurrent: () => mounted);
+      if (id != null) {
+        pinned = id;
+        var text = wakePhrase;
+        try {
+          final heard = await ref.read(wakeWordProvider.notifier).takeWakeUtterance();
+          if (heard != null && heard.trim().length >= wakePhrase.trim().length) text = heard;
+        } on Object {
+          // The phrase as configured is enough.
+        }
+        try {
+          await ref.read(chatProvider(id).notifier).send(text.trim());
+        } on Object {
+          // Said silently: the call is already open and the person can speak.
+        }
+      }
+    }
   }
 
   /// The stop key; what waits in the inbox goes right away (see
