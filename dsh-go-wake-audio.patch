+
+enum VirtualScreenTarget { main, background, virtual }
+
+final virtualScreenSettingsProvider =
+    NotifierProvider<VirtualScreenSettingsController, VirtualScreenSettings>(VirtualScreenSettingsController.new);
+
+/// 球当前是否被我们要求在场（只在变化时下发，避免每帧都过桥）。
+bool _ballOn = false;
+
+class VirtualScreenSettingsController extends Notifier<VirtualScreenSettings> {
+  static const _fpsKey = 'virtual_screen_fps';
+  static const _qualityKey = 'virtual_screen_quality';
+  static const _targetKey = 'virtual_screen_target';
+  static const _windowKey = 'virtual_screen_window';
+  static const _manualKey = 'virtual_screen_manual';
+
+  @override
+  VirtualScreenSettings build() {
+    unawaited(_load());
+    return const VirtualScreenSettings();
+  }
+
+  Future<void> _load() async {
+    try {
+      final prefs = await SharedPreferences.getInstance();
+      if (!ref.mounted) return;
+      final fps = prefs.getInt(_fpsKey);
+      final quality = prefs.getInt(_qualityKey);
+      final target = prefs.getString(_targetKey);
+      state = VirtualScreenSettings(
+        fps: fps == null ? state.fps : fps.clamp(1, 15),
+        quality: quality == null ? state.quality : quality.clamp(40, 100),
+        target: VirtualScreenTarget.values.asNameMap()[target] ?? state.target,
+        window: prefs.getBool(_windowKey) ?? state.window,
+        manual: prefs.getBool(_manualKey) ?? state.manual,
+      );
+    } catch (_) {}
+  }
