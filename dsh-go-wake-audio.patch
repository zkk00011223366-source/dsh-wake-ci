+import io.github.ccch1mneyyy.dsh_app.phone.background.BackgroundControl
+import java.util.concurrent.Executors
+import kotlin.math.roundToInt
+
+/**
+ * 返回键拦截（第十六节 A）: while the assistant drives the phone's own screen, the person's back key
+ * asks what to do instead of just going back.
+ *
+ *      AI 正在操作，要怎么继续？
+ *        [ 手动接管 ]   [ 转到虚拟屏继续 ]
+ *
+ * 手动接管 stops the task and lets the back go through. 转到虚拟屏继续 lets the back go through
+ * as well (the person gets the screen they wanted) and moves the task to the background display,
+ * where the floating window keeps showing it. When the assistant is idle, or works on the
+ * virtual screen, the key is not touched at all.
+ */
+object PhoneBackGuard {
+    private val main = Handler(Looper.getMainLooper())
+    private val worker = Executors.newSingleThreadExecutor { r -> Thread(r, "dsh-back-guard").apply { isDaemon = true } }
+
+    private var card: View? = null
+    private var service: AccessibilityService? = null
+    private var lastShownAt = 0L
+
+    /** The back key asks only while the assistant is driving the phone's own screen (第二十节). */
+    fun armed(): Boolean = PhoneRegistry.mainTaskActive
+
+    /** Shows the question, or folds an already-open one: one card, never a stack. */
+    fun ask(service: AccessibilityService) {
+        if (card != null) return
+        val now = SystemClock.elapsedRealtime()
+        if (now - lastShownAt < 400) return
+        lastShownAt = now
+        this.service = service
+        val px = service.resources.displayMetrics.density
+        val manager = service.getSystemService(Context.WINDOW_SERVICE) as? WindowManager ?: return
+
+        val box = LinearLayout(service).apply {
+            orientation = LinearLayout.VERTICAL
+            background = GradientDrawable().apply {
+                cornerRadius = 16 * px
+                setColor(Color.rgb(16, 20, 30))
+                setStroke((2 * px).roundToInt(), 0xFF34D399.toInt())
+            }
+            setPadding((16 * px).roundToInt(), (14 * px).roundToInt(), (16 * px).roundToInt(), (10 * px).roundToInt())
+        }
+        val title = TextView(service).apply {
+            text = "AI 正在操作，要怎么继续？"
+            setTextColor(Color.WHITE)
+            textSize = 14f
+        }
+        box.addView(title)
+        val row = LinearLayout(service).apply {
+            orientation = LinearLayout.HORIZONTAL
+            gravity = Gravity.END
+        }
+        val takeOver = button(service, px, "手动接管") { takeOver(service) }
+        val toVirtual = button(service, px, "转到虚拟屏继续") { toVirtual(service) }
+        row.addView(takeOver)
+        row.addView(toVirtual, LinearLayout.LayoutParams(-2, -2).apply { leftMargin = (8 * px).roundToInt() })
+        box.addView(row, LinearLayout.LayoutParams(-2, -2).apply { topMargin = (12 * px).roundToInt() })
+
+        val lp = WindowManager.LayoutParams(
+            WindowManager.LayoutParams.WRAP_CONTENT,
+            WindowManager.LayoutParams.WRAP_CONTENT,
+            if (Build.VERSION.SDK_INT >= 30) WindowManager.LayoutParams.TYPE_ACCESSIBILITY_OVERLAY else
+                WindowManager.LayoutParams.TYPE_APPLICATION_OVERLAY,
+            WindowManager.LayoutParams.FLAG_NOT_FOCUSABLE or
+                WindowManager.LayoutParams.FLAG_LAYOUT_IN_SCREEN,
+            PixelFormat.TRANSLUCENT,
+        ).apply {
+            gravity = Gravity.CENTER
+        }
+        try {
+            manager.addView(box, lp)
+            card = box
+        } catch (_: Exception) {
+            card = null
+        }
+    }
+
+    fun dismiss() {
+        val view = card ?: return
+        card = null
+        try {
+            (service?.getSystemService(Context.WINDOW_SERVICE) as? WindowManager)?.removeView(view)
+        } catch (_: Exception) {
+        }
+    }
+
+    private fun button(service: AccessibilityService, px: Float, text: String, onTap: () -> Unit): TextView =
+        TextView(service).apply {
+            this.text = text
+            setTextColor(Color.WHITE)
+            textSize = 13f
+            val pad = (14 * px).roundToInt()
+            setPadding(pad, (10 * px).roundToInt(), pad, (10 * px).roundToInt())
+            background = GradientDrawable().apply {
+                cornerRadius = 10 * px
+                setColor(0x33FFFFFF)
+            }
+            isClickable = true
+            setOnClickListener { onTap() }
+        }
+
+    /** 手动接管: the task ends, and the back key does what it was going to do. */
+    private fun takeOver(service: AccessibilityService) {
+        dismiss()
+        val app = service.applicationContext
+        worker.execute {
+            runCatching { PhoneControl.get(app).stopTask("手动接管") }
+        }
+        main.post { runCatching { service.performGlobalAction(AccessibilityService.GLOBAL_ACTION_BACK) } }
+    }
+
+    /** 转到虚拟屏继续: the back goes through, and the work moves to the background display. */
+    private fun toVirtual(service: AccessibilityService) {
+        dismiss()
+        val app = service.applicationContext
+        main.post { runCatching { service.performGlobalAction(AccessibilityService.GLOBAL_ACTION_BACK) } }
+        worker.execute {
+            runCatching {
+                val control = BackgroundControl.get(app)
+                val target = control.anyPreviewTarget() ?: return@runCatching
+                control.handOverTask(target, toMain = false)
+            }
+        }
+    }
+}
