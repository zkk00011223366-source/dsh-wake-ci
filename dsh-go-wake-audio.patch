+  /// The last two seconds of audio, so what was said together with 唤醒词 is not lost when
+  /// the call page takes over the microphone (品牌助手 hand the pre-roll on for the same
+  /// reason: the phrase is the tail of a sentence, not the whole of it).
+  final List<Uint8List> _preroll = <Uint8List>[];
+  int _prerollBytes = 0;
+  static const _prerollLimit = 2 * 32000; // 2 s of 16 kHz mono PCM16
+  Future<String?>? _wakeUtterance;
