+    /** One frame from the background display, for when the display cannot compose into the view. */
+    fun pushFrame(bytes: ByteArray): Boolean {
+        if (liveSurface) return false
+        val target = fallback ?: return false
+        val now = SystemClock.elapsedRealtime()
+        // Frames are throttled by the caller; this only refuses a storm.
+        if (now - lastFrameAt < 40) return false
+        lastFrameAt = now
+        val decoded = try {
+            BitmapFactory.decodeByteArray(bytes, 0, bytes.size)
+        } catch (_: Throwable) {
+            null
+        } ?: return false
+        // 预览帧也带着虚拟屏的尺寸：窗口第一次知道该按什么比例开。
+        if (decoded.width > 0 && decoded.height > 0 && (displayWidth != decoded.width || displayHeight != decoded.height)) {
+            displayWidth = decoded.width
+            displayHeight = decoded.height
+            applyAspect()
+        }
+        val old = lastBitmap
+        lastBitmap = decoded
+        lastBitmapAt = SystemClock.elapsedRealtime()
+        target.setImageBitmap(decoded)
+        if (!revealed) main.post { reveal(root) }
+        target.visibility = if (eyeHidden || !screenOn) View.GONE else View.VISIBLE
+        waiting?.visibility = View.GONE
+        old?.recycle()
+        return true
+    }
