@@ -0,0 +1,39 @@
+package io.github.ccch1mneyyy.dsh_app.phone.background
+
+import android.util.Log
+
+/**
+ * 任务结束时"交回主屏并置于后台"的那份应用（照 Mika 的 kept 表）。
+ *
+ * 我们不再像 Mika 那样把留下的任务杀掉：放屏前把这块屏上的任务挪到主屏、排到最后、取消隐藏，
+ * 主屏上就多了一份"在后台、不挡人"的应用；下次 AI 打开同一个应用时，直接把它挪回虚拟屏，
+ * 接着原来那一页（不重启、不丢进度）。表只在内存里，进程重启就忘掉——那时照常走启动入口。
+ */
+internal object KeptTasks {
+    private const val TAG = "DshDisplay"
+    /** taskId → 包名。 */
+    private val kept = HashMap<Int, String>()
+
+    fun remember(taskId: Int, pkg: String) {
+        if (taskId <= 0) return
+        synchronized(kept) { kept[taskId] = pkg }
+    }
+
+    fun forget(taskId: Int) {
+        synchronized(kept) { kept.remove(taskId) }
+    }
+
+    /** 取这个包最近留下的那个任务号；没有为 null。 */
+    fun take(pkg: String): Int? = synchronized(kept) {
+        kept.entries.firstOrNull { it.value == pkg }?.key
+    }
+
+    /** 只保留还活着的任务（别的被用户划掉了就不再记着）。 */
+    fun prune(live: Set<Int>) {
+        synchronized(kept) { kept.keys.retainAll(live) }
+    }
+
+    val size: Int get() = synchronized(kept) { kept.size }
+
+    fun logSize() = Log.i(TAG, "vscreen: task-finish kept-total=$size")
+}
diff --git a/app/android/app/src/main/kotlin/io/github/ccch1mneyyy/dsh_app/phone/background/PrivilegedDisplayCore.kt b/app/android/app/src/main/kotlin/io/github/ccch1mneyyy/dsh_app/phone/background/PrivilegedDisplayCore.kt
index c7ed0f7..87c8470 100644
--- a/app/android/app/src/main/kotlin/io/github/ccch1mneyyy/dsh_app/phone/background/PrivilegedDisplayCore.kt
+++ b/app/android/app/src/main/kotlin/io/github/ccch1mneyyy/dsh_app/phone/background/PrivilegedDisplayCore.kt
@@ -11,6 +11,7 @@ package io.github.ccch1mneyyy.dsh_app.phone.background
 import android.annotation.SuppressLint
 import android.app.ActivityManager
