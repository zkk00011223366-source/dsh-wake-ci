diff --git a/app/android/app/src/test/kotlin/io/github/ccch1mneyyy/dsh_app/phone/background/DisplayAwakeTest.kt b/app/android/app/src/test/kotlin/io/github/ccch1mneyyy/dsh_app/phone/background/DisplayAwakeTest.kt
new file mode 100644
index 0000000..b76b8ab
--- /dev/null
+++ b/app/android/app/src/test/kotlin/io/github/ccch1mneyyy/dsh_app/phone/background/DisplayAwakeTest.kt
@@ -0,0 +1,105 @@
+package io.github.ccch1mneyyy.dsh_app.phone.background
+
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertNotNull
+import org.junit.Assert.assertNull
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+/**
+ * 自成一组的虚拟屏一直不睡：屏在就按时替它报用户操作，屏放掉就停；报不了就整个不再试；
+ * 只认按屏报的接口，不认会报给默认组（用户主屏）的老接口。
+ */
+class DisplayAwakeTest {
+    private val ownGroup = 1 shl 11
+
+    /** 记下登记的周期任务，由测试手动「到点」。 */
+    private class Timer {
+        val tasks = mutableListOf<Runnable>()
+        val cancelled = mutableSetOf<Runnable>()
+        fun repeat(r: Runnable): () -> Unit {
+            tasks += r
+            return { cancelled += r }
+        }
+        fun tick() = tasks.toList().forEach { if (it !in cancelled) it.run() }
+        val live get() = tasks.count { it !in cancelled }
+    }
+
+    @Test
+    fun pokesEachDisplayUntilItIsReleased() {
+        val timer = Timer()
+        val poked = mutableListOf<Int>()
+        val awake = DisplayAwake({ poked += it; true }, timer::repeat)
+        awake.start(5)
+        awake.start(7)
+        timer.tick()
+        timer.tick()
+        assertEquals(listOf(5, 7, 5, 7), poked)
+        awake.stop(5)
+        poked.clear()
+        timer.tick()
+        assertEquals(listOf(7), poked)
+        awake.stopAll()
+        assertEquals(0, timer.live)
+    }
+
+    @Test
+    fun startingTheSameDisplayAgainKeepsOnlyOneTimer() {
+        val timer = Timer()
+        val awake = DisplayAwake({ true }, timer::repeat)
+        awake.start(5)
+        awake.start(5)
+        assertEquals(1, timer.live)
+        awake.stop(5)
+        assertEquals(0, timer.live)
+    }
+
+    @Test
+    fun givesUpEverywhereOnceThePowerCallIsUnavailable() {
+        val timer = Timer()
+        var calls = 0
+        val awake = DisplayAwake({ calls++; false }, timer::repeat)
+        awake.start(5)
+        awake.start(7)
+        timer.tick()
+        assertEquals(0, timer.live)
+        // 之后建的屏不再登记
+        awake.start(9)
+        assertEquals(0, timer.live)
+        assertEquals(1, calls)
+    }
+
+    @Test
+    fun onlyDisplaysInTheirOwnGroupAreKeptAwake() {
+        assertTrue(DisplayAwake.needed(ownGroup or 1, ownGroup, groupId = 3))
+        // 读不到所在的组：按建屏时的标志算
+        assertTrue(DisplayAwake.needed(ownGroup, ownGroup, groupId = null))
+        // 没有自己的组（退回不可信屏）或实际落在默认组：报了会让用户的主屏不灭
+        assertFalse(DisplayAwake.needed(1, ownGroup, groupId = null))
+        assertFalse(DisplayAwake.needed(ownGroup, ownGroup, groupId = 0))
+        // 本机没有这个常量：谁都不报
+        assertFalse(DisplayAwake.needed(ownGroup, 0, groupId = 3))
+    }
+
+    @Suppress("unused", "UNUSED_PARAMETER")
+    private class OldPower {
+        fun userActivity(time: Long, event: Int, flags: Int) {}
+    }
+
+    @Suppress("unused", "UNUSED_PARAMETER")
+    private class NewPower {
+        fun userActivity(time: Long, event: Int, flags: Int) {}
+        fun userActivity(displayId: Int, time: Long, event: Int, flags: Int) {}
+    }
+
+    @Test
+    fun picksOnlyThePerDisplayUserActivity() {
+        assertNull(DisplayAwake.userActivityMethod(OldPower::class.java))
+        val m = DisplayAwake.userActivityMethod(NewPower::class.java)
+        assertNotNull(m)
+        m!!
+        assertEquals(4, m.parameterCount)
+        assertEquals(Int::class.javaPrimitiveType, m.parameterTypes[0])
+    }
+}
