+package io.github.ccch1mneyyy.dsh_app.phone
+
+/**
+ * 单账号应用（第二十一节）: one account, one instance.
+ *
+ * 微信 / QQ 这类应用在同一账号下开第二个实例会互相踢下线（也会被当成风控信号）。所以它们不
+ * 用虚拟屏那套「新开一个实例」：用户手上那个实例就是唯一的那一个，助教改在主屏上操作它，
+ * 点几下就完；用户开了「应用分身」（另一个账号）时，分身是另一个包，按普通应用走。
+ *
+ * 其余应用（小红书 / 腾讯视频 / B 站 …）没有这条限制，虚拟屏里正常开实例。
+ */
+object SingleInstanceApps {
+    /** Packages whose second instance is a second login, not a second window. */
+    private val PACKAGES = setOf(
+        "com.tencent.mm", // 微信
+        "com.tencent.mobileqq", // QQ
+    )
+
+    fun isSingleAccount(pkg: String?): Boolean = pkg != null && pkg in PACKAGES
+
+    /** The name the person knows, for the one sentence that says what happened. */
+    fun label(pkg: String?): String? = when (pkg) {
+        "com.tencent.mm" -> "微信"
+        "com.tencent.mobileqq" -> "QQ"
+        else -> null
+    }
+}
