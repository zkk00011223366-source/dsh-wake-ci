++  /// 通话页打开: the call owns the microphone until [resume].
++  Future<void> suspend() async {
++    _suspended = true;
++    _resumeTimer?.cancel();
++    await _stopService();
++    if (ref.mounted) state = state.copyWith(listening: WakeListening.paused, clearReason: true);
