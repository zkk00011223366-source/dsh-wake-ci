++// 语音唤醒（常驻监听）: the switch, the recognizer and what a wake word does.
++//
++// Where each piece runs:
++//   · wake/WakeWordService.kt  — 前台服务（microphone）、PARTIAL_WAKE_LOCK、常驻通知、麦克风让位
++//   · wake/WakeCapture.kt      — AudioRecord 16 kHz mono, 只把「有人说话」的 20 ms 帧送上来
++//   · this file                — 复用实时字幕的 sherpa 流式模型，匹配唤醒词，判定命中后的动作
++//
++// The model is the one 设置 › 语音 › 实时字幕 already downloads (voice/streaming_asr.dart), so
++// listening needs no second model on the phone. Live words stay off while listening and the other
++// way round: both would decode the same microphone twice for nothing.
++
++import 'dart:async';
++import 'dart:io';
++import 'dart:typed_data';
++
++import 'package:flutter/services.dart';
++import 'package:flutter_riverpod/flutter_riverpod.dart';
++import 'package:sherpa_onnx/sherpa_onnx.dart' as sherpa;
