++package io.github.ccch1mneyyy.dsh_app.wake
++
++import android.content.Context
++import android.content.Intent
++import android.content.pm.PackageManager
++import android.os.Handler
++import android.os.Looper
++import io.flutter.embedding.engine.plugins.FlutterPlugin
++import io.flutter.plugin.common.BinaryMessenger
++import io.flutter.plugin.common.EventChannel
++import io.flutter.plugin.common.MethodCall
++import io.flutter.plugin.common.MethodChannel
++import io.github.ccch1mneyyy.dsh_app.MainActivity
++
++/**
++ * In-process wiring between the listening service and the Dart side: frames of speech, what the
++ * service is doing, and the one request the activity has to answer (bringing itself forward with
++ * the screen on).
++ */
++internal object WakeBus {
++    /** Set while Dart listens; frames are dropped when nobody is. */
++    @Volatile var frameSink: ((ByteArray) -> Unit)? = null
++
++    @Volatile var eventSink: ((Map<String, Any?>) -> Unit)? = null
++
++    /** The activity applies this on its next resume (熄屏喊醒: the screen comes on). */
++    @Volatile var turnScreenOn = false
++
++    fun frame(frame: ShortArray) {
++        val sink = frameSink ?: return
++        val bytes = ByteArray(frame.size * 2)
++        for (i in frame.indices) {
++            val sample = frame[i].toInt()
++            bytes[i * 2] = sample.toByte()
++            bytes[i * 2 + 1] = (sample shr 8).toByte()
++        }
++        sink(bytes)
++    }
++
++    fun emit(event: Map<String, Any?>) {
++        eventSink?.invoke(event)
++    }
++}
++
++/**
++ * 语音唤醒 (语音唤醒设置): the always-on listener's switch, its state, and the frames it hears.
++ *
++ *   dsh/wake         start / stop / status / present
++ *   dsh/wake/events  wake.pcm · wake.listening · wake.stopped · wake.speechEnd · wake.yield ·
++ *                    wake.disabled · wake.error
++ *
++ * Dictation and calls keep the microphone through [io.github.ccch1mneyyy.dsh_app.nativemedia.MicArbiter];
++ * the service yields on its own and says so with `wake.yield`.
++ */
++class WakeWordPlugin : FlutterPlugin, MethodChannel.MethodCallHandler, EventChannel.StreamHandler {
++    private lateinit var context: Context
++    private val main = Handler(Looper.getMainLooper())
++    private var events: EventChannel.EventSink? = null
++    private var channel: MethodChannel? = null
++
++    override fun onAttachedToEngine(binding: FlutterPlugin.FlutterPluginBinding) {
++        context = binding.applicationContext
++        attach(binding.binaryMessenger)
++    }
++
++    override fun onDetachedFromEngine(binding: FlutterPlugin.FlutterPluginBinding) = detach()
++
++    private fun attach(messenger: BinaryMessenger) {
++        channel = MethodChannel(messenger, CHANNEL).also { it.setMethodCallHandler(this) }
++        EventChannel(messenger, EVENTS).setStreamHandler(this)
++    }
++
++    private fun detach() {
++        channel?.setMethodCallHandler(null)
++        channel = null
++        events = null
++        WakeBus.eventSink = null
++        WakeBus.frameSink = null
++    }
++
++    override fun onMethodCall(call: MethodCall, result: MethodChannel.Result) {
++        when (call.method) {
++            "status" -> result.success(status())
++            "start" -> {
++                WakeWordService.ensure(context, true)
++                result.success(true)
++            }
++            "stop" -> {
++                WakeWordService.ensure(context, false)
++                result.success(true)
++            }
++            // 熄屏唤醒: the call page is about to be pushed; the screen has to come on for it.
++            "present" -> {
++                WakeBus.turnScreenOn = true
++                val intent = Intent(context, MainActivity::class.java)
++                    .addFlags(Intent.FLAG_ACTIVITY_NEW_TASK or Intent.FLAG_ACTIVITY_SINGLE_TOP)
++                runCatching { context.startActivity(intent) }
++                result.success(true)
++            }
++            else -> result.notImplemented()
++        }
++    }
++
++    private fun status(): Map<String, Any?> = mapOf(
++        "running" to WakeWordService.running,
++        "enabled" to WakePrefs.enabled(context),
++        "microphone" to (context.checkSelfPermission(android.Manifest.permission.RECORD_AUDIO) ==
++            PackageManager.PERMISSION_GRANTED),
++    )
++
++    override fun onListen(arguments: Any?, sink: EventChannel.EventSink?) {
++        events = sink
++        WakeBus.eventSink = { event -> main.post { events?.success(event) } }
++        WakeBus.frameSink = { bytes -> main.post { events?.success(mapOf("kind" to "wake.pcm", "bytes" to bytes)) } }
++        // What the service is already doing, so a page opened while listening is not wrong.
++        WakeBus.emit(mapOf("kind" to if (WakeWordService.running) "wake.listening" else "wake.stopped"))
++    }
++
++    override fun onCancel(arguments: Any?) {
++        events = null
++        WakeBus.eventSink = null
++        WakeBus.frameSink = null
++    }
++
++    private companion object {
++        const val CHANNEL = "dsh/wake"
++        const val EVENTS = "dsh/wake/events"
++    }
++}
