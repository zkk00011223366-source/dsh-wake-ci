++import '../state/streaming_asr_model_state.dart';
++import 'streaming_asr_model.dart';
++import 'wake_settings.dart';
++
++/// What the listener is doing.
++enum WakeListening {
++  /// 常驻监听 off.
++  off,
++
++  /// Asking the service to start.
++  starting,
++
++  /// The service owns the microphone and Dart is decoding its frames.
++  listening,
++
++  /// 让位 or 冷却: not listening, and coming back on its own.
++  paused,
++
++  /// 模型 or 权限 missing: switching it on cannot work yet.
++  unavailable,
++
++  /// The service could not go foreground / open the microphone.
++  failed,
++}
++
++class WakeStatus {
++  const WakeStatus({this.listening = WakeListening.off, this.reason, this.hits = 0});
++
++  final WakeListening listening;
++
++  /// Why it is not listening (`model`, `permission`, `busy`, `foreground`, `capture`, …).
++  final String? reason;
++
++  /// Wake words heard since launch (诊断用).
++  final int hits;
++
++  bool get on => listening == WakeListening.listening || listening == WakeListening.starting;
++
++  WakeStatus copyWith({WakeListening? listening, String? reason, bool clearReason = false, int? hits}) => WakeStatus(
++    listening: listening ?? this.listening,
++    reason: clearReason ? null : (reason ?? this.reason),
++    hits: hits ?? this.hits,
++  );
++}
++
++/// The native side of 语音唤醒 (`dsh/wake`, wake/WakeWordPlugin.kt).
++class WakePlatform {
++  const WakePlatform();
++
++  static const _methods = MethodChannel('dsh/wake');
++  static const _events = EventChannel('dsh/wake/events');
++  static const _voice = MethodChannel('dsh/voice');
++
++  Future<Map<Object?, Object?>> status() async =>
++      await _methods.invokeMapMethod<Object?, Object?>('status') ?? const <Object?, Object?>{};
++
++  Future<void> start() => _methods.invokeMethod<void>('start');
++
++  Future<void> stop() => _methods.invokeMethod<void>('stop');
++
++  /// 熄屏唤醒: the activity comes forward with the screen on (MainActivity.onResume).
++  Future<void> present() => _methods.invokeMethod<void>('present');
++
++  /// RECORD_AUDIO goes through the voice channel, which already owns that request.
++  Future<bool> requestMicrophone() async {
++    final state = await _voice.invokeMethod<Object?>('requestPermission');
++    if (state == 'granted') return true;
++    return (await status())['microphone'] == true;
++  }
++
++  Stream<Map<Object?, Object?>> get events =>
++      _events.receiveBroadcastStream().where((event) => event is Map).cast<Map<Object?, Object?>>();
++}
++
++final wakePlatformProvider = Provider<WakePlatform>((ref) => const WakePlatform());
