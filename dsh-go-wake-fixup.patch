++  /// 通话结束: listening comes back (unless it was switched off meanwhile).
++  Future<void> resume() async {
++    _suspended = false;
++    _resumeTimer?.cancel();
++    final settings = await ref.read(wakeSettingsProvider.notifier).ready();
++    if (!settings.enabled) return;
++    await _sync(settings, hasModel: ref.read(streamingAsrModelProvider).model != null);
++  }
++
++  Future<void> _sync(WakeSettings settings, {required bool hasModel}) async {
++    if (_syncing) return;
++    _syncing = true;
++    try {
++      if (!settings.enabled) {
++        await _stopService();
++        if (ref.mounted) state = state.copyWith(listening: WakeListening.off, clearReason: true);
++        return;
++      }
++      if (_suspended) {
++        if (ref.mounted) state = state.copyWith(listening: WakeListening.paused, clearReason: true);
++        return;
++      }
++      if (!hasModel) {
++        // 复用实时字幕的模型: without it there is nothing to decode with.
++        await _stopService();
++        if (ref.mounted) {
++          state = state.copyWith(listening: WakeListening.unavailable, reason: 'model');
++        }
++        return;
++      }
++      if (!_permitted) {
++        final granted = await _askMicrophone();
++        _permitted = granted;
++        if (!granted) {
++          if (ref.mounted) {
++            state = state.copyWith(listening: WakeListening.unavailable, reason: 'permission');
++          }
++          return;
++        }
++      }
++      if (ref.mounted) state = state.copyWith(listening: WakeListening.starting, clearReason: true);
++      await _try(() => ref.read(wakePlatformProvider).start());
++    } finally {
++      _syncing = false;
++    }
++  }
++
++  var _permitted = false;
++
++  /// The channel is absent on iOS/鸿蒙 and in widget tests: a missing one is "not listening",
++  /// never an exception in the app's own code path.
++  Future<bool> _try(Future<void> Function() action) async {
++    try {
++      await action();
++      return true;
++    } on PlatformException {
++      return false;
++    } on MissingPluginException {
++      return false;
++    }
++  }
++
++  Future<bool> _askMicrophone() async {
++    try {
++      return await ref.read(wakePlatformProvider).requestMicrophone();
++    } on PlatformException {
++      return false;
++    } on MissingPluginException {
++      return false;
++    }
++  }
++
++  Future<void> _stopService() async {
++    _resetStream();
++    _release();
++    await _try(() => ref.read(wakePlatformProvider).stop());
++  }
++
++  void _onEvent(Map<Object?, Object?> event) {
++    switch (event['kind']) {
++      case 'wake.pcm':
++        final bytes = event['bytes'];
