++package io.github.ccch1mneyyy.dsh_app.wake
++
++import android.app.Notification
++import android.app.NotificationChannel
++import android.app.NotificationManager
++import android.app.PendingIntent
++import android.app.Service
++import android.content.Context
++import android.content.Intent
++import android.content.pm.PackageManager
++import android.content.pm.ServiceInfo
++import android.os.Build
++import android.os.IBinder
++import android.os.PowerManager
++import android.util.Log
++import io.github.ccch1mneyyy.dsh_app.MainActivity
++import io.github.ccch1mneyyy.dsh_app.R
++import io.github.ccch1mneyyy.dsh_app.i18n.AppStrings
++import io.github.ccch1mneyyy.dsh_app.nativemedia.MicArbiter
++
++/**
++ * 语音唤醒的常驻监听: a microphone foreground service that keeps the process (and with it the
++ * Dart side, which owns the recognizer) alive with the screen off, and hands Dart the frames of
++ * each burst of speech.
++ *
++ * The microphone is shared the way the rest of the app shares it ([MicArbiter]): a dictation or
++ * a call starting makes [holder] give the microphone up before this returns, and the service
++ * stops itself — the call page tells Dart when the call ended, and listening starts again.
++ */
++class WakeWordService : Service() {
++    private var capture: WakeCapture? = null
++    private var wakeLock: PowerManager.WakeLock? = null
++    private var holding = false
++
++    /** Dictation or a call wants the microphone: give it up without waiting. */
++    private val holder = MicArbiter.Holder {
++        Log.i(TAG, "microphone taken by dictation; listening stops")
++        stopListening(yield = true)
++        stopSelf()
++    }
++
++    override fun onBind(intent: Intent?): IBinder? = null
++
++    override fun onStartCommand(intent: Intent?, flags: Int, startId: Int): Int {
++        if (intent?.action == ACTION_STOP) {
++            WakePrefs.setEnabled(this, false)
++            WakeBus.emit(mapOf("kind" to "wake.disabled", "reason" to "notification"))
++            stopListening(yield = false)
++            stopSelf()
++            return START_NOT_STICKY
++        }
++        ensureChannel()
++        val notification = notification(this)
++        try {
++            if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.UPSIDE_DOWN_CAKE) {
++                startForeground(NOTIFICATION_ID, notification, ServiceInfo.FOREGROUND_SERVICE_TYPE_MICROPHONE)
++            } else {
++                startForeground(NOTIFICATION_ID, notification)
++            }
++        } catch (e: Exception) {
++            Log.w(TAG, "listening service could not go foreground", e)
++            WakeBus.emit(mapOf("kind" to "wake.error", "reason" to "foreground"))
++            WakePrefs.setEnabled(this, false)
++            stopSelf()
++            return START_NOT_STICKY
++        }
++        WakePrefs.setEnabled(this, true)
++        running = true
++        startListening()
++        return START_STICKY
++    }
++
++    override fun onDestroy() {
++        running = false
++        stopListening(yield = false)
++        WakeBus.emit(mapOf("kind" to "wake.stopped"))
++        super.onDestroy()
++    }
++
++    private fun startListening() {
++        if (capture?.active == true) return
++        if (checkSelfPermission(android.Manifest.permission.RECORD_AUDIO) != PackageManager.PERMISSION_GRANTED) {
++            Log.w(TAG, "RECORD_AUDIO not granted; listening stops")
++            WakeBus.emit(mapOf("kind" to "wake.error", "reason" to "permission"))
++            WakePrefs.setEnabled(this, false)
++            stopSelf()
++            return
++        }
++        // Dictation wins: it is not possible to listen while it runs.
++        if (!MicArbiter.acquire(holder)) {
++            WakeBus.emit(mapOf("kind" to "wake.error", "reason" to "busy"))
++            stopSelf()
++            return
++        }
++        holding = true
++        acquireWakeLock()
++        val c = capture ?: WakeCapture(
++            onFrame = { frame -> WakeBus.frame(frame) },
++            onSpeechEnd = { WakeBus.emit(mapOf("kind" to "wake.speechEnd")) },
++            onError = { reason ->
++                WakeBus.emit(mapOf("kind" to "wake.error", "reason" to reason))
++                stopListening(yield = false)
++                stopSelf()
++            },
++        ).also { capture = it }
++        if (!c.start()) {
++            Log.w(TAG, "the microphone could not be opened")
++            WakeBus.emit(mapOf("kind" to "wake.error", "reason" to "capture"))
++            stopListening(yield = false)
++            stopSelf()
++            return
++        }
++        WakeBus.emit(mapOf("kind" to "wake.listening"))
++    }
++
++    private fun stopListening(yield: Boolean) {
++        capture?.stop()
++        if (holding) {
++            MicArbiter.release(holder)
++            holding = false
++        }
++        releaseWakeLock()
++        if (yield) WakeBus.emit(mapOf("kind" to "wake.yield"))
++    }
++
++    private fun acquireWakeLock() {
++        if (wakeLock?.isHeld == true) return
++        val pm = getSystemService(Context.POWER_SERVICE) as? PowerManager ?: return
++        wakeLock = runCatching {
++            pm.newWakeLock(PowerManager.PARTIAL_WAKE_LOCK, "dsh:wake").apply { setReferenceCounted(false); acquire() }
++        }.getOrNull()
++    }
++
++    private fun releaseWakeLock() {
++        runCatching { wakeLock?.takeIf { it.isHeld }?.release() }
++        wakeLock = null
++    }
++
++    companion object {
++        private const val TAG = "DshWake"
++        private const val CHANNEL_ID = "dsh-wake"
++        private const val NOTIFICATION_ID = 3091
++        const val ACTION_STOP = "io.github.ccch1mneyyy.dsh_app.WAKE_STOP"
++
++        /** A listening service is up in this process. */
++        @Volatile var running = false
++            private set
++
++        /** Starts or stops the service to match [on]; does nothing when it already matches. */
++        fun ensure(context: Context, on: Boolean) {
++            val intent = Intent(context, WakeWordService::class.java)
++            try {
++                if (on) {
++                    context.startForegroundService(intent)
++                } else {
++                    context.stopService(intent)
++                }
++            } catch (e: Exception) {
++                // 后台启动被厂商策略拒绝: the setting stays on, the service comes back with the app.
++                Log.w(TAG, "listening service ${if (on) "start" else "stop"} refused", e)
++                WakeBus.emit(mapOf("kind" to "wake.error", "reason" to "start"))
++            }
++        }
++
++        private fun ensureChannel(context: Context) {
++            if (Build.VERSION.SDK_INT < Build.VERSION_CODES.O) return
++            val nm = context.getSystemService(NotificationManager::class.java) ?: return
++            nm.createNotificationChannel(
++                NotificationChannel(
++                    CHANNEL_ID,
++                    AppStrings.get(context, R.string.wake_channel),
++                    NotificationManager.IMPORTANCE_LOW,
++                ).apply {
++                    description = AppStrings.get(context, R.string.wake_channel_description)
++                    setShowBadge(false)
++                },
++            )
++        }
++
++        private fun notification(context: Context): Notification {
++            val open = PendingIntent.getActivity(
++                context, NOTIFICATION_ID,
++                Intent(context, MainActivity::class.java).addFlags(Intent.FLAG_ACTIVITY_SINGLE_TOP),
++                PendingIntent.FLAG_IMMUTABLE or PendingIntent.FLAG_UPDATE_CURRENT,
++            )
++            val stop = PendingIntent.getService(
++                context, NOTIFICATION_ID + 1,
++                Intent(context, WakeWordService::class.java).setAction(ACTION_STOP),
++                PendingIntent.FLAG_IMMUTABLE or PendingIntent.FLAG_UPDATE_CURRENT,
++            )
++            return Notification.Builder(context, CHANNEL_ID)
++                .setSmallIcon(R.drawable.ic_stat_dsh)
++                .setContentTitle(AppStrings.APP_NAME)
++                .setContentText(AppStrings.get(context, R.string.wake_running))
++                .setOngoing(true)
++                .setContentIntent(open)
++                .addAction(Notification.Action.Builder(null, AppStrings.get(context, R.string.wake_stop), stop).build())
++                .build()
++        }
++    }
++}
++
++/** The switch as the native side remembers it, so a boot can restart listening without Dart. */
++internal object WakePrefs {
++    private const val PREFS = "dsh_wake"
++    private const val KEY_ENABLED = "enabled"
++
++    fun enabled(context: Context): Boolean = prefs(context).getBoolean(KEY_ENABLED, false)
++
++    fun setEnabled(context: Context, enabled: Boolean) {
++        prefs(context).edit().putBoolean(KEY_ENABLED, enabled).apply()
++    }
++
++    private fun prefs(context: Context) =
++        (context.applicationContext ?: context).getSharedPreferences(PREFS, Context.MODE_PRIVATE)
++}
