++  }
++
++  void _resetStream() {
++    _text = '';
++    _streamStarted = null;
++    final recognizer = _recognizer;
++    final stream = _stream;
++    if (recognizer == null || stream == null) return;
++    try {
++      recognizer.reset(stream);
++      _streamStarted = DateTime.now();
++    } on Object {
++      _release();
++    }
++  }
++
++  void _release() {
++    final stream = _stream;
++    final recognizer = _recognizer;
++    _stream = null;
++    _recognizer = null;
++    _streamStarted = null;
++    try {
++      stream?.free();
++    } on Object {
++      // Already freed.
++    }
++    try {
++      recognizer?.free();
++    } on Object {
++      // Already freed.
++    }
++  }
++}
++
++final wakeWordProvider = NotifierProvider<WakeWordController, WakeStatus>(WakeWordController.new);
++
++/// 唤醒触发的通话: a counter the open conversation watches (ui/chat/chat_screen.dart).
++///
++/// A wake word does not know which conversation is on screen, and the call page needs one, so the
