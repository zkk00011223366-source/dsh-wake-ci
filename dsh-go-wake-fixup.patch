++package io.github.ccch1mneyyy.dsh_app.wake
++
++import android.annotation.SuppressLint
++import android.media.AudioFormat
++import android.media.AudioRecord
++import android.media.MediaRecorder
++import android.os.SystemClock
++import io.github.ccch1mneyyy.dsh_app.nativemedia.SpeechGate
++
++/**
++ * 常驻监听的麦克风: 16 kHz mono PCM16 from the noise-suppressed recognition source, cut into
++ * 20 ms frames; only frames inside a burst of speech are handed on, so the recognizer in Dart
++ * wakes for speech and sleeps through a quiet room (the always-on cost is one read loop).
++ *
++ * No echo canceller here: while the app plays anything the call page owns the microphone and
++ * this loop has already given it up ([WakeWordService] is a [MicArbiter] holder).
++ *
++ * [stop] ends the capture before it returns (it waits briefly for the thread), so the
++ * microphone is free for a call right after.
++ */
++class WakeCapture(
++    private val onFrame: (ShortArray) -> Unit,
++    /** The burst of speech ended: the Dart side resets its recognizer stream. */
++    private val onSpeechEnd: () -> Unit,
++    private val onError: (String) -> Unit,
++) {
++    private var record: AudioRecord? = null
++    private var thread: Thread? = null
++    @Volatile private var running = false
++    private var session = 0
++
++    val active get() = record != null
++
++    @SuppressLint("MissingPermission") // WakeWordService checks RECORD_AUDIO before starting.
++    fun start(): Boolean {
++        stop()
++        val min = AudioRecord.getMinBufferSize(RATE, AudioFormat.CHANNEL_IN_MONO, AudioFormat.ENCODING_PCM_16BIT)
++        if (min <= 0) return false
++        val r = runCatching {
++            AudioRecord(
++                MediaRecorder.AudioSource.VOICE_RECOGNITION,
++                RATE,
++                AudioFormat.CHANNEL_IN_MONO,
++                AudioFormat.ENCODING_PCM_16BIT,
++                maxOf(min, FRAME * 2 * 10), // 200 ms
++            )
++        }.getOrNull() ?: return false
++        if (r.state != AudioRecord.STATE_INITIALIZED) {
++            r.release()
++            return false
++        }
++        val started = runCatching { r.startRecording() }.isSuccess && r.recordingState == AudioRecord.RECORDSTATE_RECORDING
++        if (!started) {
++            r.release()
++            return false
++        }
++        record = r
++        running = true
++        val mine = ++session
++        thread = Thread({ capture(r, mine) }, "dsh-wake").also { it.start() }
++        return true
++    }
++
++    private fun capture(r: AudioRecord, mine: Int) {
++        val frame = ShortArray(FRAME)
++        var filled = 0
++        var floor = Double.NaN
++        var loud = 0
++        var speaking = false
++        var lastLoud = 0L
++        try {
++            while (running) {
++                val n = r.read(frame, filled, frame.size - filled)
++                if (!running) break
++                if (n < 0) {
++                    report(mine) { onError("capture") }
++                    break
++                }
++                filled += n
++                if (filled < frame.size) continue
++                filled = 0
++                val now = SystemClock.elapsedRealtime()
++                val level = SpeechGate.levelOf(frame, frame.size)
++                // 噪声地板 follows a quiet room down at once and up slowly, so a fan or a road
++                // does not keep the gate open and a person still opens it.
++                floor = if (floor.isNaN()) level else minOf(level, floor + FLOOR_RISE_DB)
++                val hot = level > floor + MARGIN_DB
++                loud = if (hot) loud + 1 else 0
++                if (hot) lastLoud = now
++                if (!speaking && loud >= LOUD_FRAMES) {
++                    speaking = true
++                }
++                if (!speaking) continue
++                if (now - lastLoud > HANGOVER_MS) {
++                    speaking = false
++                    report(mine) { onSpeechEnd() }
++                    continue
++                }
++                val copy = frame.copyOf()
++                report(mine) { onFrame(copy) }
++            }
++        } catch (_: RuntimeException) {
++            report(mine) { onError("capture") }
++        } finally {
++            frame.fill(0)
++        }
++    }
++
++    private fun report(mine: Int, block: () -> Unit) {
++        if (mine == session && running) block()
++    }
++
++    /** Ends the capture: the thread leaves its read and the recorder is released. */
++    fun stop(): Boolean {
++        session++
++        running = false
++        val r = record ?: return true
++        record = null
++        runCatching { r.stop() }
++        val t = thread
++        thread = null
++        runCatching { t?.join(JOIN_MS) }
++        val ended = t?.isAlive != true
++        runCatching { r.release() }
++        return ended
++    }
++
++    private companion object {
++        const val RATE = 16000
++        const val FRAME = 320 // 20 ms
++        const val JOIN_MS = 300L
++        /** dB over the learned floor a frame needs before it counts as speech. */
++        const val MARGIN_DB = 9.0
++        /** How fast the floor may rise per frame (2 dB a second at 50 frames a second). */
++        const val FLOOR_RISE_DB = 0.04
++        /** 60 ms of speech before the burst opens (a knock or a click does not). */
++        const val LOUD_FRAMES = 3
++        /** Quiet that closes the burst; the trailing word is still inside it. */
++        const val HANGOVER_MS = 700L
++    }
++}
