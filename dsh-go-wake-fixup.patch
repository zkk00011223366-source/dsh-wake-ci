++  /// A burst longer than this starts a fresh recognizer stream (nothing said for 15 s anyway).
++  static const _burstLimit = Duration(seconds: 15);
++
++  /// A wake word that opened no call (no conversation on screen) comes back after this.
++  static const _callGrace = Duration(seconds: 20);
