++#!/usr/bin/env bash
++# 语音唤醒: one command from a fresh clone to an APK with 常驻监听 built in.
++#
++#   tooling/build-wake-apk.sh                 arm64 APK (a phone)
++#   tooling/build-wake-apk.sh -f x64          x64 APK (an emulator)
++#   tooling/build-wake-apk.sh --skip-runtime  runtime/out is already built
++#
++# Linux x86_64 only, the same host the rest of the build needs (tooling/setup-toolchain.sh
++# downloads a linux JDK and a linux Flutter). It does what docs/wake-word.md lists:
++#
++#   1. app: resolve packages and regenerate lib/l10n/gen (语音唤醒 has new strings)
++#   2. runtime/build-runtime.sh <abi>: the Linux runtime the APK carries (skipped when present)
++#   3. tooling/build-apk.sh: the APK itself, fresh versionCode, debug-signed unless
++#      app/android/key.properties holds a release key
++#
++# The toolchain itself (JDK 17, Flutter, Android SDK/NDK) is not installed here:
++#   bash tooling/setup-toolchain.sh && source tooling/env.sh
++set -euo pipefail
++
++ROOT=$(CDPATH= cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
++APP="$ROOT/app"
++
++flavor=arm64 skip_runtime=0
++while (($#)); do
++  case "$1" in
++    -f|--flavor) flavor=${2:?}; shift 2 ;;
++    --skip-runtime) skip_runtime=1; shift ;;
++    -h|--help) sed -n '2,20p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'; exit 0 ;;
++    *) echo "build-wake-apk: unknown argument $1" >&2; exit 1 ;;
++  esac
++done
++case "$flavor" in
++  arm64) abi=arm64-v8a ;;
++  x64) abi=x86_64 ;;
++  *) echo "build-wake-apk: flavor must be arm64 or x64" >&2; exit 1 ;;
++esac
++
++die() { echo "build-wake-apk: $*" >&2; exit 1; }
++step() { printf '\n==> %s\n' "$*"; }
++
++command -v flutter >/dev/null || die "flutter is not on PATH (bash tooling/setup-toolchain.sh && source tooling/env.sh)"
++command -v java >/dev/null || die "java is not on PATH (bash tooling/setup-toolchain.sh && source tooling/env.sh)"
++command -v python3 >/dev/null || die "python3 is required (l10n merge, runtime build)"
++
++step "依赖: flutter pub get"
++(cd "$APP" && flutter pub get)
++
++# lib/l10n/gen is tracked, so the 语音唤醒 strings only reach the build once gen-l10n
++# has run: pub get first (gen-l10n reads .dart_tool/package_config.json), then merge.
++step "文案: 合并 parts 并重新生成 L10n"
++(cd "$APP" && python3 tool/l10n_merge.py)
++
++if ((skip_runtime)); then
++  step "运行时: 跳过 (--skip-runtime)"
++elif [[ -f "$ROOT/runtime/out/$abi/assets/runtime/manifest.json" ]]; then
++  step "运行时: 已存在 runtime/out/$abi"
++else
++  step "运行时: runtime/build-runtime.sh $abi (解包 Ubuntu base + Node + DSH, 第一次要十几分钟)"
++  (cd "$ROOT" && bash runtime/build-runtime.sh "$abi")
++fi
++
++step "打包: tooling/build-apk.sh -f $flavor --keep-daemon"
++(cd "$ROOT" && DSH_BETA_TOKEN_FILE= bash tooling/build-apk.sh -f "$flavor" --keep-daemon)
++
++apk="$APP/build/app/outputs/flutter-apk/app-$flavor-release.apk"
++[[ -f "$apk" ]] || die "the build finished but $apk is missing"
++printf '\nAPK: %s (%s)\n' "$apk" "$(du -h "$apk" | cut -f1)"
++printf '装之前: 与官方版签名不同，需要先卸载官方版（本地数据会丢，先备份）。\n'
