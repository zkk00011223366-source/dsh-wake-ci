++    }
++  }
++
++  /// 唤醒词 found in what was heard: punctuation, spaces and case ignored.
++  bool _heardWakeWord(String text) {
++    final keyword = _compact(_keyword);
++    if (keyword.isEmpty) return false;
++    return _compact(text).contains(keyword);
++  }
++
++  static final _noise = RegExp(r'[^0-9A-Za-z\u4e00-\u9fff]+');
++
++  /// 纯标点 / 「嗯啊哦」 never matches a keyword that has a letter or a han character in it.
++  static String _compact(String text) => text.replaceAll(_noise, '').toLowerCase();
++
++  Future<void> _fire() async {
++    final now = DateTime.now();
++    final until = _cooldownUntil;
++    if (until != null && now.isBefore(until)) return;
++    _cooldownUntil = now.add(_cooldown);
++    final settings = ref.read(wakeSettingsProvider);
++    if (settings.chime) unawaited(SystemSound.play(SystemSoundType.alert));
++    if (settings.vibrate) unawaited(HapticFeedback.heavyImpact());
++    _resetStream();
++    if (ref.mounted) state = state.copyWith(listening: WakeListening.paused, hits: state.hits + 1, clearReason: true);
++    // 麦克风让位: the call page records too; the two would cut each other off.
++    await _stopService();
++    try {
++      await ref.read(wakePlatformProvider).present();
++    } on Object {
++      // The activity could not be brought forward (or there is no such channel): the caller's
++      // screen is unchanged, and the call still opens in the app when it comes back.
++    }
++    // 没有接上通话（屏幕上没有会话）: listening comes back on its own.
++    _resumeTimer?.cancel();
++    _resumeTimer = Timer(_callGrace, () => unawaited(resume()));
++  }
++
++  /// The recognizer for the stream of the 实时字幕 model, built on the first frame.
++  sherpa.OnlineRecognizer? _ensureRecognizer() {
++    final existing = _recognizer;
++    if (existing != null) return existing;
++    final model = ref.read(streamingAsrModelProvider).model;
++    if (model == null) return null;
++    try {
++      _recognizer = _create(model);
++      _stream = _recognizer!.createStream();
++      _streamStarted = DateTime.now();
++      return _recognizer;
++    } on Object catch (error) {
++      if (ref.mounted) {
++        state = state.copyWith(listening: WakeListening.failed, reason: 'model: $error');
++      }
++      return null;
++    }
++  }
++
++  static sherpa.OnlineRecognizer _create(StreamingAsrModel model) {
++    for (final path in [model.encoder, model.decoder, model.joiner, model.tokens]) {
++      final stat = File(path).statSync();
++      if (stat.type != FileSystemEntityType.file || stat.size == 0) {
++        throw FileSystemException('wake: model file is missing or empty', path);
++      }
++    }
++    sherpa.initBindings();
++    return sherpa.OnlineRecognizer(
++      sherpa.OnlineRecognizerConfig(
++        model: sherpa.OnlineModelConfig(
++          transducer: sherpa.OnlineTransducerModelConfig(
++            encoder: model.encoder,
++            decoder: model.decoder,
++            joiner: model.joiner,
++          ),
++          tokens: model.tokens,
++          modelType: 'zipformer',
++          // One thread: this runs for as long as the phone is on, on frames that are mostly silence.
++          numThreads: 1,
++          debug: false,
++        ),
++        // A short trailing silence ends a burst quickly; nothing waits 1 s here.
++        rule2MinTrailingSilence: 0.6,
++        rule3MinUtteranceLength: 20.0,
++      ),
