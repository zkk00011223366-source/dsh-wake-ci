++  /// 常驻监听 switched on or off from 设置.
++  Future<void> setEnabled(bool on) async {
++    await ref.read(wakeSettingsProvider.notifier).edit((saved) => saved.copyWith(enabled: on));
++    if (!on) await _stopService();
++  }
